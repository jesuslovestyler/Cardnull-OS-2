                                    // cells (Stone 30): the
                                    // press has already been
                                    // carried across the desk by
                                    // the packet reckoning above
                                    // — the feather will reckon
                                    // what it means when the
                                    // visit is received — and
                                    // here the window simply
                                    // comes forward, as a press
                                    // on any window brings it.
                                    if pget(pixdesk, 340) == 1 {
                                        if pget(pixdesk, 344) == 1 {
                                            let krow2 = (cyp - ky * cellpx - 2 * cellpx) / 16 + 10
                                            let kcol2 = (cxp - kx * cellpx - cellpx) / 16 + 14
                                            if krow2 >= 10 {
                                                if krow2 <= 20 {
                                                    if kcol2 >= 14 {
                                                        if kcol2 <= 65 {
                                                            // Stone 35: the
                                                            // region road, as
                                                            // at the paint
                                                            // window's press.
                                                            let oldfwd = pget(pixdesk, 180)
                                                            pset(pixdesk, 180, 8)
                                                            layroadwins(pixdesk, 8, oldfwd)
                                                            paintregion(pixdesk, cellblock, notesblock)
                                                            paintchips(pixdesk)
                                                            acted = 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // A press on a window's title
                                    // bar takes hold of it for a
                                    // drag (Stone 22): a close
                                    // mark's press has already
                                    // been reckoned above — it
                                    // closes, and never drags —
                                    // and no content row stands
                                    // in a title bar, so a press
                                    // reaching here on a bar is
                                    // the drag's alone. The
                                    // forward window is tried
                                    // first — its bar is the one
                                    // standing visible where
                                    // windows overlap — then each
                                    // window in its turn. The
                                    // window comes forward, as a
                                    // press on it has always
                                    // brought it, and the hold's
                                    // place within the window is
                                    // kept for the following in
                                    // the packet reckoning above.
                                    let fwd = pget(pixdesk, 180)
                                    let cand = fwd
                                    let tries = 0
                                    while tries < 14 {
                                        let took = 0
                                        if cand >= 1 {
                                            if cand <= 13 {
                                                if winopen(pixdesk, cand) == 1 {
                                                    let wl = winleft(pixdesk, cand)
                                                    let wt = wintop(pixdesk, cand)
                                                    let ww = winwide(pixdesk, cand)
                                                    if cxp >= wl * cellpx {
                                                        if cxp < (wl + ww) * cellpx {
                                                            if cyp >= wt * cellpx {
                                                                if cyp < (wt + 1) * cellpx {
                                                                    if cxp < (wl + ww - 2) * cellpx {
                                                                        took = 1
                                                                    }
                                                                    if cxp >= (wl + ww - 1) * cellpx {
                                                                        took = 1
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    if took == 1 {
                                                        dragwin = cand
                                                        draggox = cxp / cellpx - wl
                                                        draggoy = cyp / cellpx - wt
                                                        pset(pixdesk, 508, wl)
                                                        pset(pixdesk, 512, wt)
                                                        dragdirty = 0
                                                        pset(pixdesk, 180, cand)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                        if acted == 1 {
                                            tries = 13
                                        } else {
                                            if tries == 0 {
                                                cand = 1
                                            } else {
                                                cand = cand + 1
                                            }
                                            tries = tries + 1
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // A press on the feather's
                                    // panel (Stone 13): the
                                    // panel's cells stand at
                                    // sixteen pixels at either
                                    // word size (onefeather's
                                    // reckoning), so the
                                    // panel's bounds are counted
                                    // in pixels from the
                                    // window's corner — the
                                    // same bounds the cell
                                    // reckoning has always
                                    // named, at the usual size
                                    // exactly as they stood.
                                    if pget(pixdesk, 176) == 1 {
                                        if cxp >= gx * cellpx + cellpx {
                                            if cxp < gx * cellpx + cellpx + 832 {
                                                if cyp >= gy * cellpx + 2 * cellpx {
                                                    if cyp < gy * cellpx + 2 * cellpx + 80 {
                                                        pset(pixdesk, 180, 2)
                                                        featherask = 1
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 172) == 1 {
                                        if cxp >= pl * cellpx {
                                            if cxp < (pl + pw) * cellpx {
                                                if cyp >= pt * cellpx {
                                                    if cyp < (pt + ph) * cellpx {
                                                        pset(pixdesk, 180, 1)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 176) == 1 {
                                        if cxp >= gx * cellpx {
                                            if cxp < (gx + gw) * cellpx {
                                                if cyp >= gy * cellpx {
                                                    if cyp < (gy + gh) * cellpx {
                                                        pset(pixdesk, 180, 2)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 188) == 1 {
                                        if cxp >= fx * cellpx {
                                            if cxp < (fx + fw) * cellpx {
                                                if cyp >= fy * cellpx {
                                                    if cyp < (fy + fh) * cellpx {
                                                        pset(pixdesk, 180, 3)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 208) == 1 {
                                        if cxp >= sx * cellpx {
                                            if cxp < (sx + sw) * cellpx {
                                                if cyp >= sy * cellpx {
                                                    if cyp < (sy + sh) * cellpx {
                                                        pset(pixdesk, 180, 4)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 220) == 1 {
                                        if cxp >= ex * cellpx {
                                            if cxp < (ex + ew) * cellpx {
                                                if cyp >= ey * cellpx {
                                                    if cyp < (ey + eh) * cellpx {
                                                        pset(pixdesk, 180, 5)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 272) == 1 {
                                        if cxp >= qx * cellpx {
                                            if cxp < (qx + qw) * cellpx {
                                                if cyp >= qy * cellpx {
                                                    if cyp < (qy + qh) * cellpx {
                                                        pset(pixdesk, 180, 6)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 324) == 1 {
                                        if cxp >= vx * cellpx {
                                            if cxp < (vx + vw) * cellpx {
                                                if cyp >= vy * cellpx {
                                                    if cyp < (vy + vh) * cellpx {
                                                        pset(pixdesk, 180, 7)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 340) == 1 {
                                        if cxp >= kx * cellpx {
                                            if cxp < (kx + kw) * cellpx {
                                                if cyp >= ky * cellpx {
                                                    if cyp < (ky + kh) * cellpx {
                                                        pset(pixdesk, 180, 8)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 360) == 1 {
                                        if cxp >= hx * cellpx {
                                            if cxp < (hx + hw) * cellpx {
                                                if cyp >= hy * cellpx {
                                                    if cyp < (hy + hh) * cellpx {
                                                        pset(pixdesk, 180, 9)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 404) == 1 {
                                        if cxp >= tx * cellpx {
                                            if cxp < (tx + tw) * cellpx {
                                                if cyp >= ty * cellpx {
                                                    if cyp < (ty + th) * cellpx {
                                                        pset(pixdesk, 180, 10)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 424) == 1 {
                                        if cxp >= jx * cellpx {
                                            if cxp < (jx + jw) * cellpx {
                                                if cyp >= jy * cellpx {
                                                    if cyp < (jy + jh) * cellpx {
                                                        pset(pixdesk, 180, 11)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 444) == 1 {
                                        if cxp >= zx * cellpx {
                                            if cxp < (zx + zw) * cellpx {
                                                if cyp >= zy * cellpx {
                                                    if cyp < (zy + zh) * cellpx {
                                                        pset(pixdesk, 180, 12)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    if pget(pixdesk, 476) == 1 {
                                        if cxp >= ux * cellpx {
                                            if cxp < (ux + uw) * cellpx {
                                                if cyp >= uy * cellpx {
                                                    if cyp < (uy + uh) * cellpx {
                                                        pset(pixdesk, 180, 13)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // The desktop's icons
                                    // (Stone 38): a press
                                    // that no window, panel,
                                    // menu, or button has
                                    // claimed is tried
                                    // against the icons down
                                    // the desktop's left
                                    // edge — each icon's box
                                    // stands three rows
                                    // high from its row
                                    // (iconat), thirteen
                                    // cells wide from the
                                    // first column — and a
                                    // press on an icon opens
                                    // its window, exactly as
                                    // the icon's typed word
                                    // and the menu's choice
                                    // open it: the feather
                                    // windows ask for their
                                    // feathers' opening
                                    // visits, the verse
                                    // reckons the day's
                                    // verse as it opens, and
                                    // the terminal stands
                                    // open with its keeping
                                    // whole.
                                    let icol = cxp / cellpx
                                    let irow = cyp / cellpx
                                    if icol >= 1 {
                                        if icol <= 13 {
                                            if irow >= 1 {
                                                let ii = (irow - 1) / 4
                                                if ii <= 9 {
                                                    if irow - iconat(pixdesk, ii) <= 2 {
                                                        if ii == 0 {
                                                            pset(pixdesk, 188, 1)
                                                            pset(pixdesk, 300, 0)
                                                            pset(pixdesk, 180, 3)
                                                        }
                                                        if ii == 1 {
                                                            pset(pixdesk, 220, 1)
                                                            pset(pixdesk, 224, 0)
                                                            pset(pixdesk, 228, 0)
                                                            pset(pixdesk, 308, 0)
                                                            pset(pixdesk, 180, 5)
                                                        }
                                                        if ii == 2 {
                                                            pset(pixdesk, 272, 1)
                                                            pset(pixdesk, 180, 6)
                                                            paintask = 1
                                                        }
                                                        if ii == 3 {
                                                            pset(pixdesk, 340, 1)
                                                            pset(pixdesk, 180, 8)
                                                            calcask = 1
                                                        }
                                                        if ii == 4 {
                                                            pset(pixdesk, 336, verseday(utcnow, offset))
                                                            pset(pixdesk, 324, 1)
                                                            pset(pixdesk, 180, 7)
                                                        }
                                                        if ii == 5 {
                                                            pset(pixdesk, 364, 0)
                                                            pset(pixdesk, 360, 1)
                                                            pset(pixdesk, 180, 9)
                                                        }
                                                        if ii == 6 {
                                                            pset(pixdesk, 208, 1)
                                                            pset(pixdesk, 180, 4)
                                                        }
                                                        if ii == 7 {
                                                            pset(pixdesk, 404, 1)
                                                            pset(pixdesk, 180, 10)
                                                        }
                                                        if ii == 8 {
                                                            pset(pixdesk, 428, 0)
                                                            pset(pixdesk, 440, 1)
                                                            pset(pixdesk, 424, 1)
                                                            pset(pixdesk, 180, 11)
                                                        }
                                                        if ii == 9 {
                                                            pset(pixdesk, 444, 1)
                                                            pset(pixdesk, 180, 12)
                                                        }
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        mbtn = btn
                    }
                    mp = mp + 1
                } else {
                    mp = 8
                }
            }
            // The drag's one step for the whole pass
            // (the Drag Mend, November 27, 2026): the
            // packet gathering above moved the held
            // window's place silently, packet by
            // packet; here, once, the step is paid —
            // the ground the painting stands on washed,
            // the window painted at the place the
            // gathering came to rest. A pass in which
            // the button was let go owes nothing: the
            // drop's whole repaint already made the
            // glass whole, and dragwin stands 0.
            if dragwin != 0 {
                if dragdirty == 1 {
                    dragdirty = 0
                    pset(pixdesk, 464, dragwin)
                    pset(pixdesk, 468, winleft(pixdesk, dragwin))
                    pset(pixdesk, 472, wintop(pixdesk, dragwin))
                    dragstep(pixdesk, cellblock, notesblock)
                }
            }
        }
    }

    // A feather asked for — by the word, or by the pointer's
    // press on its panel — is received here, the one doing
    // for both askings (Stone 13). The asking opens the
    // feather's window and brings it forward (Stone 14),
    // whether the visit then stands or is refused.
    if featherask == 1 {
        featherask = 0
        let oldfwd = 0
        if pix == 1 {
            oldfwd = pget(pixdesk, 180)
            pset(pixdesk, 176, 1)
            pset(pixdesk, 180, 2)
        }
        // 'feather': receive it through the door
        // (featherdoor.nifla), and say how it went.
        // The feather is told which screen to paint:
        // the text screen itself, or — on the face
        // of light — the host's block of cells.
        let paintbase = 753664
        if pix == 1 {
            paintbase = blockaddr(cellblock)
        }
        let how = runfeather(featherimg, feathergot, paintbase, 7)
        // The door's reckoning (Stone 42): the visit
        // that stood is a letting in; the feather turned
        // away for a card that did not reckon true is a
        // turning away — the Shield window's counts,
        // copied into the desk at the change.
        if how == 3 {
            shieldin = shieldin + 1
        }
        if how == 2 {
            shieldout = shieldout + 1
        }
        if pix == 1 {
            pset(pixdesk, 456, shieldin)
            pset(pixdesk, 460, shieldout)
        }
        if how == 3 {
            if pix == 1 {
                // The visit stands in the feather's window
                // now (Stone 14): the window's painting
                // shows the cells the feather painted, and
                // keeps showing them.
                pset(pixdesk, 184, 1)
            }
        }
        if pix == 1 {
            // Stone 35: the visit changed only the
            // feather window's cells, and its coming
            // forward changed the window it took the
            // forward place from — the region road over
            // the two of them repaints exactly that.
            layroadwins(pixdesk, 2, oldfwd)
            paintregion(pixdesk, cellblock, notesblock)
            // The visit moved the forward place (Stone
            // 39): the bar's chips are painted again, so
            // the front chip's blue leaves the window it
            // stood on — the feather window keeps no chip
            // of its own, so no chip stands blue while
            // the feather stands forward.
            paintchips(pixdesk)
        }
        if how == 1 {
            // A refusal, sounded as well as written
            // (Stone 18): one low note.
            refusenote()
            ansrow = printline(ansrow, "There is no feather on this disc to visit.", pix, pixdesk)
        }
        if how == 2 {
            refusenote()
            ansrow = printline(ansrow, "The feather on this disc is not whole, so it was not let in.", pix, pixdesk)
        }
        if how == 3 {
            if pix == 1 {
                // Stone 47: on the face of light the
                // visit's word stands in the terminal's
                // keeping, like every other answer —
                // printline lays it there, and the
                // answers' repaint at the pass's end
                // shows it in its window. Until now this
                // face stamped the line straight onto
                // the desktop's ground at the layout's
                // row 21, across whatever window stood
                // there and across the ground alike,
                // and no repaint path owned it: never
                // laid again, never rubbed out — the
                // last ground text with no owner. (The
                // text face keeps its own standing
                // place for the word, below the panel,
                // as it always has.)
                ansrow = printline(ansrow, "The feather visited, and has gone home again.", pix, pixdesk)
            } else {
                writeat(21, 2, "The feather visited, and has gone home again.", 7)
            }
        }
    }

    // A paint feather visit owed — the opening visit the
    // word 'paint' asked for, or a press the pointer
    // carried in (Stone 24) — is received here, through
    // the same door and the same reckoning as the welcome
    // feather's visits: the paint feather's own card is
    // read and its bytes reckoned on EVERY visit, and
    // only a whole feather is laid at the doorstep and
    // called, with the gift the asking carries and the
    // paint window's own cells named as its screen. A
    // visit that stands leaves the feather's painting in
    // those cells, and the window is painted again from
    // them; a refusal is sounded and said in plain words,
    // exactly as the feather's refusals are. (Presses are
    // carried only once a first visit has stood — the
    // pointer's asking below keeps that — so a disc whose
    // paint feather is refused hears the refusal once, at
    // its asking, and not once a press.)
    //
    // Since Stone 26 the receiving also keeps the picture:
    // an opening visit that stands is followed by the
    // host laying a kept picture back into the cells, and
    // a press visit that stands is followed by the host
    // writing the painted region through to a keeping
    // disk — the keeping is the host's, in the receiving
    // below, and the door's reckoning above it is exactly
    // as it always was.
    if paintask != 0 {
        let pgift = paintask
        paintask = 0
        if pix == 1 {
            // The kept picture's standing as this visit
            // finds it (Stone 47): a press visit whose
            // keeping changes it — the picture gained
            // or lost — owes the files window's list a
            // repaint at the stroke's end, reckoned
            // below against the standing as it was.
            let picstood = pget(pixdesk, 296)
            let phow = runfeather(paintimg, paintgot, blockaddr(paintblock), pgift)
            // The door's reckoning (Stone 42), as at
            // the welcome feather's receiving.
            if phow == 3 {
                shieldin = shieldin + 1
                pset(pixdesk, 456, shieldin)
            }
            if phow == 2 {
                shieldout = shieldout + 1
                pset(pixdesk, 460, shieldout)
            }
            if phow == 3 {
                pset(pixdesk, 276, 1)
                if pgift == 1 {
                    // The opening visit stands (Stone 26):
                    // the feather has painted its fresh
                    // window, and when a picture stands
                    // kept on the disk, the host lays the
                    // kept region back into the cells over
                    // it — the invitation, the swatches
                    // with their star, the named color, and
                    // the canvas, every cell exactly as the
                    // feather left it when it was kept —
                    // and the chosen-color figure back at
                    // the cells' first cell, so the
                    // feather's own keeping stands whole
                    // for the presses that follow.
                    if pichas == 1 {
                        let prr = 0
                        while prr < 11 {
                            let pcc = 0
                            while pcc < 52 {
                                let psrc = (prr * 52 + pcc) * 2
                                let pdst = ((10 + prr) * 80 + 14 + pcc) * 2
                                paintblock[pdst] = picblock[psrc]
                                paintblock[pdst + 1] = picblock[psrc + 1]
                                pcc = pcc + 1
                            }
                            prr = prr + 1
                        }
                        paintblock[0] = picsel
                    }
                } else {
                    // A press visit stands (Stone 26): the
                    // feather has reckoned the press and
                    // laid its mark, and when a disk is
                    // keeping things the host keeps the
                    // picture through to the disk at once —
                    // the whole painted region, copied into
                    // the picture block and written by
                    // picsave, with the feather's chosen-
                    // color figure. A picture stands kept
                    // while any canvas cell stands painted
                    // (its color byte is not the empty
                    // canvas's 119); a canvas cleared clear
                    // through lets the keeping go, and the
                    // header on the disk says so. The
                    // feather is unchanged and was checked
                    // at the door for this visit as for
                    // every visit, above.
                    if diskset == 1 {
                        let srr = 0
                        while srr < 11 {
                            let scc = 0
                            while scc < 52 {
                                let ssrc = ((10 + srr) * 80 + 14 + scc) * 2
                                let sdst = (srr * 52 + scc) * 2
                                picblock[sdst] = paintblock[ssrc]
                                picblock[sdst + 1] = paintblock[ssrc + 1]
                                scc = scc + 1
                            }
                            srr = srr + 1
                        }
                        let anypaint = 0
                        let crow = 14
                        while crow < 21 {
                            let ccol = 16
                            while ccol < 64 {
                                if paintblock[(crow * 80 + ccol) * 2 + 1] != 119 {
                                    anypaint = 1
                                }
                                ccol = ccol + 1
                            }
                            crow = crow + 1
                        }
                        let sl = paintblock[0]
                        if sl < 48 {
                            sl = 48
                        }
                        if sl > 53 {
                            sl = 48
                        }
                        // A canvas cleared clear through
                        // lets the keeping go (above), and
                        // the picture's name goes with it
                        // (Stone 40): the name this body
                        // keeps is forgotten before the
                        // saving, so the header laid down
                        // carries no name for a picture
                        // that no longer stands.
                        if anypaint == 0 {
                            notesblock[640] = 0
                        }
                        let picsaved = 0
                        if keepusb == 1 {
                            picsaved = upichead(xdesk, anypaint, sl, notesblock)
                            if picsaved == 1 {
                                if anypaint == 1 {
                                    let picbody = upicbody(xdesk, picblock)
                                }
                            }
                        } else {
                            picsaved = picsave(picblock, anypaint, sl, notesblock)
                        }
                        if picsaved == 1 {
                            pichas = anypaint
                            if anypaint == 1 {
                                picsel = sl
                            }
                            pset(pixdesk, 296, pichas)
                        }
                    }
                }
                if pgift == 1 {
                    // The opening visit (Stone 35): the
                    // visit changed only the paint
                    // window's cells — and, when a disk
                    // is keeping the picture, the files
                    // window's list may have gained or
                    // lost the picture's row through the
                    // host's laying the kept picture back
                    // above — so the region road runs
                    // over the paint window, and over the
                    // files window with it when a disk
                    // stands.
                    if diskset == 1 {
                        layroadwins(pixdesk, 6, 3)
                    } else {
                        layroadwins(pixdesk, 6, 0)
                    }
                    paintregion(pixdesk, cellblock, notesblock)
                } else {
                    // A press visit (Stone 47): the
                    // window is painted again directly,
                    // by its own painter, when it stands
                    // forward — a press is received only
                    // in its window, and the window's
                    // painting is opaque and complete, so
                    // no road is washed and no bystander
                    // is repainted, packet after packet,
                    // for one cell's change. Until now
                    // every carried press ran the region
                    // road over the window's whole place:
                    // the road washed black and the
                    // window repainted whole, its closure
                    // bystanders with it, many times a
                    // second — the flicker Tyler saw
                    // while painting (Nov 24, 2026); the
                    // flicker was the wash. A press
                    // received while the window does not
                    // stand forward keeps the road, whose
                    // standing order paints what stands
                    // over the window after it.
                    if pget(pixdesk, 180) == 6 {
                        pset(pixdesk, 400, 6)
                        callpainter(pixdesk, cellblock, notesblock)
                    } else {
                        layroadwins(pixdesk, 6, 0)
                        paintregion(pixdesk, cellblock, notesblock)
                    }
                    // The files window's list (Stone
                    // 47): when the keeping above changed
                    // the kept picture's standing, the
                    // list is owed a repaint — remembered
                    // here, and paid once where the
                    // button is let go, at the stroke's
                    // end, not per packet.
                    if pget(pixdesk, 296) != picstood {
                        filesowed = 1
                    }
                }
            }
            if phow == 1 {
                refusenote()
                ansrow = printline(ansrow, "There is no paint feather on this disc to visit.", pix, pixdesk)
            }
            if phow == 2 {
                refusenote()
                ansrow = printline(ansrow, "The paint feather on this disc is not whole, so it was not let in.", pix, pixdesk)
            }
            if phow == 3 {
                if pgift == 1 {
                    ansrow = printline(ansrow, "The paint feather visited. Pick a color, then draw.", pix, pixdesk)
                }
            }
        }
    }

    // A calculator feather visit owed — the opening visit
    // the word 'calculator' asked for, or a press the
    // pointer carried in (Stone 30) — is received here,
    // through the same door and the same reckoning as its
    // sisters' visits: the calculator feather's own card
    // is read and its bytes reckoned on EVERY visit, and
    // only a whole feather is laid at the doorstep and
    // called, with the gift the asking carries and the
    // calculator window's own cells named as its screen.
    // A visit that stands leaves the feather's painting
    // in those cells — its invitation, its sum's line,
    // and its keys, the reckoning itself kept in the
    // cells between visits — and the window is painted
    // again from them; a refusal is sounded and said in
    // plain words, exactly as its sisters' refusals are.
    // (Presses are carried only once a first visit has
    // stood — the pointer's asking above keeps that — so
    // a disc whose calculator feather is refused hears
    // the refusal once, at its asking, and not once a
    // press.)
    if calcask != 0 {
        let cgift = calcask
        calcask = 0
        if pix == 1 {
            let chow = runfeather(calcimg, calcgot, blockaddr(calcblock), cgift)
            // The door's reckoning (Stone 42), as at
            // the welcome feather's receiving.
            if chow == 3 {
                shieldin = shieldin + 1
                pset(pixdesk, 456, shieldin)
            }
            if chow == 2 {
                shieldout = shieldout + 1
                pset(pixdesk, 460, shieldout)
            }
            if chow == 3 {
                pset(pixdesk, 344, 1)
                if cgift == 1 {
                    // The opening visit (Stone 35): the
                    // visit changed only the calculator
                    // window's cells — the region road
                    // over that window repaints it.
                    layroadwins(pixdesk, 8, 0)
                    paintregion(pixdesk, cellblock, notesblock)
                } else {
                    // A press visit (Stone 47): the
                    // window is painted again directly,
                    // by its own painter, when it stands
                    // forward — the same healing the
                    // paint window's presses take, and
                    // for the same reason: a press changes
                    // one window's cells, and the road's
                    // wash was the flicker. A press
                    // received while the window does not
                    // stand forward keeps the road.
                    if pget(pixdesk, 180) == 8 {
                        pset(pixdesk, 400, 8)
                        callpainter(pixdesk, cellblock, notesblock)
                    } else {
                        layroadwins(pixdesk, 8, 0)
                        paintregion(pixdesk, cellblock, notesblock)
                    }
                }
            }
            if chow == 1 {
                refusenote()
                ansrow = printline(ansrow, "There is no calculator feather on this disc to visit.", pix, pixdesk)
            }
            if chow == 2 {
                refusenote()
                ansrow = printline(ansrow, "The calculator feather on this disc is not whole, so it was not let in.", pix, pixdesk)
            }
            if chow == 3 {
                if cgift == 1 {
                    ansrow = printline(ansrow, "The calculator feather visited. Press its keys to reckon.", pix, pixdesk)
                }
            }
        }
    }

    // A resting chosen — by the words 'shutdown' or
    // 'restart', by the rest panel's rows, or by the text
    // face's offered answer — is done here, the one doing
    // for every choosing (Stone 25), as the feather's
    // receiving above serves both its askings.
    //
    // First the disk is flushed, honestly, whichever
    // resting was chosen: when a disk is keeping things,
    // the kept settings card and the notes page are
    // written through once more, whole — the same
    // rememberall and notesave every keeping has always
    // used — and the drive is then sent its own flush
    // word (diskkeep.nifla's ataflush), so anything the
    // drive itself still holds is committed too. There
    // is no other cache to flush: the system's writings
    // were never held anywhere — each keeping was a
    // completed writing at the moment it was made — and
    // this final writing-through is exactly what it
    // says: the last state, written once more, and the
    // device told to commit its own.
    if restdo != 0 {
        let resting = restdo
        restdo = 0
        if pix == 1 {
            if pget(pixdesk, 292) == 1 {
                pset(pixdesk, 292, 0)
                restwash(pixdesk)
                paintwindows(pixdesk, cellblock, notesblock)
            }
        }
        if diskset == 1 {
            let chbyte = 2
            if chimeon == 1 {
                chbyte = 1
            }
            let keptcard = krememberall(xdesk, keepusb, offset, chbyte, wordsize + 1)
            let keptnotes = knotesave(xdesk, keepusb, notesblock, notecount)
        }
        if diskup == 1 {
            let flushed = kflush(xdesk, keepusb)
        }
        if resting == 1 {
            // Shut down: a short, kind goodbye in plain
            // words, then the ACPI power doors are tried
            // (rest.nifla). If the machine powers off,
            // nothing below is ever reached. If it stays
            // on, plain words say so — it is now safe to
            // turn the machine off — and the machine
            // halts where it stands, its goodbye standing
            // on the screen, the processor sleeping.
            ansrow = printline(ansrow, "Goodbye for now. Thank you for using this computer.", pix, pixdesk)
            if diskset == 1 {
                ansrow = printline(ansrow, "Your notes and choices are kept on the disk.", pix, pixdesk)
            }
            powerofftry()
            ansrow = printline(ansrow, "The machine is still on. It is now safe to turn it off.", pix, pixdesk)
            haltmachine()
        }
        if resting == 2 {
            // Restart: the same flush above, a plain word
            // that the machine will start again, and the
            // reset doors are tried (rest.nifla) — the
            // machine boots again fresh, and what was
            // kept is read back from the disk as it rises,
            // as at every boot. If neither door answers,
            // the machine is still on and says so, and
            // carries on.
            ansrow = printline(ansrow, "The machine will start again now.", pix, pixdesk)
            if diskset == 1 {
                ansrow = printline(ansrow, "Your notes and choices are kept on the disk.", pix, pixdesk)
            }
            machinerestart()
            ansrow = printline(ansrow, "The machine could not start again, so it is still on.", pix, pixdesk)
        }
    }

    // The answers' repaint (Stone 38): if this pass
    // moved the answer stream, the terminal window's
    // region is repainted in the standing order, so
    // the new answers stand in their window — under
    // any window that stands over it, never over.
    if pix == 1 {
        if ansrow != anslaid {
            anslaid = ansrow
            if pget(pixdesk, 404) == 1 {
                layroadwins(pixdesk, 10, 0)
                paintregion(pixdesk, cellblock, notesblock)
            }
        }
    }

    // The arrow is laid again, wherever it now stands
    // (Stone 13): the square under it kept first, so the
    // next pass can lay that square back untouched.
    if pix == 1 {
        if mouseup == 1 {
            pixsave(pixdesk, mx, my)
            pixarrow(pixdesk, mx, my)
            mshown = 1
        }
    }
    waittick()
}
