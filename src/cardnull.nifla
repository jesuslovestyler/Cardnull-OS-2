                                    if pget(pixdesk, 220) == 1 {
                                        pset(pixdesk, 180, 5)
                                    }
                                }
                                paintwindows(pixdesk, cellblock, notesblock)
                            }
                        }
                    } else {
                if k == 14 {
                    // Backspace: forget the last key. While
                    // the editor window stands forward in
                    // its writing way (Stone 21), the key
                    // forgets the draft's last letter
                    // instead, and the typing line is not
                    // touched.
                    let edwrite = 0
                    if pix == 1 {
                        if pget(pixdesk, 180) == 5 {
                            if pget(pixdesk, 224) == 1 {
                                if pget(pixdesk, 308) == 0 {
                                    edwrite = 1
                                }
                            }
                        }
                    }
                    // While the files window stands forward
                    // with a naming standing in it (Stone
                    // 40), the key forgets the name's last
                    // letter instead, the same way — and
                    // the naming's spoken word is put away,
                    // for the name it spoke of is changing.
                    let nmwrite = 0
                    if pix == 1 {
                        if pget(pixdesk, 180) == 3 {
                            if pget(pixdesk, 376) > 0 {
                                nmwrite = 1
                            }
                        }
                    }
                    if nmwrite == 1 {
                        if notesblock[576] > 0 {
                            notesblock[576] = notesblock[576] - 1
                            pset(pixdesk, 380, 0)
                            layroadwins(pixdesk, 3, 0)
                            paintregion(pixdesk, cellblock, notesblock)
                        }
                    } else {
                    if edwrite == 1 {
                        if notesblock[512] > 0 {
                            notesblock[512] = notesblock[512] - 1
                            paintwindows(pixdesk, cellblock, notesblock)
                        }
                    } else {
                        if klen > 0 {
                            klen = klen - 1
                        }
                        drawtyping(buildline(keys, keymod, 0, klen), pix, pixdesk)
                    }
                    }
                } else {
                    // A letter or a mark: resolve its shift
                    // standing now, under the shifts as they
                    // stand — the shift keys, with Caps Lock
                    // folded in for the letters alone — and
                    // keep the standing beside the key, so
                    // the line is rebuilt exactly as it was
                    // typed (Stone 12).
                    let sh = lshift
                    if rshift == 1 {
                        sh = 1
                    }
                    let mod = sh
                    if isletter(k) == 1 {
                        mod = sh + caps
                        if mod == 2 {
                            mod = 0
                        }
                    }
                    let ch = charFor(k, mod)
                    if length(ch) > 0 {
                        // While the editor window stands
                        // forward in its writing way (Stone
                        // 21), the letter goes into the
                        // draft instead of the typing line —
                        // resolved under the same shifts and
                        // Caps Lock, so the window's typing
                        // is the desktop's real typing — and
                        // the draft stops at a note's
                        // measure, forty-three letters, the
                        // limit the window itself names.
                        let edwrite = 0
                        if pix == 1 {
                            if pget(pixdesk, 180) == 5 {
                                if pget(pixdesk, 224) == 1 {
                                    if pget(pixdesk, 308) == 0 {
                                        edwrite = 1
                                    }
                                }
                            }
                        }
                        // While the files window stands
                        // forward with a naming standing in
                        // it (Stone 40), the letter goes
                        // into the name being typed (the
                        // block's tenth slot) instead —
                        // resolved under the same shifts
                        // and Caps Lock, and stopped at the
                        // name's measure: nineteen letters
                        // for a note's name, forty-three
                        // for the picture's, the measures
                        // the window itself names. The
                        // naming's spoken word is put away
                        // as the name changes.
                        let nmwrite = 0
                        if pix == 1 {
                            if pget(pixdesk, 180) == 3 {
                                if pget(pixdesk, 376) > 0 {
                                    nmwrite = 1
                                }
                            }
                        }
                        if nmwrite == 1 {
                            let nmcap = 19
                            if pget(pixdesk, 376) == 3 {
                                nmcap = 43
                            }
                            if notesblock[576] < nmcap {
                                notesblock[576 + notesblock[576] + 1] = textbyte(ch, 0)
                                notesblock[576] = notesblock[576] + 1
                                pset(pixdesk, 380, 0)
                                layroadwins(pixdesk, 3, 0)
                                paintregion(pixdesk, cellblock, notesblock)
                            }
                        } else {
                        if edwrite == 1 {
                            if notesblock[512] < 43 {
                                notesblock[512 + notesblock[512] + 1] = textbyte(ch, 0)
                                notesblock[512] = notesblock[512] + 1
                                paintwindows(pixdesk, cellblock, notesblock)
                            }
                        } else {
                            // The first key of a line raises
                            // the terminal (Stone 38): the
                            // typing line lives in its
                            // window now, and a letter never
                            // lands in a closed console.
                            if pix == 1 {
                                if pget(pixdesk, 404) == 0 {
                                    pset(pixdesk, 404, 1)
                                    pset(pixdesk, 180, 10)
                                    paintwindows(pixdesk, cellblock, notesblock)
                                }
                            }
                            if klen < 48 {
                                keys[klen] = k
                                keymod[klen] = mod
                                klen = klen + 1
                            }
                            drawtyping(buildline(keys, keymod, 0, klen), pix, pixdesk)
                        }
                        }
                    }
                }
                    }
                }
            }
        }
    }
    // The pointer's asking (Stone 13): the mouse's whole
    // packets move the arrow's place — the mouse speaks
    // of up as forward, so its travel is taken from the
    // screen's reckoning — and a fresh press of its first
    // button speaks to the windows (Stone 14): a close
    // mark closes, a press on the feather's panel asks for
    // the feather as the word does, and a press on a window
    // brings it forward. A press on a title bar takes hold
    // of its window for a drag (Stone 22), and each packet
    // while the button stands held moves the held window
    // with the pointer, as the packet reckoning below
    // tells. The place is kept on the screen,
    // the arrow's whole patch whole: sixteen wide, and
    // seventeen tall (the pointer trail fix — the white
    // edge's bottom row stands at my + 16, so the corner
    // is kept seventeen rows from the screen's bottom).
    if pix == 1 {
        if mouseup == 1 {
            let mp = 0
            while mp < 8 {
                if mousepoll(mousedesk) == 1 {
                    mx = mx + mousedx(mousedesk)
                    my = my - mousedy(mousedesk)
                    if mx < 0 {
                        mx = 0
                    }
                    if my < 0 {
                        my = 0
                    }
                    let maxx = pget(pixdesk, 8) - 16
                    let maxy = pget(pixdesk, 12) - 17
                    if mx > maxx {
                        mx = maxx
                    }
                    if my > maxy {
                        my = maxy
                    }
                    let btn = mousedesk[5]
                    // The cell's size in pixels (Stone 28):
                    // the one measure every reckoning below
                    // reads, as every painter reads it — so
                    // the pointer lands where the words
                    // stand, at either size.
                    let cellpx = pget(pixdesk, 320)
                    // The drag follows (Stone 22): while a
                    // window stands held by its title bar
                    // and the button stands held with it,
                    // the window is set where the pointer's
                    // hold on it now stands — its new place
                    // clamped whole onto the desktop, at the
                    // edges simply. Stone 34 first narrowed
                    // the repaint to the road travelled;
                    // Stone 45 narrows the step itself:
                    // a step paints only the ground the
                    // window is leaving and the window at
                    // its new place (dragstep), and never a
                    // bystander window — the whole-window
                    // repainting of every window the road
                    // touched, step after step, was the
                    // flicker. The windows a step uncovers
                    // stand washed for the drag's length.
                    // Letting the button go sets the window
                    // down and makes the glass whole: one
                    // whole repaint (Stone 47) repaints
                    // everything the steps left washed, in
                    // the standing order, once — where
                    // Stones 34 and 45 paid a region
                    // repaint over the drag's gathered
                    // road, whose healing reached only as
                    // far as the road. The arrow is
                    // off the screen for the whole of this
                    // pass (it is laid again at the pass's
                    // end, over the kept patch, as always),
                    // so a drag leaves no trail of it.
                    if dragwin != 0 {
                        if andmask(btn, 1) == 0 {
                            // Stone 47: the drop pays one
                            // whole repaint. paintwindows
                            // lays every window, icon,
                            // ground line, and chip from
                            // the standing, in the standing
                            // order, so the glass after a
                            // drag is whole whatever road
                            // the steps travelled and
                            // whatever they washed. Until
                            // now the drop paid a region
                            // repaint over the drag's
                            // gathered road, whose healing
                            // reached exactly as far as its
                            // road and its closure's set: a
                            // window the steps had left
                            // washed and unpainted — the
                            // bench's mouse can lose the
                            // packet that would have
                            // painted it, and on UTM the
                            // same roads offered no
                            // whole-glass promise either —
                            // stood broken until some later
                            // pass happened by. The steps
                            // keep Stone 45's diet: nothing
                            // here repaints during the
                            // drag, and the drop is a single
                            // deliberate moment.
                            paintwindows(pixdesk, cellblock, notesblock)
                            dragwin = 0
                            dragdirty = 0
                        } else {
                            let dw = winwide(pixdesk, dragwin)
                            let dh = winhigh(pixdesk, dragwin)
                            let nl = (mx + 2) / cellpx - draggox
                            let nt = (my + 2) / cellpx - draggoy
                            if nl < 0 {
                                nl = 0
                            }
                            if nt < 0 {
                                nt = 0
                            }
                            let maxl = pget(pixdesk, 28) - dw
                            // The desktop above the bar
                            // (Stone 33): a window's foot
                            // stands at the bar's top edge
                            // at the lowest.
                            let maxt = pget(pixdesk, 32) - 2 - dh
                            if nl > maxl {
                                nl = maxl
                            }
                            if nt > maxt {
                                nt = maxt
                            }
                            let ol = winleft(pixdesk, dragwin)
                            let ot = wintop(pixdesk, dragwin)
                            let moved = 0
                            if nl != ol {
                                moved = 1
                            }
                            if nt != ot {
                                moved = 1
                            }
                            if moved == 1 {
                                // The Drag Mend (November
                                // 27, 2026): the packet
                                // moves the window's place
                                // silently and owes the
                                // pass one step, paid at
                                // the packet gathering's
                                // end below — never a
                                // repaint here, inside the
                                // gathering. Until this
                                // mend a step was paid per
                                // packet, whole-window
                                // repaint and all, while
                                // the mouse's later packets
                                // waited at the controller:
                                // on a faithful, fast
                                // pointer (UTM's) the
                                // waiting packets overflowed
                                // the controller's keeping,
                                // the gathering lost its
                                // place, the buttons read
                                // wrong, and drops and
                                // take-holds fired again and
                                // again — every window
                                // flickering, the pointer
                                // wedged — while the bench's
                                // slow, lossy mouse never
                                // filled the keeping and
                                // never showed it. Now the
                                // gathering costs arithmetic
                                // only, however fast the
                                // packets come, and the one
                                // step at the pass's end
                                // paints the window at its
                                // final place.
                                winmove(pixdesk, dragwin, nl, nt)
                                dragdirty = 1
                            }
                        }
                    }
                    // The paint feather's carried presses
                    // (Stone 24): while the paint window
                    // stands open and a visit has stood in
                    // it, a packet that finds the first
                    // button held with the arrow's point
                    // inside the window's shown cells
                    // carries that press across the desk —
                    // the press's place in the cells' own
                    // reckoning (the shown region is the
                    // text rows 10 to 20 and columns 14 to
                    // 65, laid 1:1 at the window's second
                    // column and third row, as onepaint
                    // lays it), packed as the feather
                    // expects: 1000 plus the row times 100
                    // plus the column. The host reckons
                    // nothing of what the press means; the
                    // feather does, when the visit is
                    // received below. A held drag paints as
                    // it goes: each packet's press is
                    // carried, and the feather lays its
                    // cell. A window held by its title bar
                    // is being dragged, not painted — the
                    // drag's standing above says so, and no
                    // press is carried while a drag stands.
                    // (Mend, found by Stone 49: the road
                    // once carried a press whenever the
                    // paint window stood open and visited,
                    // though another window stood forward
                    // — the files window's own presses,
                    // landing inside the shown region's
                    // ground, were carried here and laid
                    // their cell, and the keeping that
                    // follows a visit wrote the canvas
                    // back over whatever the forward
                    // window had just done; Stone 49's
                    // picture exchange was corrupted so,
                    // one byte in the copying and the
                    // whole brought-in picture in the
                    // bringing. A press is carried now
                    // only while the paint window stands
                    // forward (the forward reckoning,
                    // 180, is 6): while another window
                    // stands forward, the press is that
                    // window's alone, exactly as if the
                    // paint window stood closed.)
                    if dragwin == 0 {
                        if andmask(btn, 1) == 1 {
                            if pget(pixdesk, 292) == 0 {
                            if pget(pixdesk, 180) == 6 {
                            if pget(pixdesk, 272) == 1 {
                                if pget(pixdesk, 276) == 1 {
                                    let qx = paleft(pixdesk)
                                    let qy = patop(pixdesk)
                                    // The shown cells stand
                                    // at sixteen pixels at
                                    // either word size
                                    // (onepaint's reckoning):
                                    // the press's cell is
                                    // counted from the shown
                                    // region's own corner, in
                                    // pixels.
                                    let prow = (my + 2 - qy * cellpx - 2 * cellpx) / 16 + 10
                                    let pcol = (mx + 2 - qx * cellpx - cellpx) / 16 + 14
                                    if prow >= 10 {
                                        if prow <= 20 {
                                            if pcol >= 14 {
                                                if pcol <= 65 {
                                                    paintask = 1000 + prow * 100 + pcol
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            }
                            }
                        }
                    }
                    // The calculator feather's carried
                    // presses (Stone 30): the paint
                    // feather's own road, for the calculator
                    // window — while it stands open and a
                    // visit has stood in it, a packet that
                    // finds the first button held with the
                    // arrow's point inside its shown cells
                    // carries that press across the desk,
                    // packed exactly as the paint presses
                    // are, and the calculator feather reckons
                    // what it means when the visit is
                    // received below. A held drag carries
                    // each packet's press, as Paint's does.
                    if dragwin == 0 {
                        if andmask(btn, 1) == 1 {
                            if pget(pixdesk, 292) == 0 {
                            if pget(pixdesk, 340) == 1 {
                                if pget(pixdesk, 344) == 1 {
                                    let kx2 = caleft(pixdesk)
                                    let ky2 = catop(pixdesk)
                                    let krow = (my + 2 - ky2 * cellpx - 2 * cellpx) / 16 + 10
                                    let kcol = (mx + 2 - kx2 * cellpx - cellpx) / 16 + 14
                                    if krow >= 10 {
                                        if krow <= 20 {
                                            if kcol >= 14 {
                                                if kcol <= 65 {
                                                    calcask = 1000 + krow * 100 + kcol
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            }
                        }
                    }
                    if btn != mbtn {
                        if andmask(btn, 1) == 0 {
                            if andmask(mbtn, 1) == 1 {
                                // The button let go (Stone
                                // 47): a paint stroke that
                                // changed the kept picture's
                                // standing owes the files
                                // window's list one repaint,
                                // paid here, at the stroke's
                                // end — the region road over
                                // the files window alone, in
                                // the standing order. A
                                // stroke that changed nothing
                                // owes nothing, and a closed
                                // files window is owed
                                // nothing: the owing is
                                // simply forgotten. (A drag's
                                // letting go is reckoned
                                // above, in the drag's
                                // following, and no stroke
                                // can stand owing across one:
                                // presses are carried only
                                // while no drag stands.)
                                if filesowed == 1 {
                                    filesowed = 0
                                    if pget(pixdesk, 188) == 1 {
                                        layroadwins(pixdesk, 3, 0)
                                        paintregion(pixdesk, cellblock, notesblock)
                                    }
                                }
                            }
                        }
                        if andmask(btn, 1) == 1 {
                            if andmask(mbtn, 1) == 0 {
                                // A fresh press (Stone 14):
                                // the arrow's point is tried
                                // against the windows, in
                                // their order of meaning —
                                // a close mark closes its
                                // window; a press on the
                                // feather's panel receives the
                                // feather, as it has since
                                // Stone 13, and brings its
                                // window forward; a press
                                // anywhere else on a window
                                // brings that window forward.
                                let cxp = mx + 2
                                let cyp = my + 2
                                let pl = pget(pixdesk, 140)
                                let pt = pget(pixdesk, 144)
                                let pw = pget(pixdesk, 148)
                                let ph = pget(pixdesk, 152)
                                let gx = fwleft(pixdesk)
                                let gy = fwtop(pixdesk)
                                let gw = fwwide(pixdesk)
                                let gh = fwhigh(pixdesk)
                                let fx = fileft(pixdesk)
                                let fy = fitop(pixdesk)
                                let fw = fiwide(pixdesk)
                                let fh = fihigh(pixdesk)
                                let sx = seleft(pixdesk)
                                let sy = setop(pixdesk)
                                let sw = sewide(pixdesk)
                                let sh = sehigh(pixdesk)
                                let ex = edleft(pixdesk)
                                let ey = edtop(pixdesk)
                                let ew = edwide(pixdesk)
                                let eh = edhigh(pixdesk)
                                let qx = paleft(pixdesk)
                                let qy = patop(pixdesk)
                                let qw = pawide(pixdesk)
                                let qh = pahigh(pixdesk)
                                let vx = vleft(pixdesk)
                                let vy = vtop(pixdesk)
                                let vw = vwide(pixdesk)
                                let vh = vhigh(pixdesk)
                                let kx = caleft(pixdesk)
                                let ky = catop(pixdesk)
                                let kw = cawide(pixdesk)
                                let kh = cahigh(pixdesk)
                                let hx = hleft(pixdesk)
                                let hy = htop(pixdesk)
                                let hw = hwide(pixdesk)
                                let hh = hhigh(pixdesk)
                                let tx = teleft(pixdesk)
                                let ty = tetop(pixdesk)
                                let tw = tewide(pixdesk)
                                let th = tehigh(pixdesk)
                                let jx = bleft(pixdesk)
                                let jy = btop(pixdesk)
                                let jw = bwide(pixdesk)
                                let jh = bhigh(pixdesk)
                                let zx = shleft(pixdesk)
                                let zy = shtop(pixdesk)
                                let zw = shwide(pixdesk)
                                let zh = shhigh(pixdesk)
                                let ux = puleft(pixdesk)
                                let uy = putop(pixdesk)
                                let uw = puwide(pixdesk)
                                let uh = puhigh(pixdesk)
                                let acted = 0
                                if acted == 0 {
                                    // The rest panel (Stone
                                    // 25): while it stands
                                    // open, a press is the
                                    // panel's alone — a press
                                    // on Shut down's row or
                                    // Restart's row carries
                                    // that choice to the one
                                    // resting doing at the
                                    // loop's end, a press on
                                    // Stay's row or anywhere
                                    // else puts the panel
                                    // away and rests nothing —
                                    // and no press that meets
                                    // the panel ever takes
                                    // hold of a window for a
                                    // drag. The panel's place
                                    // is read through its own
                                    // reckonings (restleft
                                    // and its kin), the ones
                                    // its painter reads.
                                    if pget(pixdesk, 292) == 1 {
                                        let rl = restleft(pixdesk)
                                        let rt = resttop(pixdesk)
                                        let rw = restwide(pixdesk)
                                        let rh = resthigh(pixdesk)
                                        pset(pixdesk, 292, 0)
                                        restwash(pixdesk)
                                        if cxp >= rl * cellpx {
                                            if cxp < (rl + rw) * cellpx {
                                                if cyp >= rt * cellpx {
                                                    if cyp < (rt + rh) * cellpx {
                                                        let rpick = cyp / cellpx - rt
                                                        if rpick == 1 {
                                                            restdo = 1
                                                        }
                                                        if rpick == 2 {
                                                            restdo = 2
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        paintwindows(pixdesk, cellblock, notesblock)
                                        acted = 1
                                    }
                                }
                                if acted == 0 {
                                    // The bar and its menu
                                    // (Stone 23): while the
                                    // menu stands open, a
                                    // press is the menu's
                                    // alone — a press on a
                                    // choice opens its
                                    // window, exactly as the
                                    // choice's typed word
                                    // does (the feather's
                                    // choice asks for the
                                    // feather, as the word
                                    // does), and a press
                                    // anywhere else puts the
                                    // menu away without
                                    // opening anything — and
                                    // without taking hold of
                                    // any window for a drag:
                                    // a menu press is never
                                    // a title-bar drag. While
                                    // the menu stands closed,
                                    // a press on the start
                                    // button opens it (Stone
                                    // 33: the button, not the
                                    // bar — a press elsewhere
                                    // on the bar is a press
                                    // on the desktop, and no
                                    // window can stand on the
                                    // bar's rows, so the
                                    // button's press is the
                                    // menu's alone too). The menu's
                                    // place is read through
                                    // its own reckonings
                                    // (menuleft and its kin),
                                    // the ones its painter
                                    // reads.
                                    if pget(pixdesk, 268) == 1 {
                                        let ml = menuleft(pixdesk)
                                        let mt = menutop(pixdesk)
                                        let mw = menuwide(pixdesk)
                                        let mh = menuhigh(pixdesk)
                                        let inmenu = 0
                                        if cxp >= ml * cellpx {
                                            if cxp < (ml + mw) * cellpx {
                                                if cyp >= mt * cellpx {
                                                    if cyp < (mt + mh) * cellpx {
                                                        inmenu = 1
                                                    }
                                                }
                                            }
                                        }
                                        pset(pixdesk, 268, 0)
                                        menuwash(pixdesk)
                                        if inmenu == 1 {
                                            let pick = cyp / cellpx - mt
                                            if pick == 0 {
                                                pset(pixdesk, 172, 1)
                                                pset(pixdesk, 180, 1)
                                            }
                                            if pick == 1 {
                                                featherask = 1
                                            }
                                            if pick == 2 {
                                                pset(pixdesk, 188, 1)
                                                pset(pixdesk, 300, 0)
                                                pset(pixdesk, 180, 3)
                                            }
                                            if pick == 3 {
                                                pset(pixdesk, 220, 1)
                                                pset(pixdesk, 224, 0)
                                                pset(pixdesk, 228, 0)
                                                pset(pixdesk, 308, 0)
                                                pset(pixdesk, 180, 5)
                                            }
                                            if pick == 4 {
                                                // The menu's Paint
                                                // choice (Stone
                                                // 46): the paint
                                                // window opens and
                                                // the paint
                                                // feather's opening
                                                // visit is asked
                                                // for, exactly as
                                                // the word 'paint'
                                                // opens it.
                                                pset(pixdesk, 272, 1)
                                                pset(pixdesk, 180, 6)
                                                paintask = 1
                                            }
                                            if pick == 5 {
                                                // The menu's
                                                // Calculator choice
                                                // (Stone 30): the
                                                // calculator window
                                                // opens and the
                                                // feather's opening
                                                // visit is asked
                                                // for, exactly as
                                                // the word
                                                // 'calculator' opens
                                                // it.
                                                pset(pixdesk, 340, 1)
                                                pset(pixdesk, 180, 8)
                                                calcask = 1
                                            }
                                            if pick == 6 {
                                                // The menu's Verse
                                                // choice (Stone
                                                // 29): the verse
                                                // window opens and
                                                // the day's verse
                                                // is reckoned as it
                                                // opens, exactly as
                                                // the word 'verse'
                                                // opens it.
                                                pset(pixdesk, 336, verseday(utcnow, offset))
                                                pset(pixdesk, 324, 1)
                                                pset(pixdesk, 180, 7)
                                            }
                                            if pick == 7 {
                                                // The menu's Help
                                                // choice (Stone
                                                // 31): the help
                                                // window opens with
                                                // its first page
                                                // standing in it,
                                                // exactly as the
                                                // word 'help' opens
                                                // it.
                                                pset(pixdesk, 364, 0)
                                                pset(pixdesk, 360, 1)
                                                pset(pixdesk, 180, 9)
                                            }
                                            if pick == 8 {
                                                pset(pixdesk, 208, 1)
                                                pset(pixdesk, 180, 4)
                                            }
                                            if pick == 9 {
                                                // The menu's
