                                                                            let xfound = 0 - 1
                                                                            let xci = 0
                                                                            while xci < xscount {
                                                                                if xfound < 0 {
                                                                                    if slotstandsmatch(notesblock, xsel, sticknotes, xci) == 1 {
                                                                                        xfound = xci
                                                                                    }
                                                                                }
                                                                                xci = xci + 1
                                                                            }
                                                                            if xfound < 0 {
