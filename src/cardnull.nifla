// Cardnull OS 2 — the seed kernel.
//
// Stone 1: first boot — the greeting and the memory figure.
// Stone 2: ears — the keyboard is heard; a typing line and
//          plain-words commands.
// Stone 3: a face — the desktop. A top bar carries the name
//          and a live clock; a welcome panel sits in the
//          middle; answers have their own region of the
//          screen and scroll there; the typing line still
//          works at the bottom. The face is drawn with the
//          system's own screen library (screenlib.nifla,
//          joined to this program as a prelude at build).
//
// The arrangement of the screen:
//   row 0      the bar — "Cardnull" at the left, the clock
//              at the right, white on blue
//   rows 3-9   the welcome panel, black on light gray
//   row 11     the invitation: what words the machine knows
//   rows 13-22 the answers, newest at the bottom
//   row 24     the typing line
//
// The clock counts from the moment the machine woke (there
// is no reading of the world's clock yet): it shows the
// hours, minutes, and seconds since boot, plainly.

// ---- the keyboard's letters (Stone 2) ----

make charFor(code) {
    if code == 16 { give "q" }
    if code == 17 { give "w" }
    if code == 18 { give "e" }
    if code == 19 { give "r" }
    if code == 20 { give "t" }
    if code == 21 { give "y" }
    if code == 22 { give "u" }
    if code == 23 { give "i" }
    if code == 24 { give "o" }
    if code == 25 { give "p" }
    if code == 30 { give "a" }
    if code == 31 { give "s" }
    if code == 32 { give "d" }
    if code == 33 { give "f" }
    if code == 34 { give "g" }
    if code == 35 { give "h" }
    if code == 36 { give "j" }
    if code == 37 { give "k" }
    if code == 38 { give "l" }
    if code == 44 { give "z" }
    if code == 45 { give "x" }
    if code == 46 { give "c" }
    if code == 47 { give "v" }
    if code == 48 { give "b" }
    if code == 49 { give "n" }
    if code == 50 { give "m" }
    if code == 57 { give " " }
    give ""
}

// The typed line, rebuilt from the first 'count' scancodes
// in 'buf' (Stone 2).
make buildline(buf, count) {
    let s = ""
    let i = 0
    while i < count {
        s = s + charFor(buf[i])
        i = i + 1
    }
    give s
}

// Draws the typing line on the screen's last row.
make drawtyping(text) {
    floor(text) {
        mov rdx, 0xB8000
        add rdx, 3840
        mov byte ptr [rdx], 62
        mov byte ptr [rdx + 1], 0x07
        mov byte ptr [rdx + 2], 32
        mov byte ptr [rdx + 3], 0x07
        add rdx, 4
        mov rcx, 0
    dt_loop:
        cmp rcx, r12
        jae dt_blank
        mov al, [rbx + rcx]
        mov [rdx + rcx * 2], al
        mov byte ptr [rdx + rcx * 2 + 1], 0x07
        inc rcx
        jmp dt_loop
    dt_blank:
        cmp rcx, 48
        jae dt_done
        mov byte ptr [rdx + rcx * 2], 32
        mov byte ptr [rdx + rcx * 2 + 1], 0x07
        inc rcx
        jmp dt_blank
    dt_done:
    }
}

// ---- the clock ----

// A number written with a leading zero when it is small:
// 7 becomes "07", so the clock's face keeps its shape.
make pad2(n) {
    if n < 10 {
        give "0" + n
    }
    give "" + n
}

// The clock's face for a count of seconds: hours, minutes,
// and seconds, each two digits, the hours within the day.
make clocktext(total) {
    let hours = total / 3600
    let rest = total - hours * 3600
    let minutes = rest / 60
    let seconds = rest - minutes * 60
    while hours >= 24 {
        hours = hours - 24
    }
    give pad2(hours) + ":" + pad2(minutes) + ":" + pad2(seconds)
}

// ---- the face ----

// Draws the whole desktop: the bar with its clock, the
// welcome panel, and the invitation. The answers region is
// left blank, ready.
make drawface() {
    clearscreen()
    paintrow(0, 31)
    writeat(0, 1, "Cardnull", 31)
    writeat(0, 72, clocktext(ticks() / 100), 31)
    paintrect(3, 8, 64, 7, 112)
    writeat(4, 10, "Welcome to Cardnull", 112)
    writeat(5, 10, "This computer is public domain: free for everyone, forever.", 112)
    writeat(7, 10, "\"Unless Yahweh builds the house,", 112)
    writeat(8, 10, "they labor in vain who build it.\" - Psalm 127:1", 112)
    writeat(11, 2, "Type a word, then press Enter. Try: hello, time, memory, clear", 7)
}

// Writes one answer in the answer region at 'row', scrolling
// the region when it is full, and gives back the next row.
make printline(row, text) {
    let r = row
    if r > 22 {
        scrollanswers()
        r = 22
    }
    writeat(r, 2, text, 7)
    give r + 1
}

// ---- the machine ----

drawface()

let keys = makebytes(48)
let klen = 0
let ansrow = 13
let lastsec = 0 - 1
drawtyping("")

while true {
    let nowsec = ticks() / 100
    if nowsec != lastsec {
        lastsec = nowsec
        writeat(0, 72, clocktext(nowsec), 31)
    }
    let k = readkey()
    if k != 0 {
        if k < 128 {
            if k == 28 {
                // Enter: the word is finished; answer it.
                let cmd = buildline(keys, klen)
                klen = 0
                drawtyping("")
                if cmd == "clear" {
                    drawface()
                    ansrow = 13
                    lastsec = 0 - 1
                } else {
                    let answered = 0
                    if cmd == "hello" {
                        ansrow = printline(ansrow, "Hello. It is good to see you.")
                        answered = 1
                    }
                    if cmd == "time" {
                        ansrow = printline(ansrow, "This machine has been awake for " + (ticks() / 100) + " seconds.")
                        answered = 1
                    }
                    if cmd == "memory" {
                        ansrow = printline(ansrow, "This machine has " + memorysize() + " bytes of memory (" + (memorysize() / 1048576) + " megabytes).")
                        answered = 1
                    }
                    if answered == 0 {
                        if length(cmd) > 0 {
                            ansrow = printline(ansrow, "I don't know that word yet. Try hello, time, memory, or clear.")
                        }
                    }
                }
            } else {
                if k == 14 {
                    // Backspace: forget the last key.
                    if klen > 0 {
                        klen = klen - 1
                    }
                    drawtyping(buildline(keys, klen))
                } else {
                    let ch = charFor(k)
                    if length(ch) > 0 {
                        if klen < 48 {
                            keys[klen] = k
                            klen = klen + 1
                        }
                        drawtyping(buildline(keys, klen))
                    }
                }
            }
        }
    }
    waittick()
}
