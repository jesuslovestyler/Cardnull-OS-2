                                                                            pset(pixdesk, 492, 3)
                                                                        } else {
                                                                            let xscount = unotesload(xdesk, sticknotes)
                                                                            let xdup = 0
                                                                            let xci = 0
                                                                            while xci < xscount {
                                                                                if slotstandsmatch(notesblock, xsel, sticknotes, xci) == 1 {
                                                                                    xdup = 1
                                                                                }
                                                                                xci = xci + 1
                                                                            }
                                                                            if xdup == 1 {
