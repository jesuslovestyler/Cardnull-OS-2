// Cardnull OS 2 — the seed kernel: this file is its main
// body.
//
// The kernel is built as several files, never one big one
// — Tyler's standing rule, kept from the first Cardnull OS,
// whose kernel stood in twenty files. The libraries join
// this body as preludes at build (build.sh names them
// all); each holds pure functions — values in as arguments,
// results back — and every piece of state lives here, in
// the main body, because on bare metal a function that
// reads or assigns the program's shared variables is given
// a broken value (the README's notes for builders tell it
// in full). The files:
//
//   src/screenlib.nifla  the screen library: drawing on
//                        the text screen's own memory
//   src/clock.nifla      the clock's face, and the
//                        reckoning behind the time choice
//   src/bootmods.nifla   the hands that read what the
//                        loader brought — the modules
//                        that ride the disc
//   src/guestdoor.nifla  the guest door: the card's check,
//                        the doorstep, the call, the
//                        plain-words refusals
//   src/commands.nifla   deciding what a typed word is
//                        answered with
//   src/usbkey.nifla     ears on the USB road: a UHCI
//                        host and a HID boot keyboard,
//                        its estate in one desk of bytes
//   src/cardnull.nifla   this main body: the boot
//                        sequence, the first-breath lift,
//                        the state, the face, the typing
//                        line, and the loop that calls
//                        the libraries
//
// (The welcome guest, src/welcome-guest.nifla, is a
// separate program that visits through the door; it is no
// part of the kernel.)
//
// Stone 1: first boot — the greeting and the memory figure.
// Stone 2: ears — the keyboard is heard; a typing line and
//          plain-words commands.
// Stone 3: a face — the desktop. A top bar carries the name
//          and a live clock; a welcome panel sits in the
//          middle; answers have their own region of the
//          screen and scroll there; the typing line still
//          works at the bottom. The face is drawn with the
//          system's own screen library (screenlib.nifla,
//          joined to this program as a prelude at build).
// Stone 4: the clock's time choice — the choice rides the
//          system disc itself, in a small settings module
//          the loader brings alongside the system, and the
//          words eastern and utc change it for the session.
//          A disc carrying no choice starts on Eastern
//          time, this system's home. (First proven kept on
//          a disk the same morning; Tyler's word that the
//          system ships as one disc and nothing else
//          re-pointed it here the same day — the README's
//          Stone 4 section tells it in full.)
// Stone 5: first guest — the word 'guest' receives the
//          welcome guest through the guest door: the guest
//          rides the disc as a module too, lifted into the
//          system's keeping at boot, checked against its
//          card (which rides as its own small module), run
//          to draw its own panel inside the desktop, and
//          returned from, with the system carrying on.
//
// The arrangement of the screen:
//   row 0      the bar — "Cardnull" at the left, the clock
//              at the right, white on blue
//   rows 3-9   the welcome panel, black on light gray
//   row 11     the invitation: what words the machine knows
//   rows 13-22 the answers, newest at the bottom
//   row 24     the typing line
//
// The clock counts from the moment the machine woke (there
// is no reading of the world's clock yet): it shows the
// hours, minutes, and seconds since boot, plainly.


// ---- the keyboard's letters (Stone 2) ----

make charFor(code) {
    if code == 16 { give "q" }
    if code == 17 { give "w" }
    if code == 18 { give "e" }
    if code == 19 { give "r" }
    if code == 20 { give "t" }
    if code == 21 { give "y" }
    if code == 22 { give "u" }
    if code == 23 { give "i" }
    if code == 24 { give "o" }
    if code == 25 { give "p" }
    if code == 30 { give "a" }
    if code == 31 { give "s" }
    if code == 32 { give "d" }
    if code == 33 { give "f" }
    if code == 34 { give "g" }
    if code == 35 { give "h" }
    if code == 36 { give "j" }
    if code == 37 { give "k" }
    if code == 38 { give "l" }
    if code == 44 { give "z" }
    if code == 45 { give "x" }
    if code == 46 { give "c" }
    if code == 47 { give "v" }
    if code == 48 { give "b" }
    if code == 49 { give "n" }
    if code == 50 { give "m" }
    if code == 57 { give " " }
    give ""
}

// The typed line, rebuilt from the first 'count' scancodes
// in 'buf' (Stone 2).
make buildline(buf, count) {
    let s = ""
    let i = 0
    while i < count {
        s = s + charFor(buf[i])
        i = i + 1
    }
    give s
}

// Draws the typing line on the screen's last row.
make drawtyping(text) {
    floor(text) {
        mov rdx, 0xB8000
        add rdx, 3840
        mov byte ptr [rdx], 62
        mov byte ptr [rdx + 1], 0x07
        mov byte ptr [rdx + 2], 32
        mov byte ptr [rdx + 3], 0x07
        add rdx, 4
        mov rcx, 0
    dt_loop:
        cmp rcx, r12
        jae dt_blank
        mov al, [rbx + rcx]
        mov [rdx + rcx * 2], al
        mov byte ptr [rdx + rcx * 2 + 1], 0x07
        inc rcx
        jmp dt_loop
    dt_blank:
        cmp rcx, 48
        jae dt_done
        mov byte ptr [rdx + rcx * 2], 32
        mov byte ptr [rdx + rcx * 2 + 1], 0x07
        inc rcx
        jmp dt_blank
    dt_done:
    }
}

// ---- the face ----

// Draws the whole desktop: the bar with its clock, the
// welcome panel, and the invitation. The answers region is
// left blank, ready.
make drawface(offset) {
    clearscreen()
    paintrow(0, 31)
    writeat(0, 1, "Cardnull", 31)
    writeat(0, 72, clocktext(ticks() / 100, offset), 31)
    paintrect(3, 8, 64, 7, 112)
    writeat(4, 10, "Welcome to Cardnull", 112)
    writeat(5, 10, "This computer is public domain: free for everyone, forever.", 112)
    writeat(7, 10, "\"Unless Yahweh builds the house,", 112)
    writeat(8, 10, "they labor in vain who build it.\" - Psalm 127:1", 112)
    writeat(11, 2, "Type a word, then Enter: hello, time, memory, eastern, utc, guest, usb, clear", 7)
}

// Writes one answer in the answer region at 'row', scrolling
// the region when it is full, and gives back the next row.
make printline(row, text) {
    let r = row
    if r > 22 {
        scrollanswers()
        r = 22
    }
    writeat(r, 2, text, 7)
    give r + 1
}

// ---- the machine ----

// The first breath: lift what the loader brought into the
// system's own keeping, before anything else is allocated
// (the discipline bootmods.nifla's note tells in full).
// First the module
// table's addresses, into plain numbers — the disc carries
// three modules; up to four are read.
let nmods = modcount()
let s0 = 0
let l0 = 0
let s1 = 0
let l1 = 0
let s2 = 0
let l2 = 0
let s3 = 0
let l3 = 0
if nmods > 0 {
    s0 = modstart(0)
    l0 = modend(0) - s0
}
if nmods > 1 {
    s1 = modstart(1)
    l1 = modend(1) - s1
}
if nmods > 2 {
    s2 = modstart(2)
    l2 = modend(2) - s2
}
if nmods > 3 {
    s3 = modstart(3)
    l3 = modend(3) - s3
}

// What the lift gathers: the clock's offset (Eastern, -5,
// unless the disc's settings carry a choice), and the
// guest — its card's word (how long the image is, and the
// checksum it must match) and the image itself, once found.
let offset = 0 - 5
let guestimg = makebytes(0)
let guestgot = 0
let guestimglen = 0
let guestwant = 0

let mi = 0
while mi < nmods {
    let s = 0
    let l = 0
    if mi == 0 { s = s0  l = l0 }
    if mi == 1 { s = s1  l = l1 }
    if mi == 2 { s = s2  l = l2 }
    if mi == 3 { s = s3  l = l3 }
    if l == 512 {
        let blk = makebytes(512)
        let c = modcopyfrom(s, l, blk)
        if blk[0] == 67 {
            if blk[1] == 78 {
                if blk[2] != 0 {
                    offset = blk[2] - 64
                }
            }
        }
    }
    if l == 32 {
        let blk = makebytes(32)
        let c = modcopyfrom(s, l, blk)
        if blk[0] == 67 {
            if blk[1] == 78 {
                if blk[2] == 67 {
                    if blk[3] == 71 {
                        guestimglen = cardnum(blk, 8)
                        guestwant = cardnum(blk, 16)
                    }
                }
            }
        }
    }
    mi = mi + 1
}

// The guest image itself, found by the length its card
// promises. (The layout's one assumption, stated plainly:
// a guest image is never as small as the 512-byte settings
// or the 32-byte card, so a module of exactly the promised
// length can only be the image.)
if guestimglen > 0 {
    if guestimglen <= 524288 {
        let mi2 = 0
        while mi2 < nmods {
            let s = 0
            let l = 0
            if mi2 == 0 { s = s0  l = l0 }
            if mi2 == 1 { s = s1  l = l1 }
            if mi2 == 2 { s = s2  l = l2 }
            if mi2 == 3 { s = s3  l = l3 }
            if l == guestimglen {
                let blk = makebytes(l)
                guestgot = modcopyfrom(s, l, blk)
                guestimg = blk
            }
            mi2 = mi2 + 1
        }
    }
}

// Ears on the USB road (Stone 6): the driver's whole
// estate lives in one desk of bytes, taken here and handed
// to its library (usbkey.nifla) at every asking — the
// raising walks the bus, wakes a keyboard if one stands on
// a port, and arms its report door. When no controller of
// the kind it speaks stands in the machine, or no keyboard
// is plugged in, the road is simply quiet and the PS/2
// road carries the typing alone, as before.
let usbdesk = makebytes(16384)
let usbup = usbinit(usbdesk)

drawface(offset)

let keys = makebytes(48)
let klen = 0
let ansrow = 13
let lastsec = 0 - 1
drawtyping("")
if usbup == 1 {
    ansrow = printline(ansrow, "A USB keyboard is ready.")
}

while true {
    let nowsec = ticks() / 100
    if nowsec != lastsec {
        lastsec = nowsec
        writeat(0, 72, clocktext(nowsec, offset), 31)
    }
    let k = readkey()
    if k == 0 {
        // The PS/2 road is quiet this pass; ask the USB road.
        k = usbpoll(usbdesk)
    }
    if k != 0 {
        if k < 128 {
            if k == 28 {
                // Enter: the word is finished; answer it. The
                // command library (commands.nifla) decides
                // what the word is answered with; the doing —
                // printing the line, drawing the face again,
                // receiving the guest, keeping the clock's
                // new offset — happens here, where the state
                // lives.
                let cmd = buildline(keys, klen)
                klen = 0
                drawtyping("")
                let kind = wordkind(cmd)
                if kind == 2 {
                    // 'clear': the face is drawn again, empty.
                    drawface(offset)
                    ansrow = 13
                    lastsec = 0 - 1
                }
                if kind == 3 {
                    // 'guest': receive it through the door
                    // (guestdoor.nifla), and say how it went.
                    let how = runguest(guestimg, guestgot, guestimglen, guestwant)
                    if how == 1 {
                        ansrow = printline(ansrow, "There is no guest on this disc to visit.")
                    }
                    if how == 2 {
                        ansrow = printline(ansrow, "The guest on this disc is not whole, so it was not let in.")
                    }
                    if how == 3 {
                        writeat(21, 2, "The guest visited, and has gone home again.", 7)
                    }
                }
                if kind == 4 {
                    // 'usb': the USB road reports its own
                    // standing, from its ledger.
                    if usbup == 1 {
                        ansrow = printline(ansrow, "A USB keyboard is ready. It has brought " + usbcount(usbdesk) + " keys so far.")
                    } else {
                        ansrow = printline(ansrow, "No USB keyboard is plugged in.")
                    }
                }
                if kind == 1 {
                    // A line of words answers it. The time
                    // words also move the clock's offset: the
                    // library reckons the new one, this body
                    // keeps it, and a moved offset means the
                    // bar's clock is drawn again at once.
                    let newoffset = wordoffset(cmd, offset)
                    if newoffset != offset {
                        offset = newoffset
                        lastsec = 0 - 1
                    }
                    ansrow = printline(ansrow, wordline(cmd))
                }
            } else {
                if k == 14 {
                    // Backspace: forget the last key.
                    if klen > 0 {
                        klen = klen - 1
                    }
                    drawtyping(buildline(keys, klen))
                } else {
                    let ch = charFor(k)
                    if length(ch) > 0 {
                        if klen < 48 {
                            keys[klen] = k
                            klen = klen + 1
                        }
                        drawtyping(buildline(keys, klen))
                    }
                }
            }
        }
    }
    waittick()
}
