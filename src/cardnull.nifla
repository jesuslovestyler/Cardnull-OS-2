// Cardnull OS 2 — the seed kernel.
//
// Stone 1: first boot — the greeting and the memory figure.
// Stone 2: ears — the keyboard is heard; a typing line and
//          plain-words commands.
// Stone 3: a face — the desktop. A top bar carries the name
//          and a live clock; a welcome panel sits in the
//          middle; answers have their own region of the
//          screen and scroll there; the typing line still
//          works at the bottom. The face is drawn with the
//          system's own screen library (screenlib.nifla,
//          joined to this program as a prelude at build).
// Stone 4: the clock's time choice — the choice rides the
//          system disc itself, in a small settings module
//          the loader brings alongside the system, and the
//          words eastern and utc change it for the session.
//          A disc carrying no choice starts on Eastern
//          time, this system's home. (First proven kept on
//          a disk the same morning; Tyler's word that the
//          system ships as one disc and nothing else
//          re-pointed it here the same day — the README's
//          Stone 4 section tells it in full.)
// Stone 5: first guest — the word 'guest' receives the
//          welcome guest through the guest door: the guest
//          rides the disc as a module too, lifted into the
//          system's keeping at boot, checked against its
//          card (which rides as its own small module), run
//          to draw its own panel inside the desktop, and
//          returned from, with the system carrying on.
//
// The arrangement of the screen:
//   row 0      the bar — "Cardnull" at the left, the clock
//              at the right, white on blue
//   rows 3-9   the welcome panel, black on light gray
//   row 11     the invitation: what words the machine knows
//   rows 13-22 the answers, newest at the bottom
//   row 24     the typing line
//
// The clock counts from the moment the machine woke (there
// is no reading of the world's clock yet): it shows the
// hours, minutes, and seconds since boot, plainly.

// ---- the keyboard's letters (Stone 2) ----

make charFor(code) {
    if code == 16 { give "q" }
    if code == 17 { give "w" }
    if code == 18 { give "e" }
    if code == 19 { give "r" }
    if code == 20 { give "t" }
    if code == 21 { give "y" }
    if code == 22 { give "u" }
    if code == 23 { give "i" }
    if code == 24 { give "o" }
    if code == 25 { give "p" }
    if code == 30 { give "a" }
    if code == 31 { give "s" }
    if code == 32 { give "d" }
    if code == 33 { give "f" }
    if code == 34 { give "g" }
    if code == 35 { give "h" }
    if code == 36 { give "j" }
    if code == 37 { give "k" }
    if code == 38 { give "l" }
    if code == 44 { give "z" }
    if code == 45 { give "x" }
    if code == 46 { give "c" }
    if code == 47 { give "v" }
    if code == 48 { give "b" }
    if code == 49 { give "n" }
    if code == 50 { give "m" }
    if code == 57 { give " " }
    give ""
}

// The typed line, rebuilt from the first 'count' scancodes
// in 'buf' (Stone 2).
make buildline(buf, count) {
    let s = ""
    let i = 0
    while i < count {
        s = s + charFor(buf[i])
        i = i + 1
    }
    give s
}

// Draws the typing line on the screen's last row.
make drawtyping(text) {
    floor(text) {
        mov rdx, 0xB8000
        add rdx, 3840
        mov byte ptr [rdx], 62
        mov byte ptr [rdx + 1], 0x07
        mov byte ptr [rdx + 2], 32
        mov byte ptr [rdx + 3], 0x07
        add rdx, 4
        mov rcx, 0
    dt_loop:
        cmp rcx, r12
        jae dt_blank
        mov al, [rbx + rcx]
        mov [rdx + rcx * 2], al
        mov byte ptr [rdx + rcx * 2 + 1], 0x07
        inc rcx
        jmp dt_loop
    dt_blank:
        cmp rcx, 48
        jae dt_done
        mov byte ptr [rdx + rcx * 2], 32
        mov byte ptr [rdx + rcx * 2 + 1], 0x07
        inc rcx
        jmp dt_blank
    dt_done:
    }
}

// ---- the clock ----

// A number written with a leading zero when it is small:
// 7 becomes "07", so the clock's face keeps its shape.
make pad2(n) {
    if n < 10 {
        give "0" + n
    }
    give "" + n
}

// The clock's face for a count of seconds: hours, minutes,
// and seconds, each two digits, the hours within the day and
// shifted by 'offset' hours — the person's time choice
// (Stone 4). The count itself is still the honest
// count since the machine woke; the offset only moves the
// hour the face shows, the way setting a clock does.
make clocktext(total, offset) {
    let hours = total / 3600
    let rest = total - hours * 3600
    let minutes = rest / 60
    let seconds = rest - minutes * 60
    while hours >= 24 {
        hours = hours - 24
    }
    hours = hours + offset
    if hours < 0 {
        hours = hours + 24
    }
    if hours >= 24 {
        hours = hours - 24
    }
    give pad2(hours) + ":" + pad2(minutes) + ":" + pad2(seconds)
}

// ---- the face ----

// Draws the whole desktop: the bar with its clock, the
// welcome panel, and the invitation. The answers region is
// left blank, ready.
make drawface(offset) {
    clearscreen()
    paintrow(0, 31)
    writeat(0, 1, "Cardnull", 31)
    writeat(0, 72, clocktext(ticks() / 100, offset), 31)
    paintrect(3, 8, 64, 7, 112)
    writeat(4, 10, "Welcome to Cardnull", 112)
    writeat(5, 10, "This computer is public domain: free for everyone, forever.", 112)
    writeat(7, 10, "\"Unless Yahweh builds the house,", 112)
    writeat(8, 10, "they labor in vain who build it.\" - Psalm 127:1", 112)
    writeat(11, 2, "Type a word and press Enter: hello, time, memory, eastern, utc, guest, clear", 7)
}

// Writes one answer in the answer region at 'row', scrolling
// the region when it is full, and gives back the next row.
make printline(row, text) {
    let r = row
    if r > 22 {
        scrollanswers()
        r = 22
    }
    writeat(r, 2, text, 7)
    give r + 1
}

// ---- what the loader brought (Stones 4 and 5) ----
//
// This system ships as one disc and nothing else: no disk
// is attached, ever. Everything the system needs beyond its
// own image rides the disc as modules the bootloader loads
// alongside it, reported in the boot information the
// machine is handed at startup — the word the boot stub
// keeps at __mb_info. In that information, the third bit of
// the first word says whether a module table is there; the
// count of modules stands at offset 20 and the table's
// address at offset 24; each entry is sixteen bytes: where
// a module begins, where it ends, the name it was given,
// and a spare word.
//
// Three modules ride the Cardnull disc:
//   the settings (512 bytes): the letters C and N, then one
//     byte holding the clock's hour offset with 64 added
//     (so -5 is kept as 59 and 0 as 64; a byte of 0 means
//     the disc carries no choice, and the clock starts on
//     Eastern time — the lesson the first Cardnull OS
//     taught on real hardware: a clock that quietly shows
//     the world's standard hour as if it were local is
//     simply wrong, so this system starts from its people's
//     time and says so).
//   the guest's card (32 bytes): the letters C, N, C, G,
//     then the guest image's length and its FNV-1a checksum,
//     each as an eight-byte number.
//   the guest image itself: the welcome guest, built for
//     the doorstep (Stone 5).
//
// One discipline governs all of it: the loader leaves its
// table and the modules in low memory that this system's
// own heap also grows into from below (measured on the
// bench: the table was found overwritten by the system's
// own early allocations when it was read late). So the
// system's first act — in the main body below, before the
// face is drawn — is to lift everything it needs out of
// the modules into its own keeping: first the table's
// addresses into plain numbers, while nothing is yet
// allocated; then the modules' bytes into blocks of its
// own. After that first breath the loader's table is never
// touched again. Kernels have always done this with what
// their loaders bring; here it is simply done in the open.

// How many modules the loader brought (0 when it brought
// none, or when the table is not there).
make modcount() {
    give floor() {
        mov esi, dword ptr [__mb_info]
        test esi, esi
        jz mc_zero
        mov eax, dword ptr [rsi]
        test eax, 8
        jz mc_zero
        mov eax, dword ptr [rsi + 20]
        jmp mc_done
    mc_zero:
        xor eax, eax
    mc_done:
    }
}

// Where module 'i' begins, as the loader left it.
make modstart(i) {
    give floor(i) {
        mov rax, [r10]
        mov esi, dword ptr [__mb_info]
        test esi, esi
        jz ms_zero
        mov ecx, dword ptr [rsi]
        test ecx, 8
        jz ms_zero
        mov edx, dword ptr [rsi + 24]
        shl rax, 4
        mov eax, dword ptr [rdx + rax]
        jmp ms_done
    ms_zero:
        xor eax, eax
    ms_done:
    }
}

// Where module 'i' ends (the first byte past it).
make modend(i) {
    give floor(i) {
        mov rax, [r10]
        mov esi, dword ptr [__mb_info]
        test esi, esi
        jz me_zero
        mov ecx, dword ptr [rsi]
        test ecx, 8
        jz me_zero
        mov edx, dword ptr [rsi + 24]
        shl rax, 4
        mov eax, dword ptr [rdx + rax + 4]
        jmp me_done
    me_zero:
        xor eax, eax
    me_done:
    }
}

// Copies bytes out of a module the loader left at 'addr',
// 'len' of them, into the block handed in — never more
// than the block holds — and gives back how many were
// copied.
make modcopyfrom(addr, len, block) {
    give floor(block, addr, len) {
        mov rax, [r10 + 8]
        cmp rax, r12
        cmova rax, r12
        mov rsi, [r10]
        mov rdi, rbx
        mov rcx, rax
        rep movsb
    }
}

// ---- the guest door (Stone 5) ----
//
// A guest is a second program, written in Nifla like this
// one and built for the doorstep — the half megabyte at
// 2097152 (2 MiB) that guests are linked for. It rides the
// disc as a module, with its card riding as a module of its
// own (see the section above); at boot the system lifts
// both into its own keeping. When the word 'guest' is
// typed, the system reckons the lifted image's checksum
// with its own hand, and only if it matches the card does
// it lay the image at the doorstep and call it — handing
// it the number 7 across the desk. The guest draws its
// panel, returns, and the system carries on.
//
// A guest whose bytes do not match its card is refused, in
// plain words, and never run. A disc whose modules hold no
// card, or a card whose image never arrived whole, holds
// no guest to visit. And the honesty of the door, unchanged
// from the language's Stone 17: there is no isolation yet —
// host and guest share one privilege level and one memory,
// the checksum proves the bytes match the card and nothing
// more (it is not a signature), and a faulting guest stops
// the whole machine.

// Reads one eight-byte number out of a block, at a byte
// offset — the card's fields are numbers laid side by side.
make cardnum(card, offset) {
    give floor(card, offset) {
        mov rax, [r10]
        mov rax, [rbx + rax]
    }
}

// The FNV-1a checksum (the 64-bit form) of the first
// 'count' bytes of a block: begin at the offset basis,
// then for each byte — xor the byte in, multiply by the
// FNV prime.
make fnv1a(block, count) {
    give floor(block, count) {
        mov rax, 0xcbf29ce484222325
        mov r8, [r10]
        mov rcx, 0
    fnv_loop:
        cmp rcx, r8
        jae fnv_done
        movzx rdx, byte ptr [rbx + rcx]
        xor rax, rdx
        mov rdx, 0x100000001b3
        imul rax, rdx
        inc rcx
        jmp fnv_loop
    fnv_done:
    }
}

// Lays the guest at the doorstep: the region is wiped
// clean first (a guest's scratch memory must start at
// zero, as a booted program's does), then the image is
// copied to its first bytes.
make placeguest(img, count) {
    floor(img, count) {
        mov rdi, 0x200000
        mov rcx, 0x80000
        xor eax, eax
        rep stosb
        mov rsi, rbx
        mov rdi, 0x200000
        mov rcx, [r10]
        rep movsb
    }
}

// Tries to receive the guest, from what was lifted at
// boot: the image block, how many bytes of it were truly
// lifted ('got'), how long its card says it is ('imglen'),
// and the checksum its card promises ('want'). Gives back
// a number saying how it went: 1 — there is no guest on
// this disc; 2 — the guest on this disc is not whole, and
// was refused; 3 — the guest visited and went home again.
make runguest(img, got, imglen, want) {
    if imglen <= 0 {
        give 1
    }
    if imglen > 524288 {
        give 1
    }
    if got != imglen {
        give 2
    }
    if fnv1a(img, imglen) != want {
        give 2
    }
    placeguest(img, imglen)
    let back = callguest(2097152, 7)
    give 3
}

// ---- the machine ----

// The first breath: lift what the loader brought into the
// system's own keeping, before anything else is allocated
// (the discipline of the section above). First the module
// table's addresses, into plain numbers — the disc carries
// three modules; up to four are read.
let nmods = modcount()
let s0 = 0
let l0 = 0
let s1 = 0
let l1 = 0
let s2 = 0
let l2 = 0
let s3 = 0
let l3 = 0
if nmods > 0 {
    s0 = modstart(0)
    l0 = modend(0) - s0
}
if nmods > 1 {
    s1 = modstart(1)
    l1 = modend(1) - s1
}
if nmods > 2 {
    s2 = modstart(2)
    l2 = modend(2) - s2
}
if nmods > 3 {
    s3 = modstart(3)
    l3 = modend(3) - s3
}

// What the lift gathers: the clock's offset (Eastern, -5,
// unless the disc's settings carry a choice), and the
// guest — its card's word (how long the image is, and the
// checksum it must match) and the image itself, once found.
let offset = 0 - 5
let guestimg = makebytes(0)
let guestgot = 0
let guestimglen = 0
let guestwant = 0

let mi = 0
while mi < nmods {
    let s = 0
    let l = 0
    if mi == 0 { s = s0  l = l0 }
    if mi == 1 { s = s1  l = l1 }
    if mi == 2 { s = s2  l = l2 }
    if mi == 3 { s = s3  l = l3 }
    if l == 512 {
        let blk = makebytes(512)
        let c = modcopyfrom(s, l, blk)
        if blk[0] == 67 {
            if blk[1] == 78 {
                if blk[2] != 0 {
                    offset = blk[2] - 64
                }
            }
        }
    }
    if l == 32 {
        let blk = makebytes(32)
        let c = modcopyfrom(s, l, blk)
        if blk[0] == 67 {
            if blk[1] == 78 {
                if blk[2] == 67 {
                    if blk[3] == 71 {
                        guestimglen = cardnum(blk, 8)
                        guestwant = cardnum(blk, 16)
                    }
                }
            }
        }
    }
    mi = mi + 1
}

// The guest image itself, found by the length its card
// promises. (The layout's one assumption, stated plainly:
// a guest image is never as small as the 512-byte settings
// or the 32-byte card, so a module of exactly the promised
// length can only be the image.)
if guestimglen > 0 {
    if guestimglen <= 524288 {
        let mi2 = 0
        while mi2 < nmods {
            let s = 0
            let l = 0
            if mi2 == 0 { s = s0  l = l0 }
            if mi2 == 1 { s = s1  l = l1 }
            if mi2 == 2 { s = s2  l = l2 }
            if mi2 == 3 { s = s3  l = l3 }
            if l == guestimglen {
                let blk = makebytes(l)
                guestgot = modcopyfrom(s, l, blk)
                guestimg = blk
            }
            mi2 = mi2 + 1
        }
    }
}

drawface(offset)

let keys = makebytes(48)
let klen = 0
let ansrow = 13
let lastsec = 0 - 1
drawtyping("")

while true {
    let nowsec = ticks() / 100
    if nowsec != lastsec {
        lastsec = nowsec
        writeat(0, 72, clocktext(nowsec, offset), 31)
    }
    let k = readkey()
    if k != 0 {
        if k < 128 {
            if k == 28 {
                // Enter: the word is finished; answer it.
                let cmd = buildline(keys, klen)
                klen = 0
                drawtyping("")
                if cmd == "clear" {
                    drawface(offset)
                    ansrow = 13
                    lastsec = 0 - 1
                } else {
                    let answered = 0
                    if cmd == "hello" {
                        ansrow = printline(ansrow, "Hello. It is good to see you.")
                        answered = 1
                    }
                    if cmd == "time" {
                        ansrow = printline(ansrow, "This machine has been awake for " + (ticks() / 100) + " seconds.")
                        answered = 1
                    }
                    if cmd == "memory" {
                        ansrow = printline(ansrow, "This machine has " + memorysize() + " bytes of memory (" + (memorysize() / 1048576) + " megabytes).")
                        answered = 1
                    }
                    if cmd == "eastern" {
                        offset = 0 - 5
                        ansrow = printline(ansrow, "The clock now shows Eastern time until the machine is turned off.")
                        lastsec = 0 - 1
                        answered = 1
                    }
                    if cmd == "utc" {
                        offset = 0
                        ansrow = printline(ansrow, "The clock now shows the world's standard time until turned off.")
                        lastsec = 0 - 1
                        answered = 1
                    }
                    if cmd == "guest" {
                        let how = runguest(guestimg, guestgot, guestimglen, guestwant)
                        if how == 1 {
                            ansrow = printline(ansrow, "There is no guest on this disc to visit.")
                        }
                        if how == 2 {
                            ansrow = printline(ansrow, "The guest on this disc is not whole, so it was not let in.")
                        }
                        if how == 3 {
                            writeat(21, 2, "The guest visited, and has gone home again.", 7)
                        }
                        answered = 1
                    }
                    if answered == 0 {
                        if length(cmd) > 0 {
                            ansrow = printline(ansrow, "I don't know that word yet. Try hello, time, memory, guest, or clear.")
                        }
                    }
                }
            } else {
                if k == 14 {
                    // Backspace: forget the last key.
                    if klen > 0 {
                        klen = klen - 1
                    }
                    drawtyping(buildline(keys, klen))
                } else {
                    let ch = charFor(k)
                    if length(ch) > 0 {
                        if klen < 48 {
                            keys[klen] = k
                            klen = klen + 1
                        }
                        drawtyping(buildline(keys, klen))
                    }
                }
            }
        }
    }
    waittick()
}
