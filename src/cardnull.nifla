                                                                                    xcj = xcj + 1
                                                                                }
                                                                                if diskset == 1 {
                                                                                    if knotesave(xdesk, keepusb, notesblock, notecount) == 1 {
                                                                                        pset(pixdesk, 492, 2)
                                                                                    } else {
                                                                                        pset(pixdesk, 492, 11)
                                                                                    }
                                                                                } else {
                                                                                    pset(pixdesk, 492, 2)
                                                                                }
