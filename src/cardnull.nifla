                                        }
                                    }
                                    // The paint window joins
                                    // the same reckoning (Stone
                                    // 24): when it alone stands
                                    // open, it comes forward in
                                    // the closed window's place.
                                    if pget(pixdesk, 180) == 0 {
                                        if pget(pixdesk, 272) == 1 {
                                            pset(pixdesk, 180, 6)
                                            paintwindows(pixdesk, cellblock, notesblock)
                                        }
                                    }
                                    // The verse window joins
                                    // the same reckoning (Stone
                                    // 29): when it alone stands
                                    // open, it comes forward in
                                    // the closed window's place.
                                    if pget(pixdesk, 180) == 0 {
                                        if pget(pixdesk, 324) == 1 {
                                            pset(pixdesk, 180, 7)
                                            paintwindows(pixdesk, cellblock, notesblock)
                                        }
                                    }
                                    // The calculator window
                                    // joins the same reckoning
                                    // (Stone 30): when it alone
                                    // stands open, it comes
                                    // forward in the closed
                                    // window's place.
                                    if pget(pixdesk, 180) == 0 {
                                        if pget(pixdesk, 340) == 1 {
                                            pset(pixdesk, 180, 8)
                                            paintwindows(pixdesk, cellblock, notesblock)
                                        }
                                    }
                                    // The help window joins
                                    // the same reckoning
                                    // (Stone 31): when it alone
                                    // stands open, it comes
                                    // forward in the closed
                                    // window's place.
                                    if pget(pixdesk, 180) == 0 {
                                        if pget(pixdesk, 360) == 1 {
                                            pset(pixdesk, 180, 9)
                                            paintwindows(pixdesk, cellblock, notesblock)
                                        }
                                    }
                                    // The Bible window joins
                                    // the same reckoning
                                    // (Stone 41): when it alone
                                    // stands open, it comes
                                    // forward in the closed
                                    // window's place.
                                    if pget(pixdesk, 180) == 0 {
                                        if pget(pixdesk, 424) == 1 {
                                            pset(pixdesk, 180, 11)
                                            paintwindows(pixdesk, cellblock, notesblock)
                                        }
                                    }
                                    // The Shield window joins
                                    // the same reckoning
                                    // (Stone 42): when it alone
                                    // stands open, it comes
                                    // forward in the closed
                                    // window's place.
                                    if pget(pixdesk, 180) == 0 {
                                        if pget(pixdesk, 444) == 1 {
                                            pset(pixdesk, 180, 12)
                                            paintwindows(pixdesk, cellblock, notesblock)
                                        }
                                    }
                                    // The picture window joins
                                    // the same reckoning
                                    // (Stone 48): when it alone
                                    // stands open, it comes
                                    // forward in the closed
                                    // window's place.
                                    if pget(pixdesk, 180) == 0 {
                                        if pget(pixdesk, 476) == 1 {
                                            pset(pixdesk, 180, 13)
                                            paintwindows(pixdesk, cellblock, notesblock)
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // A press on the help
                                    // window's foot (Stone 31)
                                    // turns its page: the foot
                                    // stands on the window's
                                    // row hy + 14, its turning
                                    // word — More, or First
                                    // page on the last page —
                                    // at its right; a press
                                    // anywhere on that row does
                                    // the turning the word
                                    // names, the down arrow's
                                    // own turning, and the
                                    // window comes forward.
                                    if pget(pixdesk, 360) == 1 {
                                        if cxp >= hx * cellpx {
                                            if cxp < (hx + hw) * cellpx {
                                                if cyp / cellpx == hy + 14 {
                                                    let hp2 = pget(pixdesk, 364) + 1
                                                    if hp2 >= helppages() {
                                                        hp2 = 0
                                                    }
                                                    pset(pixdesk, 364, hp2)
                                                    pset(pixdesk, 180, 9)
                                                    paintwindows(pixdesk, cellblock, notesblock)
                                                    acted = 1
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // A press in the Bible
                                    // window (Stone 41): on
                                    // the contents page, a
                                    // press on the foot's row
                                    // reads the picked
                                    // chapter, as Enter does.
                                    // On a
                                    // reading page, a press
                                    // on the foot's row does
                                    // what its words name:
                                    // its left word's ground
                                    // (the foot's first six
                                    // cells) turns back a
                                    // page, and the rest of
                                    // the row turns forward —
                                    // More, and First page on
                                    // the last page, which
                                    // returns to the contents
                                    // page — the arrow keys'
                                    // own turnings. Any such
                                    // press brings the window
                                    // forward, as a press on
                                    // a window does.
                                    if pget(pixdesk, 424) == 1 {
                                        if cxp >= jx * cellpx {
                                            if cxp < (jx + jw) * cellpx {
                                                let prow = cyp / cellpx
                                                if pget(pixdesk, 428) == 0 {
                                                    if prow == jy + 14 {
                                                            pset(pixdesk, 428, bibchapterpage(pget(pixdesk, 440), bibwidth(pixdesk)))
                                                            pset(pixdesk, 180, 11)
                                                            paintwindows(pixdesk, cellblock, notesblock)
                                                            acted = 1
                                                        }
                                                } else {
                                                    if prow == jy + 14 {
                                                        let bpg = pget(pixdesk, 428)
                                                        if cxp / cellpx < jx + 8 {
                                                            pset(pixdesk, 428, bpg - 1)
                                                        } else {
                                                            let nb = bpg + 1
                                                            if nb >= bibpages(bibwidth(pixdesk)) {
                                                                nb = 0
                                                            }
                                                            pset(pixdesk, 428, nb)
                                                        }
                                                        pset(pixdesk, 180, 11)
                                                        paintwindows(pixdesk, cellblock, notesblock)
                                                        acted = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // The files window's asking
                                    // rows (Stone 27): while its
                                    // asking stands and the
                                    // window stands forward, a
                                    // press on "Yes, let it
                                    // go"'s row lets the picked
                                    // note go through the
                                    // store's own path, and a
                                    // press on "Keep it"'s row
                                    // puts the asking away and
                                    // leaves the note exactly
                                    // as it was. While the
                                    // asking stands, the list
                                    // rows below do not pick.
                                    if pget(pixdesk, 188) == 1 {
                                        if pget(pixdesk, 300) == 1 {
                                            if pget(pixdesk, 180) == 3 {
                                                if cxp >= fx * cellpx {
                                                    if cxp < (fx + fw) * cellpx {
                                                        let arow = cyp / cellpx
                                                        if arow == fy + 6 {
                                                            pset(pixdesk, 300, 0)
                                                            pset(pixdesk, 180, 3)
                                                            paintwindows(pixdesk, cellblock, notesblock)
                                                            acted = 1
                                                        }
                                                        if arow == fy + 5 {
                                                            let pft = pget(pixdesk, 192)
                                                            let pfi = pft
                                                            while pfi < notecount - 1 {
                                                                let pfj = 0
                                                                while pfj < 64 {
                                                                    notesblock[pfi * 64 + pfj] = notesblock[(pfi + 1) * 64 + pfj]
                                                                    pfj = pfj + 1
                                                                }
                                                                pfi = pfi + 1
                                                            }
                                                            let pfz = 0
                                                            while pfz < 64 {
                                                                notesblock[(notecount - 1) * 64 + pfz] = 0
                                                                pfz = pfz + 1
                                                            }
                                                            if diskset == 1 {
                                                                let pfw1 = knotesave(xdesk, keepusb, notesblock, notecount)
                                                            }
                                                            notecount = notecount - 1
                                                            let pfwrote = 0
                                                            if diskset == 1 {
                                                                if knotesave(xdesk, keepusb, notesblock, notecount) == 1 {
                                                                    pfwrote = 1
                                                                }
                                                            }
                                                            pset(pixdesk, 196, notecount)
                                                            let pfsel = pft
                                                            if pfsel >= notecount {
                                                                pfsel = notecount - 1
                                                            }
                                                            if pfsel < 0 {
                                                                pfsel = 0
                                                            }
                                                            pset(pixdesk, 192, pfsel)
                                                            pset(pixdesk, 300, 0)
                                                            pset(pixdesk, 180, 3)
                                                            paintwindows(pixdesk, cellblock, notesblock)
                                                            if diskset == 1 {
                                                                if pfwrote == 1 {
                                                                    ansrow = printline(ansrow, "Your note is let go, and gone from the disk.", pix, pixdesk)
                                                                } else {
                                                                    ansrow = printline(ansrow, "The disk would not take the change, so the note is let go only for now.", pix, pixdesk)
                                                                }
                                                            } else {
                                                                ansrow = printline(ansrow, "Your note is let go.", pix, pixdesk)
                                                            }
                                                            acted = 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // The Cardinal asking's
                                    // rows (Stone 50): while its
                                    // asking stands in the files
                                    // window and the window
                                    // stands forward, a press on
                                    // "Not yet"'s row puts the
                                    // asking away and nothing is
                                    // made, and a press on "Yes,
                                    // make it a Cardinal"'s row
                                    // runs the making — its doing
                                    // stands in the press below,
                                    // in its own telling. While
                                    // the asking stands, the
                                    // window's other rows do not
                                    // act: the guards on them
                                    // reckon this asking too.
                                    if pget(pixdesk, 188) == 1 {
                                        if pget(pixdesk, 496) == 1 {
                                            if pget(pixdesk, 180) == 3 {
                                                if cxp >= fx * cellpx {
                                                    if cxp < (fx + fw) * cellpx {
                                                        let arow = cyp / cellpx
                                                        if arow == fy + 8 {
                                                            pset(pixdesk, 496, 0)
                                                            pset(pixdesk, 180, 3)
                                                            paintwindows(pixdesk, cellblock, notesblock)
                                                            acted = 1
                                                        }
                                                        if arow == fy + 7 {
                                                            // The making
                                                            // itself (Stone
                                                            // 50): the
                                                            // refusals are
                                                            // reckoned first,
                                                            // in plain words,
                                                            // and nothing is
                                                            // written by any
                                                            // of them — no
                                                            // fitted hard
                                                            // disk; a disk
                                                            // that already
                                                            // carries a
                                                            // Cardinal
                                                            // (diskcardinal,
                                                            // Stone 40's
                                                            // discipline: a
                                                            // second system
                                                            // is never laid
                                                            // over the
                                                            // first); no
                                                            // stick standing;
                                                            // a stick that
                                                            // does not carry
                                                            // the system
                                                            // (ustickimage
                                                            // reads its
                                                            // record and its
                                                            // volume mark and
                                                            // gives nothing);
                                                            // a disk too
                                                            // small for the
                                                            // image and the
                                                            // keeping before
                                                            // it. Behind the
                                                            // yes the window
                                                            // first says it
                                                            // is making (the
                                                            // word 7) and is
                                                            // repainted, for
                                                            // the copy is
                                                            // long and the
                                                            // desktop stands
                                                            // still for it;
                                                            // the image is
                                                            // copied sector
                                                            // by sector to
                                                            // the disk's
                                                            // sector 2048,
                                                            // proved at three
                                                            // of its places
                                                            // against the
                                                            // stick, and only
                                                            // then is the
                                                            // disk's boot
                                                            // record laid and
                                                            // read back whole
                                                            // — a copy that
                                                            // stops short or
                                                            // does not prove
                                                            // earns the plain
                                                            // word that it
                                                            // did not finish,
                                                            // and no record
                                                            // is laid for it,
                                                            // so the disk is
                                                            // left exactly as
                                                            // bootable, or as
                                                            // unbootable, as
                                                            // it stood. A
                                                            // disk that
                                                            // carried no card
                                                            // yet is carded
                                                            // from the
                                                            // sitting's own
                                                            // standings, its
                                                            // notes and
                                                            // picture written
                                                            // through by the
                                                            // disk's own
                                                            // store paths, so
                                                            // the disk alone
                                                            // will rise with
                                                            // the same
                                                            // keeping; a disk
                                                            // that already
                                                            // kept is not
                                                            // written in its
                                                            // keeping at all.
                                                            let cnword = 0
                                                            if diskhere() == 0 {
                                                                cnword = 2
                                                            } else {
                                                                if diskcardinal(2048) == 1 {
                                                                    cnword = 4
                                                                } else {
                                                                    if usectors(xdesk) == 0 {
                                                                        cnword = 3
                                                                    } else {
                                                                        let cnimg = ustickimage(xdesk)
                                                                        if cnimg == 0 {
                                                                            cnword = 8
                                                                        } else {
                                                                            selectdrive()
                                                                            if disksectors() < 2048 + cnimg {
                                                                                cnword = 5
                                                                            } else {
                                                                                pset(pixdesk, 496, 0)
                                                                                pset(pixdesk, 504, 7)
                                                                                pset(pixdesk, 180, 3)
                                                                                paintwindows(pixdesk, cellblock, notesblock)
                                                                                let cncopy = ucopyimage(xdesk, 2048, cnimg, copyblock)
                                                                                if cncopy < cnimg {
                                                                                    cnword = 6
                                                                                } else {
                                                                                    if ucopyproof(xdesk, 2048, cnimg, copyblock) == 0 {
                                                                                        cnword = 6
                                                                                    } else {
                                                                                        if ulayrecord(xdesk, 2048, copyblock) == 0 {
                                                                                            cnword = 6
                                                                                        } else {
                                                                                            if diskset == 0 {
                                                                                                let cnchime = 2
                                                                                                if chimeon == 1 {
                                                                                                    cnchime = 1
                                                                                                }
                                                                                                let cncard = rememberall(offset, cnchime, wordsize + 1)
                                                                                                let cnnotes = notesave(notesblock, notecount)
                                                                                                let cnpic = picsave(picblock, pichas, picsel, notesblock)
                                                                                                diskset = 1
                                                                                                awaiting = 0
                                                                                                pset(pixdesk, 200, 1)
                                                                                            }
                                                                                            cnword = 1
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            pset(pixdesk, 504, cnword)
                                                            pset(pixdesk, 496, 0)
                                                            pset(pixdesk, 180, 3)
                                                            paintwindows(pixdesk, cellblock, notesblock)
                                                            acted = 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // The editor window's asking
                                    // rows (Stone 27): the same
                                    // two rows in the editor
                                    // window, while its asking
                                    // stands and it stands
                                    // forward — the yes lets the
                                    // note the asking names go
                                    // through the store's own
                                    // path and the window
                                    // returns to its picking
                                    // way; the keep leaves the
                                    // note, and any standing
                                    // draft, exactly as it was.
                                    if pget(pixdesk, 220) == 1 {
                                        if pget(pixdesk, 308) == 1 {
                                            if pget(pixdesk, 180) == 5 {
                                                if cxp >= ex * cellpx {
                                                    if cxp < (ex + ew) * cellpx {
                                                        let arow = cyp / cellpx
                                                        if arow == ey + 6 {
                                                            pset(pixdesk, 308, 0)
                                                            pset(pixdesk, 180, 5)
                                                            paintwindows(pixdesk, cellblock, notesblock)
                                                            acted = 1
                                                        }
                                                        if arow == ey + 5 {
                                                            let pet = pget(pixdesk, 316)
                                                            let pei = pet
                                                            while pei < notecount - 1 {
                                                                let pej = 0
                                                                while pej < 64 {
                                                                    notesblock[pei * 64 + pej] = notesblock[(pei + 1) * 64 + pej]
                                                                    pej = pej + 1
                                                                }
                                                                pei = pei + 1
                                                            }
                                                            let pez = 0
                                                            while pez < 64 {
                                                                notesblock[(notecount - 1) * 64 + pez] = 0
                                                                pez = pez + 1
                                                            }
                                                            if diskset == 1 {
                                                                let pew1 = knotesave(xdesk, keepusb, notesblock, notecount)
                                                            }
                                                            notecount = notecount - 1
                                                            let pewrote = 0
                                                            if diskset == 1 {
                                                                if knotesave(xdesk, keepusb, notesblock, notecount) == 1 {
                                                                    pewrote = 1
                                                                }
                                                            }
                                                            pset(pixdesk, 196, notecount)
                                                            notesblock[512] = 0
                                                            pset(pixdesk, 224, 0)
                                                            let pepick = pet + 1
                                                            if pepick > notecount {
                                                                pepick = notecount
                                                            }
                                                            pset(pixdesk, 228, pepick)
                                                            pset(pixdesk, 308, 0)
                                                            pset(pixdesk, 180, 5)
                                                            paintwindows(pixdesk, cellblock, notesblock)
                                                            if diskset == 1 {
                                                                if pewrote == 1 {
                                                                    ansrow = printline(ansrow, "Your note is let go, and gone from the disk.", pix, pixdesk)
                                                                } else {
                                                                    ansrow = printline(ansrow, "The disk would not take the change, so the note is let go only for now.", pix, pixdesk)
                                                                }
                                                            } else {
                                                                ansrow = printline(ansrow, "Your note is let go.", pix, pixdesk)
                                                            }
                                                            acted = 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // A press on one of the
                                    // files window's list rows
                                    // picks that note (Stone
                                    // 19): its whole words
                                    // stand at the window's
                                    // foot, and the window
                                    // comes forward.
                                    if pget(pixdesk, 188) == 1 {
                                        if pget(pixdesk, 300) + pget(pixdesk, 376) + pget(pixdesk, 496) == 0 {
                                            if pget(pixdesk, 196) > 0 {
                                                if cxp >= fx * cellpx {
                                                    if cxp < (fx + fw) * cellpx {
                                                        let row = cyp / cellpx
                                                        if row >= fy + 3 {
                                                            if row < fy + 3 + pget(pixdesk, 196) {
                                                                pset(pixdesk, 192, row - fy - 3)
                                                                pset(pixdesk, 492, 0)
                                                                pset(pixdesk, 504, 0)
                                                                pset(pixdesk, 180, 3)
                                                                paintwindows(pixdesk, cellblock, notesblock)
                                                                acted = 1
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // A press on the kept
                                    // picture's row in the
                                    // files window (Stone 26)
                                    // opens the picture in
                                    // the paint window: the
                                    // row stands at the
                                    // window's last row (its
                                    // painter's own reckoning,
                                    // fy + 13), the picture
                                    // stands picked, the paint
                                    // window opens forward,
                                    // and the feather's
                                    // opening visit is asked
                                    // for — the receiving
                                    // below lays the kept
                                    // picture back into its
                                    // cells, as the word
                                    // 'paint' opening does.
                                    if pget(pixdesk, 188) == 1 {
                                        if pget(pixdesk, 200) == 1 {
                                            if pget(pixdesk, 300) + pget(pixdesk, 376) + pget(pixdesk, 496) == 0 {
                                                if pichas == 1 {
                                                if cxp >= fx * cellpx {
                                                    if cxp < (fx + fw) * cellpx {
                                                        if cyp / cellpx == fy + 13 {
                                                            pset(pixdesk, 192, notecount)
                                                            pset(pixdesk, 492, 0)
                                                            pset(pixdesk, 504, 0)
                                                            pset(pixdesk, 272, 1)
                                                            pset(pixdesk, 180, 6)
                                                            paintask = 1
                                                            paintwindows(pixdesk, cellblock, notesblock)
                                                            acted = 1
                                                        }
                                                    }
                                                }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // A press on "Let this note
                                    // go" at the files window's
                                    // foot (Stone 27): the words
                                    // stand at the foot's right
                                    // while a note stands picked
                                    // and the window stands
                                    // forward; the press opens
                                    // the asking — nothing is
                                    // let go by this press.
                                    if pget(pixdesk, 188) == 1 {
                                        if pget(pixdesk, 300) + pget(pixdesk, 376) + pget(pixdesk, 496) == 0 {
                                            if pget(pixdesk, 180) == 3 {
                                                if pget(pixdesk, 192) < notecount {
                                                    if cyp / cellpx == fy + 11 {
                                                        if cxp >= (fx + 36) * cellpx {
                                                            if cxp < (fx + 52) * cellpx {
                                                                pset(pixdesk, 304, 1)
                                                                pset(pixdesk, 300, 1)
                                                                pset(pixdesk, 180, 3)
                                                                paintwindows(pixdesk, cellblock, notesblock)
                                                                acted = 1
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // A press on "Rename" at
                                    // the files window's foot
                                    // (Stone 40): the word
                                    // stands left of "Copy"
                                    // while a note stands
                                    // picked and the window
                                    // stands forward; the press
                                    // opens the naming way on
                                    // that note — the name
                                    // being typed starts empty
                                    // and the window is
                                    // repainted by the region
                                    // road over the files
                                    // window alone. Nothing is
                                    // renamed by this press.
                                    if pget(pixdesk, 188) == 1 {
                                        if pget(pixdesk, 300) + pget(pixdesk, 376) + pget(pixdesk, 496) == 0 {
                                            if pget(pixdesk, 180) == 3 {
                                                if pget(pixdesk, 192) < notecount {
                                                    if cyp / cellpx == fy + 11 {
                                                        if cxp >= (fx + 24) * cellpx {
                                                            if cxp < (fx + 30) * cellpx {
                                                                notesblock[576] = 0
                                                                pset(pixdesk, 380, 0)
                                                                pset(pixdesk, 376, 1)
                                                                pset(pixdesk, 180, 3)
                                                                layroadwins(pixdesk, 3, 0)
                                                                paintregion(pixdesk, cellblock, notesblock)
                                                                acted = 1
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // A press on "Copy" at the
                                    // files window's foot
                                    // (Stone 40): the word
                                    // stands between "Rename"
                                    // and the letting-go words
                                    // while a note stands
                                    // picked; the press opens
                                    // the naming way for a copy
                                    // of that note, the same
                                    // opening. When the notes
                                    // page already stands
                                    // full, no naming opens:
                                    // the press is answered in
                                    // plain words, as the
                                    // editor answers it.
                                    if pget(pixdesk, 188) == 1 {
                                        if pget(pixdesk, 300) + pget(pixdesk, 376) + pget(pixdesk, 496) == 0 {
                                            if pget(pixdesk, 180) == 3 {
                                                if pget(pixdesk, 192) < notecount {
                                                    if cyp / cellpx == fy + 11 {
                                                        if cxp >= (fx + 31) * cellpx {
                                                            if cxp < (fx + 35) * cellpx {
                                                                if notecount >= 8 {
                                                                    ansrow = printline(ansrow, "The notes page is full. Eight notes are kept there.", pix, pixdesk)
                                                                } else {
                                                                    notesblock[576] = 0
                                                                    pset(pixdesk, 380, 0)
                                                                    pset(pixdesk, 376, 2)
                                                                    pset(pixdesk, 180, 3)
                                                                    layroadwins(pixdesk, 3, 0)
                                                                    paintregion(pixdesk, cellblock, notesblock)
                                                                }
                                                                acted = 1
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if acted == 0 {
                                    // A press on "Rename" at
                                    // the files window's foot
