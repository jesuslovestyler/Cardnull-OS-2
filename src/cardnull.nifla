                                    // stick by the name it
                                    // stands under here — its
                                    // given name, or its words
                                    // (slotstandsmatch, Stone
                                    // 40's reckoning of a name
                                    // that stands) — and the
                                    // stick's slot entire takes
                                    // the picked note's place:
                                    // the one keeping of that
                                    // name is refreshed from
                                    // its twin, never a second
                                    // keeping laid beside it,
                                    // so nothing is silently
                                    // overwritten and no name
                                    // ever stands twice. The
                                    // picture is known by its
                                    // one place: the stick's
                                    // kept picture, read whole
                                    // into the exchange's
                                    // scratch first, takes the
                                    // kept picture's place,
                                    // with its name. Where the
                                    // stick holds no thing of
                                    // that name, or no picture,
                                    // the press is refused in
                                    // plain words in the window
                                    // and the keeping stands
                                    // untouched; the stick
                                    // itself is never written
                                    // by this press. What is
                                    // brought in is written
                                    // through to the keeping
                                    // disk by the same store
                                    // paths as every keeping
                                    // (knotesave, and picsave
                                    // by hand — the keeping
                                    // here is the hard disk,
                                    // the stick-as-keeping
                                    // standing refused above),
                                    // and only behind the
                                    // disk's own standing, as
                                    // the naming way writes.
                                    // The window is repainted
                                    // by the region road over
                                    // itself — and over the
                                    // picture window with it
                                    // when a picture was
                                    // brought in, its cells
                                    // being the same keeping.
                                    if pget(pixdesk, 188) == 1 {
                                        if pget(pixdesk, 300) + pget(pixdesk, 376) + pget(pixdesk, 496) == 0 {
                                            if pget(pixdesk, 180) == 3 {
                                                if pget(pixdesk, 492) == 0 {
                                                    if cyp / cellpx == fy + 14 {
                                                        if cxp >= (fx + 16) * cellpx {
                                                            if cxp < (fx + 30) * cellpx {
                                                                let xsel = pget(pixdesk, 192)
                                                                let xdone = 0
                                                                let xpicin = 0
                                                                if xsel < notecount {
                                                                    if keepusb == 1 {
                                                                        pset(pixdesk, 492, 9)
                                                                    } else {
                                                                        if usectors(xdesk) == 0 {
                                                                            pset(pixdesk, 492, 3)
                                                                        } else {
