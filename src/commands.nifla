// Cardnull OS 2's command library — deciding what a typed
// word is answered with.
//
// Like the screen library, this file joins the system as a
// prelude when it is built (build.sh names it); a prelude
// may only make functions, and these keep no state of their
// own: the word comes in as an argument, and the decision
// goes back as a result. The doing itself — printing the
// line in the answer region, drawing the face again,
// receiving the guest, keeping the clock's new offset — is
// the main body's work, in src/cardnull.nifla, which asks
// these three questions of every finished word:
//
//   wordkind   — what kind of answer the word gets
//   wordline   — the line of words that answers it
//   wordoffset — the clock's offset once the word is done

// What kind of answer a word gets:
//   0 — no answer at all (the word is empty)
//   1 — a line of words answers it (see wordline below)
//   2 — the face is cleared and drawn again ('clear')
//   3 — a guest is to be received through the guest door
//       ('guest'; the door itself is guestdoor.nifla)
//   4 — the USB keyboard's standing is reported ('usb';
//       the road itself is usbkey.nifla, and the report is
//       the main body's to give, from the road's ledger)
//   5 — the world's time is told in words ('time'; the
//       telling is the main body's, from the true clock's
//       reading it keeps — rtclock.nifla, Stone 7)
//   6 — a hard disk is offered its keeping ('setup'; the
//       offering and its gate are the main body's, with
//       diskkeep.nifla — Stone 8)
//   7 — a time-choice word ('eastern', 'utc'): the choice
//       moves (see wordoffset), and the main body answers
//       it, because the true answer depends on whether a
//       disk is keeping the choices (Stone 8)
make wordkind(word) {
    if word == "" {
        give 0
    }
    if word == "clear" {
        give 2
    }
    if word == "guest" {
        give 3
    }
    if word == "usb" {
        give 4
    }
    if word == "time" {
        give 5
    }
    if word == "setup" {
        give 6
    }
    if word == "eastern" {
        give 7
    }
    if word == "utc" {
        give 7
    }
    give 1
}

// The line that answers a word of kind 1: the greeting, the
// reports, the time choices' own say-so, and the kind word
// for a word the machine does not know yet. The 'memory'
// line is reckoned as it is asked for, from the machine's
// own memory figure. ('time' is not answered here — it is
// kind 5, told by the main body from the true clock.)
make wordline(word) {
    if word == "hello" {
        give "Hello. It is good to see you."
    }
    if word == "memory" {
        give "This machine has " + memorysize() + " bytes of memory (" + (memorysize() / 1048576) + " megabytes)."
    }
    if word == "eastern" {
        give "The clock now shows Eastern time until the machine is turned off."
    }
    if word == "utc" {
        give "The clock now shows the world's standard time until turned off."
    }
    give "I don't know that word yet. Try hello, time, memory, guest, usb, setup, or clear."
}

// The clock's hour offset once a word is done: 'eastern'
// and 'utc' set it (the time choice, Stone 4), and every
// other word leaves it exactly as it was.
make wordoffset(word, offset) {
    if word == "eastern" {
        give 0 - 5
    }
    if word == "utc" {
        give 0
    }
    give offset
}
