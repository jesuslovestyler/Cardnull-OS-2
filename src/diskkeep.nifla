// Cardnull OS 2's disk-keeping library — what the system
// remembers on a hard disk, when one is fitted and given
// over to it (Stone 8).
//
// Like the other libraries, this file joins the system as
// a prelude when it is built (build.sh names it); a prelude
// may only make functions, and these keep no state of their
// own: what is remembered, and whether a disk stands ready,
// are the main body's to keep. The disk work itself — the
// language's own disk tools, and one small piece of floor
// work to wake the drive — lives here.
//
// What is kept: the clock's time choice, and — since
// Stone 20 — whether the welcome chime sounds, on sector
// 8 of the disk, in a small card of the system's own: the
// letters C and N, then one byte holding the offset with
// 64 added (so -5 is kept as 59 and 0 as 64; a stored byte
// of 0 can only mean nothing was ever saved), then one
// byte for the chime: 1 when it stands on, 2 when it
// stands off, and 0 when no choice was ever kept there —
// a card laid before Stone 20, whose chime byte stands 0,
// keeps the chime on, as it always sounded. The card's
// shape is the one the first disk keeping was proven
// with, earlier on the founding day, grown by that one
// byte at its end; nothing already kept moves.
//
// The notes page (Stone 15) is kept further out, beyond
// the card and beyond the setup clearing's reach: a
// header on sector 64 — the letters C, N, N and one byte
// holding how many notes stand kept — and one sector to
// a note, sectors 65 onward, eight notes at most. A
// note's sector holds the note as the main body keeps it
// in its block: the length at the first byte, the letters
// after it, in a sixty-four-byte slot at the sector's
// start. The setup clearing (sectors 0 to 63) never
// touches the page, and the gate's discipline is
// unchanged: nothing here is written before the gate's
// yes, and a disk not yet given over is never written at
// all — the main body asks for a saving only when the
// disk already stands as the system's own.

// Selects the disk drive (the master on the first
// channel), so the drive is awake and answering before the
// system asks who it is. This small piece of floor work is
// needed because of how the language's disksectors() asks:
// it reads the drive's status port before ever selecting
// the drive, and an unselected drive's status reads as
// nothing there — so without this, disksectors() would
// answer 0 even with a disk fitted. Selecting a drive that
// is not there is harmless: the word goes out on the wire
// and nothing answers, and disksectors() still says 0.
make selectdrive() {
    floor() {
        mov edx, 0x1F6
        mov al, 0xE0
        out dx, al
    }
}

// Whether a hard disk is fitted at all: 1 when one answers,
// 0 when the machine holds no disk for the system.
make diskhere() -> number {
    selectdrive()
    if disksectors() > 0 {
        give 1
    }
    give 0
}

// Gives back the stored byte of the card (the offset with
// 64 added), or 0 when there is no card — or no disk — to
// read.
make savedoffset() -> number {
    selectdrive()
    if disksectors() > 0 {
        let block = makebytes(512)
        let n = diskread(8, block)
        if block[0] == 67 {
            if block[1] == 78 {
                give block[2]
            }
        }
    }
    give 0
}

// Gives back the card's chime byte (Stone 20): 1 when
// the chime stands on, 2 when it stands off, and 0 when
// there is no card — or no disk — to read, or the card
// was laid before the chime had a byte of its own (the
// chime then stands on, as it always has).
make savedchime() -> number {
    selectdrive()
    if disksectors() > 0 {
        let block = makebytes(512)
        let n = diskread(8, block)
        if block[0] == 67 {
            if block[1] == 78 {
                give block[3]
            }
        }
    }
    give 0
}

// Writes the card whole: the given offset and the given
// chime byte (1 on, 2 off, 0 never chosen). Gives back 1
// when the choices were truly written to a disk, 0 when
// there is no disk to remember them on.
make rememberall(offset: number, chime: number) -> number {
    selectdrive()
    if disksectors() > 0 {
        let block = makebytes(512)
        block[0] = 67
        block[1] = 78
        block[2] = offset + 64
        block[3] = chime
        let w = diskwrite(8, block)
        give 1
    }
    give 0
}

// Writes the card for the given offset, keeping whatever
// chime choice the card already carries (Stone 20).
// Gives back 1 when the choice was truly written to a
// disk, 0 when there is no disk to remember it on.
make remember(offset: number) -> number {
    give rememberall(offset, savedchime())
}

// Reads the kept notes into the main body's notes block
// (eight sixty-four-byte slots, as notesave lays them):
// the header's count, then that many note sectors, each
// laid into its slot. Gives back how many notes stand
// kept — 0 when there is no disk, or the disk carries no
// notes page yet.
make notesload(block: bytes) -> number {
    selectdrive()
    if disksectors() > 0 {
        let head = makebytes(512)
        let n = diskread(64, head)
        if head[0] == 67 {
            if head[1] == 78 {
                if head[2] == 78 {
                    let count = head[3]
                    if count > 8 {
                        count = 8
                    }
                    let sector = makebytes(512)
                    let i = 0
                    while i < count {
                        let m = diskread(65 + i, sector)
                        let j = 0
                        while j < 64 {
                            block[i * 64 + j] = sector[j]
                            j = j + 1
                        }
                        i = i + 1
                    }
                    give count
                }
            }
        }
    }
    give 0
}

// Writes the notes block's kept notes to the disk: the
// header first, then one sector to a note, each holding
// its slot's sixty-four bytes at its start. Gives back 1
// when the page was written, 0 when there is no disk to
// keep it on.
make notesave(block: bytes, count: number) -> number {
    selectdrive()
    if disksectors() > 0 {
        let head = makebytes(512)
        head[0] = 67
        head[1] = 78
        head[2] = 78
        head[3] = count
        let w = diskwrite(64, head)
        let i = 0
        while i < count {
            let sector = makebytes(512)
            let j = 0
            while j < 64 {
                sector[j] = block[i * 64 + j]
                j = j + 1
            }
            let w2 = diskwrite(65 + i, sector)
            i = i + 1
        }
        give 1
    }
    give 0
}

// Gives the disk over to the system's keeping: the
// clearing the gate at the door promised, then the card.
// The disk's first sixty-four sectors — where a disk's own
// name and arrangement live — are wiped to zeros, and the
// card is written last of all, so a disk interrupted
// mid-clearing never wears a card it did not finish
// earning. The card is then read back, and only a card
// that truly stands earns a 1; anything else is a 0, and
// the main body says so plainly.
make disksetup(offset: number, chime: number) -> number {
    selectdrive()
    if disksectors() > 0 {
        let block = makebytes(512)
        let sector = 0
        while sector < 64 {
            let w = diskwrite(sector, block)
            sector = sector + 1
        }
        block[0] = 67
        block[1] = 78
        block[2] = offset + 64
        block[3] = chime
        let w = diskwrite(8, block)
        let back = makebytes(512)
        let n = diskread(8, back)
        if back[0] == 67 {
            if back[1] == 78 {
                if back[2] == offset + 64 {
                    give 1
                }
            }
        }
    }
    give 0
}
