// Cardnull OS 2's pixel-face library — drawing the desktop
// as light on the machine's picture screen (Stone 9).
//
// Like the other libraries, this file joins the system as
// a prelude when it is built (build.sh names it); a prelude
// may only make functions, and these keep no state of their
// own. The face's whole estate — where the picture screen
// stands in memory, its shape, the colors composed for it,
// the letter shapes' address, and the face's own layout —
// lives in one desk of bytes the main body takes and hands
// to every function here, the pattern usbkey.nifla's ledger
// set. All other state stays in the main body.
//
// The desk's ledger (four-byte numbers at byte offsets):
//    0  the picture screen's address (its low word)
//    4  its pitch — the bytes one row of it takes
//    8  its width in pixels      12  its height in pixels
//   16  the red field's place    20  the green field's place
//   24  the blue field's place
//   28  the face's columns       32  the face's rows
//   36  the letter shapes' address (a block font.nifla fills)
//   40  a scratch page's address (for the page tables)
//   44  the pointer's shapes' address (Stone 13: a block
//       arrowload fills with the arrow's fourteen rows)
//   48  the pointer's save block's address (Stone 13: the
//       patch of screen the arrow stands on, kept while
//       it stands there — sixteen pixels wide and
//       SEVENTEEN tall, the arrow's whole footprint: its
//       white edge is laid one pixel around its black
//       shape, so below the shape's last row (which ends
//       at y + 15) the edge's bottom pass still paints at
//       y + 16. A sixteen-tall save left that one row
//       unsaved and unrestored — the dotted trail the
//       pointer left behind it (the pointer trail fix))
//   56  the pen: the color now being drawn with, composed
//   60  the paper: the color a letter's cell is filled with
//   64..127  the palette: sixteen colors, composed for this
//       screen from the sixteen the text face knows by
//       number (black 0 through white 15, the VGA order)
//  128  the answers' first row   132  the answers' last row
//  136  the typing line's row
//  140  the panel's left column  144  the panel's top row
//  148  the panel's width        152  the panel's height
//       (the panel's measures are in letter cells)
//  172  the windows' standing (Stone 14), kept here in the
//       desk like the rest of the face's estate: whether
//       the welcome window stands open (172), whether the
//       feather window stands open (176), which window is
//       forward (180: 1 the welcome, 2 the feather, 3 the
//       files window, 0 none), and whether a feather has
//       visited (184)
//  188  the files window's standing (Stone 19): whether
//       it stands open (188), which kept note stands
//       picked in it (192), how many notes stand kept
//       (196), whether a disk is keeping them (200), and
//       whether a disk is fitted at all (204) — the last
//       three are the main body's facts, copied into the
//       desk whenever they change, so the window's
//       painting can say plainly where the notes live
//  208  the settings window's standing (Stone 20):
//       whether it stands open (208), and the main body's
//       facts copied in whenever they change — whether
//       the chime stands on (212) and the clock's offset
//       as the bar truly reckons it (216) — so the
//       window's painting shows the choices as they
//       actually stand. (180's forward reckoning grows
//       too: 4 is the settings window.)
//  220  the editor window's standing (Stone 21): whether
//       it stands open (220), whether it stands in its
//       writing way or its picking way (224: 0 picking,
//       1 writing), which entry stands picked in the
//       picking way (228: 0 the new-note entry, then one
//       more than the note's own place), and which note
//       the writing way is changing (232: the note's
//       place, or 8 when the note is a new one). The
//       note count and the keeping standing it shows are
//       the files window's copies at 196, 200 and 204 —
//       the same facts. (180's forward reckoning grows
//       again: 5 is the editor window.)
//  236  the windows' places (Stone 22): each window's
//       left column and top row, in letter cells — the
//       feather's (236, 240), the files window's (244,
//       248), the settings window's (252, 256), and the
//       editor window's (260, 264). At the face's rising
//       the main body lays each pair from the place the
//       window's measures first reckon; dragging a
//       window's title bar writes its pair, and the
//       window's own left/top reckonings read the pair,
//       so the painter and the pointer's pressing read
//       the one dragged place alike. The welcome window
//       needed no pair of its own: its place has always
//       lived in this desk at 140 to 152, and dragging
//       writes that place itself, the same way.
//  268  the bar menu's standing (Stone 23): whether the
//       menu the top bar opens stands open (1) or not
//       (0). The menu's place is reckoned in the main
//       body (menuleft and its kin), the same discipline
//       as the windows' measures, and its painting is
//       there too; only its standing lives here, with
//       the windows'.
//  272  the paint window's standing (Stone 24): whether
//       it stands open (272), whether the paint feather
//       has visited (276), and its place (280 its left
//       column, 284 its top row, in letter cells) — the
//       sixth window's pair, laid at the face's rising
//       and written by dragging, like the pairs at 236
//       to 264. (180's forward reckoning grows again:
//       6 is the paint window.) The window shows the
//       paint feather's own cells, in the main body's
//       second cell block; the feather, its colors, and
//       its canvas are the feather's — see
//       src/paint-feather.nifla.
//  288  the paint feather's cell block's address (Stone
//       24): the block the paint feather paints and the
//       paint window shows, found by its address because
//       paintwindows' hands are already full — the shape
//       the letter shapes (36) and the arrow (44) take.
//  292  the rest panel's standing (Stone 25): whether
//       the small panel of rest choices — Shut down,
//       Restart, Stay — stands open (1) or not (0). The
//       panel's place is reckoned in the main body
//       (restleft and its kin), the same discipline as
//       the menu's at 268; only its standing lives here.
//
// A letter cell is sixteen pixels square: the font's eight
// by eight, drawn at twice size. The face's layout is the
// text face's own, reckoned onto whatever grid the granted
// screen makes (layrow and laycol below), so a bigger or
// smaller screen draws the same desktop, larger or smaller.

// ---- the desk's own words ----

// Reads one of the desk's four-byte numbers.
make pget(desk: bytes, off: number) -> number {
    give floor(desk, off) {
        mov rax, [r10]
        mov eax, dword ptr [rbx + rax]
    }
}

// Writes one of the desk's four-byte numbers.
make pset(desk: bytes, off: number, value: number) {
    floor(desk, off, value) {
        mov rax, [r10]
        mov rcx, [r10 + 8]
        mov dword ptr [rbx + rax], ecx
    }
}

// A block of bytes, asked where it stands: its address as
// a plain number. (The drawing floors find the letter
// shapes and the page scratch by the addresses kept in
// the desk, so an address must be able to be a number.)
make blockaddr(block: bytes) -> number {
    give floor(block) {
        mov rax, rbx
    }
}

// One byte of a piece of text, by its place — 0 when the
// place is past the text's end.
make textbyte(text: text, i: number) -> number {
    give floor(text, i) {
        mov rax, [r10]
        cmp rax, r12
        jae tb_zero
        movzx eax, byte ptr [rbx + rax]
        jmp tb_done
    tb_zero:
        xor eax, eax
    tb_done:
    }
}

// ---- colors ----

// The red, green, and blue of one of the sixteen colors
// the text face knows by number, packed into one number
// (red in the high byte, then green, then blue) — the
// palette the pixel face is painted in, the same sixteen
// the text screen's own colors name.
make vgargb(idx: number) -> number {
    if idx == 0 { give 0 }
    if idx == 1 { give 170 }
    if idx == 2 { give 43520 }
    if idx == 3 { give 43690 }
    if idx == 4 { give 11141120 }
    if idx == 5 { give 11141290 }
    if idx == 6 { give 11162880 }
    if idx == 7 { give 11184810 }
    if idx == 8 { give 5592405 }
    if idx == 9 { give 5592575 }
    if idx == 10 { give 5635925 }
    if idx == 11 { give 5636095 }
    if idx == 12 { give 16733525 }
    if idx == 13 { give 16733695 }
    if idx == 14 { give 16777045 }
    give 16777215
}

// Composes one palette color for this screen: the color's
// red, green, and blue, each moved to the place the
// loader's answer said its field stands, and kept in the
// desk's palette at the color's number.
make pixcompose(desk: bytes, idx: number, rgb: number) {
    floor(desk, idx, rgb) {
        mov rax, [r10 + 8]
        mov rdx, rax
        shr rdx, 16
        and rdx, 255
        mov ecx, dword ptr [rbx + 16]
        shl rdx, cl
        mov r8, rdx
        mov rdx, rax
        shr rdx, 8
        and rdx, 255
        mov ecx, dword ptr [rbx + 20]
        shl rdx, cl
        or r8, rdx
        mov rdx, rax
        and rdx, 255
        mov ecx, dword ptr [rbx + 24]
        shl rdx, cl
        or r8, rdx
        mov rax, [r10]
        shl rax, 2
        mov dword ptr [rbx + rax + 64], r8d
    }
}

// Sets the pen from a palette number: the composed color
// the drawing now lays down.
make pixink(desk: bytes, idx: number) {
    pset(desk, 56, pget(desk, 64 + idx * 4))
}

// Sets the paper from a palette number: the composed color
// a letter's cell is first filled with.
make pixpaper(desk: bytes, idx: number) {
    pset(desk, 60, pget(desk, 64 + idx * 4))
}

// ---- the page tables ----
//
// The boot stub's own tables map the first gigabyte of the
// machine, which is where the system and its heap live —
// but a picture screen commonly stands higher (the bench's
// grant stands at 0xFD000000). When the granted screen
// stands above the mapped gigabyte, this floor lays one
// more page directory in the scratch page the desk names,
// covering the screen's whole gigabyte quarter, and enters
// it in the stub's page directory pointer table. A screen
// already within the mapped gigabyte needs nothing.
make pixmap(desk: bytes) {
    floor(desk) {
        mov eax, dword ptr [rbx]
        shr eax, 30
        mov r8d, eax
        mov rsi, offset __pdpt
        mov ecx, dword ptr [rsi + r8 * 8]
        test ecx, 1
        jnz pm_done
        mov eax, dword ptr [rbx + 40]
        add eax, 4095
        and eax, 0xFFFFF000
        mov r9d, eax
        mov r10d, r8d
        shl r10d, 30
        xor ecx, ecx
    pm_fill:
        mov eax, ecx
        shl eax, 21
        add eax, r10d
        or eax, 0x83
        mov dword ptr [r9 + rcx * 8], eax
        mov dword ptr [r9 + rcx * 8 + 4], 0
        inc ecx
        cmp ecx, 512
        jne pm_fill
        mov eax, r9d
        or eax, 3
        mov dword ptr [rsi + r8 * 8], eax
        mov dword ptr [rsi + r8 * 8 + 4], 0
        mov rax, offset __pml4
        mov cr3, rax
    pm_done:
    }
}

// ---- the layout ----

// The face's row for one of the text face's rows (0-24):
// the text face's proportions, on this screen's grid.
make layrow(desk: bytes, r: number) -> number {
    give (r * pget(desk, 32)) / 25
}

// The face's column for one of the text face's columns
// (0-79), the same reckoning across.
make laycol(desk: bytes, c: number) -> number {
    give (c * pget(desk, 28)) / 80
}

// Raises the face on the granted screen: the grid reckoned
// from the screen's shape, the layout laid, the palette
// composed, and the page tables extended when the screen
// stands above the mapped gigabyte. The desk's screen
// fields (offsets 0-24) and the two addresses (36, 40) are
// the main body's to have filled first. Gives back 1.
make pixbegin(desk: bytes) -> number {
    pset(desk, 28, pget(desk, 8) / 16)
    pset(desk, 32, pget(desk, 12) / 16)
    let idx = 0
    while idx < 16 {
        pixcompose(desk, idx, vgargb(idx))
        idx = idx + 1
    }
    if pget(desk, 0) >= 1073741824 {
        pixmap(desk)
    }
    pset(desk, 128, layrow(desk, 13))
    pset(desk, 132, layrow(desk, 22))
    pset(desk, 136, layrow(desk, 24))
    pset(desk, 140, laycol(desk, 8))
    pset(desk, 144, layrow(desk, 3))
    pset(desk, 148, laycol(desk, 72) - laycol(desk, 8))
    pset(desk, 152, layrow(desk, 10) - layrow(desk, 3))
    give 1
}

// ---- the drawing ----

// Fills a rectangle of pixels with the pen's color: its
// top-left corner and its size, in pixels.
make pixfill(desk: bytes, x: number, y: number, w: number, h: number) {
    floor(desk, x, y, w, h) {
        mov rax, [r10]
        shl rax, 2
        mov r11, rax
        mov rax, [r10 + 8]
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        add rax, r11
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov rdi, rax
        mov edx, dword ptr [rbx + 56]
        mov r8, [r10 + 24]
    pfl_row:
        test r8, r8
        jz pfl_done
        mov rcx, [r10 + 16]
        mov rsi, rdi
    pf_px:
        test rcx, rcx
        jz pf_next
        mov dword ptr [rsi], edx
        add rsi, 4
        dec rcx
        jmp pf_px
    pf_next:
        mov eax, dword ptr [rbx + 4]
        add rdi, rax
        dec r8
        jmp pfl_row
    pfl_done:
    }
}

// Draws one letter at a pixel corner with the pen's color:
// its shape read from the letter block the desk names, its
// eight rows laid at twice size. Letters outside the
// font's set (the codes 32 to 126) draw as a space.
make pixglyph(desk: bytes, x: number, y: number, code: number) {
    floor(desk, x, y, code) {
        mov rax, [r10 + 16]
        sub rax, 32
        cmp rax, 94
        jbe pg_g
        xor eax, eax
    pg_g:
        shl rax, 3
        mov ecx, dword ptr [rbx + 36]
        add rcx, rax
        mov r9, rcx
        mov rax, [r10]
        shl rax, 2
        mov r11, rax
        mov rax, [r10 + 8]
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        add rax, r11
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov r10, rax
        mov r8d, dword ptr [rbx + 56]
        mov r11d, dword ptr [rbx + 4]
        xor esi, esi
    pg_row:
        cmp esi, 8
        jae pg_done
        mov eax, esi
        shl eax, 1
        imul eax, r11d
        lea rdi, [r10 + rax]
        movzx eax, byte ptr [r9 + rsi]
        mov edx, eax
        shl edx, 24
        mov rcx, rdi
        mov r15d, 8
    pg_ca:
        shl edx, 1
        jnc pg_sa
        mov dword ptr [rcx], r8d
        mov dword ptr [rcx + 4], r8d
    pg_sa:
        add rcx, 8
        dec r15d
        jnz pg_ca
        add rdi, r11
        mov edx, eax
        shl edx, 24
        mov rcx, rdi
        mov r15d, 8
    pg_cb:
        shl edx, 1
        jnc pg_sb
        mov dword ptr [rcx], r8d
        mov dword ptr [rcx + 4], r8d
    pg_sb:
        add rcx, 8
        dec r15d
        jnz pg_cb
        inc esi
        jmp pg_row
    pg_done:
    }
}

// Draws a piece of text at a letter cell (its row and
// column on the face's grid): each letter's cell is first
// filled with the paper, then its shape drawn with the
// pen. Only the span the desk names (see pixspan) is
// drawn, and letters past the grid's edge are let go.
make pixtext(desk: bytes, row: number, col: number, text: text) {
    let cols = pget(desk, 28)
    let from = pget(desk, 160)
    let count = pget(desk, 164)
    let n = length(text)
    let i = 0
    while i < count {
        let at = from + i
        if at < n {
            let c = col + i
            if c < cols {
                pset(desk, 56, pget(desk, 60))
                pixfill(desk, c * 16, row * 16, 16, 16)
                let code = textbyte(text, at)
                if code != 32 {
                    pixink(desk, pget(desk, 168))
                    pixglyph(desk, c * 16, row * 16, code)
                }
            }
        }
        i = i + 1
    }
}

// Names the span of a text the next pixtext draws: where
// it begins and how many letters. (A text cannot be cut on
// bare metal, so a span is how a long line is wrapped: the
// same text, drawn in pieces.) The pen's palette number is
// kept with the span, at 168, for pixtext's letters.
make pixspan(desk: bytes, from: number, count: number, fgidx: number) {
    pset(desk, 160, from)
    pset(desk, 164, count)
    pset(desk, 168, fgidx)
}

// Draws a whole text at a cell, in one span. The place is
// named by 'cell' — the row times 256 plus the column —
// and the colors by 'attr', the text face's own attribute
// reckoning: the ink's palette place plus sixteen times
// the paper's. (A call can carry only six words, and the
// desk and the text take four of them.)
make pixline(desk: bytes, cell: number, text: text, attr: number) {
    let row = cell / 256
    let col = cell - row * 256
    let fg = attr - (attr / 16) * 16
    let bg = (attr / 16) - (attr / 128) * 8
    pixpaper(desk, bg)
    pixspan(desk, 0, length(text), fg)
    pixtext(desk, row, col, text)
}

// Scrolls the answers region up one letter row: the rows
// move, and the last row is wiped to black.
make pixscroll(desk: bytes) {
    floor(desk) {
        mov eax, dword ptr [rbx + 128]
        shl eax, 4
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov rdi, rax
        mov eax, dword ptr [rbx + 4]
        shl eax, 4
        lea rsi, [rdi + rax]
        mov eax, dword ptr [rbx + 132]
        sub eax, dword ptr [rbx + 128]
        shl eax, 4
        mov r8d, eax
        mov eax, dword ptr [rbx + 8]
        shl eax, 2
        mov r9d, eax
    ps_row:
        test r8d, r8d
        jz ps_wipe
        mov rcx, r9
        rep movsb
        mov eax, dword ptr [rbx + 4]
        sub eax, r9d
        add rsi, rax
        add rdi, rax
        dec r8d
        jmp ps_row
    ps_wipe:
        mov eax, dword ptr [rbx + 4]
        mov ecx, 16
        mul rcx
        mov rcx, rax
        xor eax, eax
    ps_b:
        test rcx, rcx
        jz ps_done
        mov dword ptr [rdi], eax
        add rdi, 4
        sub rcx, 4
        jmp ps_b
    ps_done:
    }
}

// Prints one answer line in the answers region, wrapped at
// the region's width onto as many rows as it needs, in the
// answers' colors (light gray on black); gives back the
// next free row. A word longer than the whole width is
// simply cut at the width — no word the system speaks is.
make pixprintline(desk: bytes, row: number, text: text) -> number {
    let usable = pget(desk, 28) - 4
    let bot = pget(desk, 132)
    let n = length(text)
    let r = row
    let start = 0
    let going = 1
    if n == 0 {
        going = 0
    }
    while going == 1 {
        let end = start + usable
        if end >= n {
            end = n
        } else {
            let j = end
            let hunting = 1
            while hunting == 1 {
                if j <= start {
                    hunting = 0
                } else {
                    if textbyte(text, j) == 32 {
                        hunting = 0
                    } else {
                        j = j - 1
                    }
                }
            }
            if j > start {
                end = j
            }
        }
        if r > bot {
            pixscroll(desk)
            r = bot
        }
        pixpaper(desk, 0)
        pixspan(desk, start, end - start, 7)
        pixtext(desk, r, 2, text)
        r = r + 1
        start = end
        if start < n {
            if textbyte(text, start) == 32 {
                start = start + 1
            }
        }
        if start >= n {
            going = 0
        }
    }
    give r
}

// Draws one kept note in the answers region at 'row'
// (Stone 15): the note stands in the block handed in, at
// 'off' — its length at that byte, its letters after —
// and is drawn letter by letter in the answers' colors
// (light gray on black), at the answers' own left edge.
// A note is kept as bytes, not as a text, so it is drawn
// from its bytes; the row reckoning is pixprintline's —
// the region scrolls when it is full — and the next free
// row is given back.
make pixnoteline(desk: bytes, block: bytes, row: number, off: number) -> number {
    let r = row
    let bot = pget(desk, 132)
    if r > bot {
        pixscroll(desk)
        r = bot
    }
    let n = cellbyte(block, off)
    pixpaper(desk, 0)
    let i = 0
    while i < n {
        let code = cellbyte(block, off + 1 + i)
        pset(desk, 56, pget(desk, 60))
        pixfill(desk, (2 + i) * 16, r * 16, 16, 16)
        if code != 32 {
            pset(desk, 56, pget(desk, 64 + 7 * 4))
            pixglyph(desk, (2 + i) * 16, r * 16, code)
        }
        i = i + 1
    }
    give r + 1
}

// ---- the feather's cells, read back for the drawing ----
//
// In the pixel face the feather paints a block of cells the
// host hands it (through the doorstep word placefeather
// lays — see featherdoor.nifla), and the host draws those
// cells as pixels after the visit. The feather cannot paint
// the text screen's own memory for this: on a machine
// showing a picture screen that memory is not a screen,
// and its cells cannot be read back from it — measured on
// the bench, it reads back as one repeated byte, the
// painting lost among the picture screen's own workings.

// One byte of the feather's cell block: the byte at 'off' —
// a cell's letter stands at its even byte, its color at
// the odd one after it.
make cellbyte(block: bytes, off: number) -> number {
    give floor(block, off) {
        mov rax, [r10]
        movzx eax, byte ptr [rbx + rax]
    }
}

// ---- the pointer's arrow (Stone 13) ----
//
// The arrow stands in a patch of the screen whose corner
// the main body keeps: before the arrow is drawn there,
// the patch's own pixels are kept in the save block the
// desk names at 48, and when the arrow moves on they are
// laid back, so the desktop under it is never harmed. The
// patch is sixteen pixels wide and seventeen tall — one
// row taller than the square it was first kept as —
// because the arrow's whole footprint is that tall: the
// shape's fourteen rows stand at y + 2 to y + 15, and its
// white edge is laid one pixel around the shape (see
// pixarrow's passes), so the edge's bottom pass paints
// the shape's last row again at y + 16, one row BELOW a
// sixteen-tall save. That row was drawn but never saved
// or laid back, so every place the arrow had stood kept
// the last row's five white edge pixels — the dotted
// trail across the desktop (witnessed by Tyler in UTM,
// November 15, 2026, and reproduced on the bench: after a
// move, the sixteen kept rows stood whole and exactly
// those five pixels at y + 16 stayed white on the black
// ground). The save and the laying back below now cover
// all seventeen rows, and the main body keeps the
// arrow's corner one row further from the screen's
// bottom edge, so the whole patch always stands on the
// screen. The arrow's own shape — fourteen
// rows, eleven letters wide, its point at the square's
// (2, 2) — stands as fourteen numbers in the block the
// desk names at 44, each number one row, its high bit the
// row's leftmost pixel:
//
//   #..........
//   ##.........
//   ###........
//   ####.......
//   #####......
//   ######.....
//   #######....
//   ########...
//   #########..
//   ##########.
//   #######....
//   #####......
//   ####.##....
//   ###...##...

// Lays the arrow's fourteen rows into the block handed
// in, by the desk's own writing (pset writes any block).
make arrowload(block: bytes) {
    pset(block, 0, 1024)
    pset(block, 4, 1536)
    pset(block, 8, 1792)
    pset(block, 12, 1920)
    pset(block, 16, 1984)
    pset(block, 20, 2016)
    pset(block, 24, 2032)
    pset(block, 28, 2040)
    pset(block, 32, 2044)
    pset(block, 36, 2046)
    pset(block, 40, 2032)
    pset(block, 44, 1984)
    pset(block, 48, 1968)
    pset(block, 52, 1816)
}

// Keeps the arrow's whole patch at (x, y) in the save
// block, before the arrow is drawn over it: sixteen
// pixels wide and seventeen tall, the footprint's full
// measure (see the pointer's heading above).
make pixsave(desk: bytes, x: number, y: number) {
    floor(desk, x, y) {
        mov rax, [r10 + 8]
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        mov rcx, [r10]
        shl rcx, 2
        add rax, rcx
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov rsi, rax
        mov edi, dword ptr [rbx + 48]
        mov r8, 17
    psv_row:
        mov rcx, 16
    psv_px:
        mov eax, dword ptr [rsi]
        mov dword ptr [rdi], eax
        add rsi, 4
        add rdi, 4
        dec rcx
        jnz psv_px
        mov eax, dword ptr [rbx + 4]
        sub rax, 64
        add rsi, rax
        dec r8
        jnz psv_row
    }
}

// Lays the kept patch back at (x, y) — all seventeen
// rows of it, the bottom edge's row among them: the
// arrow is gone from there, and the desktop stands as
// it was.
make pixrestore(desk: bytes, x: number, y: number) {
    floor(desk, x, y) {
        mov rax, [r10 + 8]
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        mov rcx, [r10]
        shl rcx, 2
        add rax, rcx
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov rdi, rax
        mov esi, dword ptr [rbx + 48]
        mov r8, 17
    prs_row:
        mov rcx, 16
    prs_px:
        mov eax, dword ptr [rsi]
        mov dword ptr [rdi], eax
        add rsi, 4
        add rdi, 4
        dec rcx
        jnz prs_px
        mov eax, dword ptr [rbx + 4]
        sub rax, 64
        add rdi, rax
        dec r8
        jnz prs_row
    }
}

// Draws the arrow in the square at (x, y): first its
// white edge — the shape laid at the four places around
// its home — then the shape itself in black at (2, 2)
// within the square, so its point stands at (x + 2,
// y + 2) and it reads on any ground the desktop shows.
// The edge's four places reach one pixel past the shape
// on every side: across, x + 1 to x + 12, and down, y + 1
// to y + 16 — the bottom reach is the row the seventeen-
// tall save above exists for.
make pixarrow(desk: bytes, x: number, y: number) {
    floor(desk, x, y) {
        mov r14d, dword ptr [rbx + 44]
        xor r13, r13
    par_pass:
        cmp r13, 5
        jae par_done
        mov rax, offset par_dx
        movzx ecx, byte ptr [rax + r13]
        mov r15, rcx
        mov rax, offset par_dy
        movzx ecx, byte ptr [rax + r13]
        mov rax, [r10 + 8]
        add rax, rcx
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        mov rcx, [r10]
        add rcx, r15
        shl rcx, 2
        add rax, rcx
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov rdi, rax
        cmp r13, 4
        je par_black
        mov r8d, dword ptr [rbx + 124]
        jmp par_color
    par_black:
        mov r8d, dword ptr [rbx + 64]
    par_color:
        xor r11, r11
    par_row:
        cmp r11, 14
        jae par_next
        mov eax, dword ptr [r14 + r11 * 4]
        mov rsi, rdi
        mov ecx, 1024
    par_col:
        test ecx, ecx
        jz par_rowdone
        test eax, ecx
        jz par_skip
        mov dword ptr [rsi], r8d
    par_skip:
        add rsi, 4
        shr ecx, 1
        jmp par_col
    par_rowdone:
        mov eax, dword ptr [rbx + 4]
        add rdi, rax
        inc r11
        jmp par_row
    par_next:
        inc r13
        jmp par_pass
    par_done:
        jmp par_end
    par_dx:
        .byte 1, 3, 2, 2, 2
    par_dy:
        .byte 2, 2, 1, 3, 2
    par_end:
    }
}
