// Cardnull OS 2's pixel-face library — drawing the desktop
// as light on the machine's picture screen (Stone 9).
// Stone 33 gives this library the glass drawing: the bar
// at the screen's foot with its sheen and tint, the round
// start button carrying the pixel-drawn cardinal, the
// windows' rounded corners, title sheens, and soft
// shadows — all drawn here, in Cardnull's own hand.
//
// Like the other libraries, this file joins the system as
// a prelude when it is built (build.sh names it); a prelude
// may only make functions, and these keep no state of their
// own. The face's whole estate — where the picture screen
// stands in memory, its shape, the colors composed for it,
// the letter shapes' address, and the face's own layout —
// lives in one desk of bytes the main body takes and hands
// to every function here, the pattern usbkey.nifla's ledger
// set. All other state stays in the main body.
//
// The desk's ledger (four-byte numbers at byte offsets):
//    0  the picture screen's address (its low word)
//    4  its pitch — the bytes one row of it takes
//    8  its width in pixels      12  its height in pixels
//   16  the red field's place    20  the green field's place
//   24  the blue field's place
//   28  the face's columns       32  the face's rows
//   36  the letter shapes' address (a block font.nifla fills)
//   40  a scratch page's address (for the page tables)
//   44  the pointer's shapes' address (Stone 13: a block
//       arrowload fills with the arrow's fourteen rows)
//   48  the pointer's save block's address (Stone 13: the
//       patch of screen the arrow stands on, kept while
//       it stands there — sixteen pixels wide and
//       SEVENTEEN tall, the arrow's whole footprint: its
//       white edge is laid one pixel around its black
//       shape, so below the shape's last row (which ends
//       at y + 15) the edge's bottom pass still paints at
//       y + 16. A sixteen-tall save left that one row
//       unsaved and unrestored — the dotted trail the
//       pointer left behind it (the pointer trail fix))
//   56  the pen: the color now being drawn with, composed
//   60  the paper: the color a letter's cell is filled with
//   64..127  the palette: sixteen colors, composed for this
//       screen from the sixteen the text face knows by
//       number (black 0 through white 15, the VGA order)
//  128  the answers' first row   132  the answers' last row
//  136  the typing line's row
//  140  the panel's left column  144  the panel's top row
//  148  the panel's width        152  the panel's height
//       (the panel's measures are in letter cells)
//  172  the windows' standing (Stone 14), kept here in the
//       desk like the rest of the face's estate: whether
//       the welcome window stands open (172), whether the
//       feather window stands open (176), which window is
//       forward (180: 1 the welcome, 2 the feather, 3 the
//       files window, 0 none), and whether a feather has
//       visited (184)
//  188  the files window's standing (Stone 19): whether
//       it stands open (188), which kept note stands
//       picked in it (192), how many notes stand kept
//       (196), whether a disk is keeping them (200), and
//       whether a disk is fitted at all (204) — the last
//       three are the main body's facts, copied into the
//       desk whenever they change, so the window's
//       painting can say plainly where the notes live
//  208  the settings window's standing (Stone 20):
//       whether it stands open (208), and the main body's
//       facts copied in whenever they change — whether
//       the chime stands on (212) and the clock's offset
//       as the bar truly reckons it (216) — so the
//       window's painting shows the choices as they
//       actually stand. (180's forward reckoning grows
//       too: 4 is the settings window.)
//  220  the editor window's standing (Stone 21): whether
//       it stands open (220), whether it stands in its
//       writing way or its picking way (224: 0 picking,
//       1 writing), which entry stands picked in the
//       picking way (228: 0 the new-note entry, then one
//       more than the note's own place), and which note
//       the writing way is changing (232: the note's
//       place, or 8 when the note is a new one). The
//       note count and the keeping standing it shows are
//       the files window's copies at 196, 200 and 204 —
//       the same facts. (180's forward reckoning grows
//       again: 5 is the editor window.)
//  236  the windows' places (Stone 22): each window's
//       left column and top row, in letter cells — the
//       feather's (236, 240), the files window's (244,
//       248), the settings window's (252, 256), and the
//       editor window's (260, 264). At the face's rising
//       the main body lays each pair from the place the
//       window's measures first reckon; dragging a
//       window's title bar writes its pair, and the
//       window's own left/top reckonings read the pair,
//       so the painter and the pointer's pressing read
//       the one dragged place alike. The welcome window
//       needed no pair of its own: its place has always
//       lived in this desk at 140 to 152, and dragging
//       writes that place itself, the same way.
//  268  the bar menu's standing (Stone 23): whether the
//       menu the top bar opens stands open (1) or not
//       (0). The menu's place is reckoned in the main
//       body (menuleft and its kin), the same discipline
//       as the windows' measures, and its painting is
//       there too; only its standing lives here, with
//       the windows'.
//  272  the paint window's standing (Stone 24): whether
//       it stands open (272), whether the paint feather
//       has visited (276), and its place (280 its left
//       column, 284 its top row, in letter cells) — the
//       sixth window's pair, laid at the face's rising
//       and written by dragging, like the pairs at 236
//       to 264. (180's forward reckoning grows again:
//       6 is the paint window.) The window shows the
//       paint feather's own cells, in the main body's
//       second cell block; the feather, its colors, and
//       its canvas are the feather's — see
//       src/paint-feather.nifla.
//  288  the paint feather's cell block's address (Stone
//       24): the block the paint feather paints and the
//       paint window shows, found by its address because
//       paintwindows' hands are already full — the shape
//       the letter shapes (36) and the arrow (44) take.
//  292  the rest panel's standing (Stone 25): whether
//       the small panel of rest choices — Shut down,
//       Restart, Stay — stands open (1) or not (0). The
//       panel's place is reckoned in the main body
//       (restleft and its kin), the same discipline as
//       the menu's at 268; only its standing lives here.
//  296  the kept picture's standing (Stone 26): whether
//       a picture stands kept on the disk (1) or none
//       does (0) — the main body's fact, copied into the
//       desk whenever it changes, so the files window's
//       painting can list the picture beside the notes.
//  300  letting a note go (Stone 27): the files window's
//       asking — whether its "are you sure" asking
//       stands open (300: 1) or not (0), and which of
//       its two choices stands picked (304: 0 "Yes, let
//       it go", 1 "Keep it" — the asking opens with
//       "Keep it" picked, so Enter alone never lets a
//       note go). The note the asking is about is the
//       files window's own pick at 192, which cannot
//       move while the asking stands.
//  308  the editor window's asking, the same shape:
//       whether it stands open (308), which choice
//       stands picked (312, the same reckoning), and
//       which note it is about (316: the note's place
//       on the page — the pick's note from the picking
//       way, or the open note from the writing way).
//  324  the verse window's standing (Stone 29): whether
//       it stands open (324), its place (328 its left
//       column, 332 its top row, in letter cells) — the
//       seventh window's pair, laid at the face's rising
//       and written by dragging, like the pairs at 236
//       to 284 — and which kept verse stands in it
//       (336: the verse's place in the kept set, laid
//       by the main body when the window is opened,
//       reckoned from the day — see verses.nifla).
//       (180's forward reckoning grows again: 7 is the
//       verse window.)
//  340  the calculator window's standing (Stone 30):
//       whether it stands open (340), whether the
//       calculator feather has visited (344), and its
//       place (348 its left column, 352 its top row,
//       in letter cells) — the eighth window's pair,
//       laid at the face's rising and written by
//       dragging, like the pairs at 236 to 332.
//       (180's forward reckoning grows again: 8 is the
//       calculator window.)
//  356  the calculator feather's cell block's address
//       (Stone 30): the block the calculator feather
//       paints and the calculator window shows, found
//       by its address as the paint cells' block is at
//       288.
//  360  the help window's standing (Stone 31): whether
//       it stands open (360), which page of the help
//       words stands in it (364: 0 to 4, laid by the
//       main body when the window is opened and turned
//       by its foot's press and the arrow keys), and
//       its place (368 its left column, 372 its top
//       row, in letter cells) — the ninth window's
//       pair, laid at the face's rising and written by
//       dragging, like the pairs at 236 to 352.
//       (180's forward reckoning grows again: 9 is the
//       help window.)
//  376  the files window's naming way (Stone 40):
//       whether a naming stands open in the files
//       window (376: 0 none, 1 renaming the picked
//       note, 2 copying the picked note under a new
//       name, 3 renaming the kept picture), and the
//       word the naming last spoke in the window
//       (380: 0 none, 1 that name already stands,
//       2 no name written yet, 3 the notes page is
//       full). The picked entry the naming is about
//       is the files window's own pick at 192, which
//       cannot move while the naming stands, as the
//       letting-go asking's pick cannot. The name
//       being typed lives in the notes block's tenth
//       slot and the kept picture's name in its
//       eleventh — the main body's keeping, in the
//       notes block's own shape.
//  384  the region repaint's road (Stone 34): the
//       stretch of the desktop, in letter cells, that
//       the next region repaint serves — its left
//       column (384), its top row (388), its width
//       (392), and its height (396) — laid by layroad
//       before paintregion is called, the machine's
//       registers being already full with the call's
//       three blocks; and the window callpainter is to
//       paint (400), laid the same way.
//  404  the terminal window's standing (Stone 38):
//       whether the tenth window stands open (404),
//       its place (408 its left column, 412 its top
//       row, in letter cells — laid at the face's
//       rising and written by dragging, like the pairs
//       at 236 to 352; 180's forward reckoning grows
//       again: 10 is the terminal window), and the
//       address of the answers' keeping block (416) —
//       eleven rows of forty-eight letter-and-color
//       cells where the typing line's answers are
//       kept, so the window's painter can lay them
//       again after any repaint. The answers' first
//       and last rows (128 and 132) and the typing
//       line's row (136) are laid inside this window
//       by layplaces now. The desk stood 420 bytes
//       then.
//  424  the Bible window's standing (Stone 41): whether
//       it stands open (424), which page of the kept
//       book stands in it (428: 0 the contents page,
//       then the book's pages in order, laid by the main
//       body when the window is opened and turned by its
//       foot's presses and the arrow keys), its place
//       (432 its left column, 436 its top row, in letter
//       cells) — the eleventh window's pair, laid at the
//       face's rising and written by dragging, like the
//       pairs at 236 to 412 — and the contents page's
//       chapter pick (440: 1 to 4, the chapter Enter or
//       the foot's Read word will read). (180's forward
//       reckoning grows again: 11 is the Bible window.)
//       The standing begins at 424, not 420: the
//       terminal's answers-block address at 416 is read
//       whole, eight bytes at a time, by the floor that
//       lays the answers (drawtermbody's kin), so its
//       high half at 420 to 423 must stand empty — a
//       first laying of this standing at 420 wrote the
//       window's open mark into that high half, the
//       answers' address went wild, and the window
//       would not open; the bench caught it, and the
//       standing stands clear of the address now.
//       The desk stood 444 bytes then.
//  444  the Shield window's standing (Stone 42):
//       whether it stands open (444) and its place
//       (448 its left column, 452 its top row, in
//       letter cells) — the twelfth window's pair,
//       laid at the face's rising and written by
//       dragging, like the pairs at 236 to 436 —
//       and the feather door's reckoning, the main
//       body's facts copied in whenever they change
//       so the window's painting can tell it plainly:
//       how many feathers the door has let in since
//       the rising (456) and how many it has turned
//       away for a card that did not reckon true
//       (460). (180's forward reckoning grows again:
//       12 is the Shield window.) The desk stood
//       464 bytes then.
//  464  the drag step's errand (Stone 45): which
//       window a drag step is moving (464) and the
//       place it is going to (468 its left column,
//       472 its top row, in letter cells) — laid by
//       the drag's following in the main body before
//       each dragstep call, the way the region
//       repaint's road is laid at 384, the call's
//       three blocks filling the machine's registers
//       already. The desk stood 476 bytes then.
//  476  the picture window's standing (Stone 48):
//       whether it stands open (476), the kept
//       picture block's address (480 — laid by the
//       main body at the rising, where the picture
//       window's painter reads the kept picture's
//       cells through it, as the paint window's
//       painter reads its cells through 288,
//       because paintwindows' hands are already
//       full), and its place (484 its left, 488
//       its top) — a place pair of its own, like
//       the pairs at 236 to 452, so the healed
//       drag roads move it as they move the
//       others. (180's forward reckoning grows
//       again: 13 is the picture window.) The
//       desk stood 492 bytes then.
//  492  the files window's exchange word (Stone 49):
//       the word the exchange with a USB stick last
//       spoke in the files window, standing on the
//       window's new last row in the exchange words'
//       place while it stands (492: 0 none — the
//       exchange words "To the stick" and "From the
//       stick" stand there instead; 1 copied to the
//       stick, 2 brought in from the stick, 3 no
//       stick stands in this computer, 4 that name
//       already stands on the stick, 5 the stick's
//       notes page is full, 6 a picture already
//       stands on the stick, 7 the stick holds no
//       note of that name, 8 no picture stands on
//       the stick, 9 the stick is this computer's
//       keeping, 10 the copy could not be made, 11
//       brought in, but the disk would not keep
//       it). The picked entry the exchange is about
//       is the files window's own pick at 192, and
//       the word is forgotten whenever the pick
//       moves, as the naming's word at 380 is the
//       naming's own to keep. The desk stood 496
//       bytes then. (496 to 507 are the Cardinal
//       asking's standing, pick, and word, Stone
//       50, told at the desk's laying in the main
//       body.)
//  508  the drag's painted place (the Drag Mend,
//       November 27, 2026): the place the dragged
//       window's painting actually stands on the
//       glass (508 its left column, 512 its top
//       row, in letter cells) — laid by the
//       take-hold to the window's place, and by
//       dragstep to each place it paints, so a
//       step washes the ground the painting truly
//       stands on while the window's own place
//       (its pair among 236 to 488) runs ahead of
//       the painting during a packet flood.
//  516  the tunes window's standing (Stone 51):
//       whether it stands open, which tune stands
//       picked at 520, and its place at 524 and
//       528 (its left column and its top row, in
//       letter cells), reckoned like every
//       window's. The desk stands 532 bytes now.
//  320  the letter cell's size in pixels (Stone 28):
//       sixteen at the words' usual size — the font's
//       eight by eight drawn at twice size — and
//       twenty-four when large print stands chosen in
//       the settings window, the same font drawn at
//       three times size. The face's grid (28 and 32)
//       is reckoned from this measure in pixbegin, and
//       every drawing and every pointer reckoning in
//       the system reads this one measure, so painter
//       and pointer agree at either size. The main body
//       lays it before pixbegin is called, at the face's
//       rising and again whenever the size is switched.
//
// A letter cell is sixteen pixels square at the usual
// size: the font's eight by eight, drawn at twice size
// (twenty-four pixels, at three times size, when large
// print stands — Stone 28). The face's layout is the
// text face's own, reckoned onto whatever grid the granted
// screen makes (layrow and laycol below), so a bigger or
// smaller screen draws the same desktop, larger or smaller.

// ---- the desk's own words ----

// Reads one of the desk's four-byte numbers.
make pget(desk: bytes, off: number) -> number {
    give floor(desk, off) {
        mov rax, [r10]
        mov eax, dword ptr [rbx + rax]
    }
}

// Writes one of the desk's four-byte numbers.
make pset(desk: bytes, off: number, value: number) {
    floor(desk, off, value) {
        mov rax, [r10]
        mov rcx, [r10 + 8]
        mov dword ptr [rbx + rax], ecx
    }
}

// A block of bytes, asked where it stands: its address as
// a plain number. (The drawing floors find the letter
// shapes and the page scratch by the addresses kept in
// the desk, so an address must be able to be a number.)
make blockaddr(block: bytes) -> number {
    give floor(block) {
        mov rax, rbx
    }
}

// One byte of a piece of text, by its place — 0 when the
// place is past the text's end.
make textbyte(text: text, i: number) -> number {
    give floor(text, i) {
        mov rax, [r10]
        cmp rax, r12
        jae tb_zero
        movzx eax, byte ptr [rbx + rax]
        jmp tb_done
    tb_zero:
        xor eax, eax
    tb_done:
    }
}

// ---- colors ----

// The red, green, and blue of one of the sixteen colors
// the text face knows by number, packed into one number
// (red in the high byte, then green, then blue) — the
// palette the pixel face is painted in, the same sixteen
// the text screen's own colors name.
make vgargb(idx: number) -> number {
    if idx == 0 { give 0 }
    if idx == 1 { give 170 }
    if idx == 2 { give 43520 }
    if idx == 3 { give 43690 }
    if idx == 4 { give 11141120 }
    if idx == 5 { give 11141290 }
    if idx == 6 { give 11162880 }
    if idx == 7 { give 11184810 }
    if idx == 8 { give 5592405 }
    if idx == 9 { give 5592575 }
    if idx == 10 { give 5635925 }
    if idx == 11 { give 5636095 }
    if idx == 12 { give 16733525 }
    if idx == 13 { give 16733695 }
    if idx == 14 { give 16777045 }
    give 16777215
}

// Composes one palette color for this screen: the color's
// red, green, and blue, each moved to the place the
// loader's answer said its field stands, and kept in the
// desk's palette at the color's number.
make pixcompose(desk: bytes, idx: number, rgb: number) {
    floor(desk, idx, rgb) {
        mov rax, [r10 + 8]
        mov rdx, rax
        shr rdx, 16
        and rdx, 255
        mov ecx, dword ptr [rbx + 16]
        shl rdx, cl
        mov r8, rdx
        mov rdx, rax
        shr rdx, 8
        and rdx, 255
        mov ecx, dword ptr [rbx + 20]
        shl rdx, cl
        or r8, rdx
        mov rdx, rax
        and rdx, 255
        mov ecx, dword ptr [rbx + 24]
        shl rdx, cl
        or r8, rdx
        mov rax, [r10]
        shl rax, 2
        mov dword ptr [rbx + rax + 64], r8d
    }
}

// Sets the pen from a palette number: the composed color
// the drawing now lays down.
make pixink(desk: bytes, idx: number) {
    pset(desk, 56, pget(desk, 64 + idx * 4))
}

// Sets the paper from a palette number: the composed color
// a letter's cell is first filled with.
make pixpaper(desk: bytes, idx: number) {
    pset(desk, 60, pget(desk, 64 + idx * 4))
}

// ---- the glass colors (Stone 33) ----
//
// The glass face is drawn in colors the sixteen-color
// palette does not hold — the sheen's pale blue-green, the
// frame tint, the start button's stained glass — composed
// for this screen from a packed red-green-blue number
// (red in the high byte, then green, then blue, the
// packing vgargb uses), each part moved to the place the
// loader's answer said its field stands, the reckoning
// pixcompose does for the palette. The glass is Cardnull's
// own drawing in the style of a glass desktop — no other
// system's artwork stands in it.

// Doubles a number 'n' times: the shift the field places
// ask for, as multiplication, which is what the bare
// language offers.
make shlval(v: number, n: number) -> number {
    let r = v
    let i = 0
    while i < n {
        r = r * 2
        i = i + 1
    }
    give r
}

// Composes one packed color for this screen.
make pixcomp(desk: bytes, rgb: number) -> number {
    let r = rgb / 65536
    let g = (rgb - r * 65536) / 256
    let b = rgb - r * 65536 - g * 256
    give shlval(r, pget(desk, 16)) + shlval(g, pget(desk, 20)) + shlval(b, pget(desk, 24))
}

// Sets the pen from a packed color, composed for this
// screen — pixink's shape, for a glass color.
make pixinkrgb(desk: bytes, rgb: number) {
    pset(desk, 56, pixcomp(desk, rgb))
}

// The glass colors themselves, packed as vgargb packs:
// the sheen's pale light and its middle band, the calm
// blue-green tint of the frames, the start button's deep
// glass, the soft shadow's near-black, and the cardinal's
// stained glass — its lead, its deep red and bright red,
// its gold, and its beak's orange.
make glasssheen() -> number { give 10147550 }
make glassmid() -> number { give 6270654 }
make glasstint() -> number { give 3047060 }
make glassbase() -> number { give 2055790 }
make glassshadow() -> number { give 659990 }
make glasslead() -> number { give 1579040 }
make glassred() -> number { give 12588578 }
make glassbright() -> number { give 15219266 }
make glassgold() -> number { give 15315514 }
make glassbeak() -> number { give 15760926 }
make glasspale() -> number { give 13162716 }

// ---- the page tables ----
//
// The boot stub's own tables map the first gigabyte of the
// machine, which is where the system and its heap live —
// but a picture screen commonly stands higher (the bench's
// grant stands at 0xFD000000). When the granted screen
// stands above the mapped gigabyte, this floor lays one
// more page directory in the scratch page the desk names,
// covering the screen's whole gigabyte quarter, and enters
// it in the stub's page directory pointer table. A screen
// already within the mapped gigabyte needs nothing.
make pixmap(desk: bytes) {
    floor(desk) {
        mov eax, dword ptr [rbx]
        shr eax, 30
        mov r8d, eax
        mov rsi, offset __pdpt
        mov ecx, dword ptr [rsi + r8 * 8]
        test ecx, 1
        jnz pm_done
        mov eax, dword ptr [rbx + 40]
        add eax, 4095
        and eax, 0xFFFFF000
        mov r9d, eax
        mov r10d, r8d
        shl r10d, 30
        xor ecx, ecx
    pm_fill:
        mov eax, ecx
        shl eax, 21
        add eax, r10d
        or eax, 0x83
        mov dword ptr [r9 + rcx * 8], eax
        mov dword ptr [r9 + rcx * 8 + 4], 0
        inc ecx
        cmp ecx, 512
        jne pm_fill
        mov eax, r9d
        or eax, 3
        mov dword ptr [rsi + r8 * 8], eax
        mov dword ptr [rsi + r8 * 8 + 4], 0
        mov rax, offset __pml4
        mov cr3, rax
    pm_done:
    }
}

// ---- the layout ----

// The face's row for one of the text face's rows (0-24):
// the text face's proportions, on this screen's grid.
make layrow(desk: bytes, r: number) -> number {
    give (r * pget(desk, 32)) / 25
}

// The face's column for one of the text face's columns
// (0-79), the same reckoning across.
make laycol(desk: bytes, c: number) -> number {
    give (c * pget(desk, 28)) / 80
}

// Raises the face on the granted screen: the grid reckoned
// from the screen's shape, the layout laid, the palette
// composed, and the page tables extended when the screen
// stands above the mapped gigabyte. The desk's screen
// fields (offsets 0-24) and the two addresses (36, 40) are
// the main body's to have filled first. Gives back 1.
make pixbegin(desk: bytes) -> number {
    // The grid is reckoned from the cell's size (the
    // desk's 320, Stone 28): sixteen pixels a cell at
    // the usual size, twenty-four at large print — so
    // the same screen holds fewer, bigger cells when
    // the words stand large, and the layout below is
    // laid onto that grid exactly as it always has been.
    let cellpx = pget(desk, 320)
    if cellpx < 16 {
        cellpx = 16
    }
    pset(desk, 28, pget(desk, 8) / cellpx)
    pset(desk, 32, pget(desk, 12) / cellpx)
    let idx = 0
    while idx < 16 {
        pixcompose(desk, idx, vgargb(idx))
        idx = idx + 1
    }
    if pget(desk, 0) >= 1073741824 {
        pixmap(desk)
    }
    pset(desk, 128, layrow(desk, 13))
    pset(desk, 132, layrow(desk, 22))
    // The typing line's row (Stone 33): the bar stands at
    // the screen's foot now, two rows tall, so the typing
    // line stands just above it — the grid's third row
    // from the foot — where the bar can never cover it.
    pset(desk, 136, pget(desk, 32) - 3)
    pset(desk, 140, laycol(desk, 8))
    pset(desk, 144, layrow(desk, 3))
    pset(desk, 148, laycol(desk, 72) - laycol(desk, 8))
    pset(desk, 152, layrow(desk, 10) - layrow(desk, 3))
    give 1
}

// ---- the drawing ----

// Fills a rectangle of pixels with the pen's color: its
// top-left corner and its size, in pixels.
make pixfill(desk: bytes, x: number, y: number, w: number, h: number) {
    floor(desk, x, y, w, h) {
        mov rax, [r10]
        shl rax, 2
        mov r11, rax
        mov rax, [r10 + 8]
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        add rax, r11
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov rdi, rax
        mov edx, dword ptr [rbx + 56]
        mov r8, [r10 + 24]
    pfl_row:
        test r8, r8
        jz pfl_done
        mov rcx, [r10 + 16]
        mov rsi, rdi
    pf_px:
        test rcx, rcx
        jz pf_next
        mov dword ptr [rsi], edx
        add rsi, 4
        dec rcx
        jmp pf_px
    pf_next:
        mov eax, dword ptr [rbx + 4]
        add rdi, rax
        dec r8
        jmp pfl_row
    pfl_done:
    }
}

// ---- the glass drawing (Stone 33) ----

// The bar's top edge, in pixels: the bar stands at the
// screen's foot, two letter rows tall (see pixbar below),
// and everything else on the desktop stands above it.
make pixbartop(desk: bytes) -> number {
    give (pget(desk, 32) - 2) * pget(desk, 320)
}

// Fills a disc of the pen's color: its center and its
// radius, in pixels. The glass face's round shapes — the
// start button, the windows' rounded corners — are drawn
// with it, one pixel at a time.
make pixdisc(desk: bytes, cx: number, cy: number, r: number) {
    let dy = 0 - r
    while dy <= r {
        let dx = 0 - r
        while dx <= r {
            if dx * dx + dy * dy <= r * r {
                pixfill(desk, cx + dx, cy + dy, 1, 1)
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

// Lays a window's soft shadow: a dark band along its
// right edge and under its foot, offset a few pixels, in
// the shadow's near-black. The shadow never falls on the
// bar: its bands are clipped at the bar's top edge, so
// the ground a shadow stood on is always desktop ground
// the wash below can make whole again.
make pixshadow(desk: bytes, x: number, y: number, w: number, h: number) {
    let bt = pixbartop(desk)
    let sw = pget(desk, 8)
    pixinkrgb(desk, glassshadow())
    if x + w + 5 <= sw {
        if y + 5 < bt {
            let hh = h - 5
            if y + 5 + hh > bt {
                hh = bt - (y + 5)
            }
            if hh > 0 {
                pixfill(desk, x + w, y + 5, 5, hh)
            }
        }
    }
    if y + h < bt {
        let hh2 = 5
        if y + h + hh2 > bt {
            hh2 = bt - (y + h)
        }
        if hh2 > 0 {
            pixfill(desk, x + 5, y + h, w - 5, hh2)
            if x + w + 5 <= sw {
                pixfill(desk, x + w, y + h, 5, hh2)
            }
        }
    }
}

// Wipes one window's whole place back to the plain
// desktop: its frame's place and its shadow's, the six
// pixels the shadow reaches past the frame's right and
// foot — clipped at the bar's top and the screen's right
// edge, the very places the shadow itself is clipped to,
// so a closed or dragged-away window leaves the desktop
// exactly as it found it, and the bar untouched.
make pixwashwin(desk: bytes, gx: number, gy: number, gw: number, gh: number) {
    let cs = pget(desk, 320)
    let bt = pixbartop(desk)
    let y0 = gy * cs
    let hh = gh * cs + 6
    if y0 + hh > bt {
        hh = bt - y0
    }
    let ww = gw * cs + 6
    if gx * cs + ww > pget(desk, 8) {
        ww = pget(desk, 8) - gx * cs
    }
    pixink(desk, 0)
    if hh > 0 {
        pixfill(desk, gx * cs, y0, ww, hh)
    }
}

// ---- the cardinal on the start button (Stone 33) ----
//
// The start button carries Cardnull's own mark — the
// stained-glass cardinal of the Cardnull logo — reduced
// honestly to a small pixel drawing in this library's own
// hand, the pattern of font.nifla's hand-drawn shapes and
// of the pointer's arrow above: twenty-four rows of
// twenty-four, one letter a pixel, standing here exactly
// as drawn. The letters name the stained glass's colors:
//   K  the lead — the dark divisions between the glass
//   R  the bird's deep red        r  its bright red
//   G  the wing's gold            O  the beak's orange
//   W  the eye's one white spark  .  no glass — the
//      button's own glass stands there instead
// The bird faces right, as the logo's does: its crest
// swept up at the back, its black mask and orange beak at
// the front, its gold wing on its side, and its long tail
// down behind it.

make birdrow(r: number) -> text {
    if r == 0 { give "......KK................" }
    if r == 1 { give ".....KRrK..............." }
    if r == 2 { give "....KRrRK..............." }
    if r == 3 { give "....KRRRK...KKKK........" }
    if r == 4 { give "...KRRRKKKKRRRRRK......." }
    if r == 5 { give "..KRRRRRRRRRRRKKKK......" }
    if r == 6 { give "..KRRRRRRRRRRKWKKOOOO..." }
    if r == 7 { give "..KRRRRRRRRRRRKKKOOOOOO." }
    if r == 8 { give "..KRRRRRRRRRRRK.KOOO..." }
    if r == 9 { give "..KRRRRRRRRRRRKK........" }
    if r == 10 { give ".KRRRRRRRRRRRRrRK......." }
    if r == 11 { give ".KRRKKKKKRRRRRrrK......." }
    if r == 12 { give ".KRKGGGGGKRRRrrK........" }
    if r == 13 { give ".KRKGGGGGGKRRrrK........" }
    if r == 14 { give "..KKGGGGGGKKRrK........." }
    if r == 15 { give "...KGGGGGK.KRK.........." }
    if r == 16 { give "...KKKKKK..KRRK........." }
    if r == 17 { give "..KRRK....KRRRK........." }
    if r == 18 { give ".KRRRK....KRRK.........." }
    if r == 19 { give ".KRRK......KK..........." }
    if r == 20 { give "KRRRK..................." }
    if r == 21 { give "KRRK...................." }
    if r == 22 { give ".KK....................." }
    give "........................"
}

// Draws the cardinal at a pixel corner, each of its
// pixels laid 'sc' pixels square (one at the sizes the
// face stands at today — the button's measure, below).
make pixbird(desk: bytes, x: number, y: number, sc: number) {
    let r = 0
    while r < 24 {
        let row = birdrow(r)
        let c = 0
        while c < 24 {
            let ch = textbyte(row, c)
            if ch != 46 {
                if ch == 75 { pixinkrgb(desk, glasslead()) }
                if ch == 82 { pixinkrgb(desk, glassred()) }
                if ch == 114 { pixinkrgb(desk, glassbright()) }
                if ch == 71 { pixinkrgb(desk, glassgold()) }
                if ch == 79 { pixinkrgb(desk, glassbeak()) }
                if ch == 87 { pixinkrgb(desk, 16777215) }
                pixfill(desk, x + c * sc, y + r * sc, sc, sc)
            }
            c = c + 1
        }
        r = r + 1
    }
}

// Draws the round start button on the bar, at its left:
// a lead-rimmed disc of deep glass with a sheen standing
// in its upper part, and the cardinal on it. The button's
// measure is the bar's own: its center stands one letter
// cell in from the screen's left and at the bar's middle,
// and its radius is a cell less two pixels, so the disc
// stands within the bar's two rows with its rim showing.
// The pointer's pressing reads this same measure in the
// main body (the start button's reckoning there).
make pixstartbutton(desk: bytes) {
    let cs = pget(desk, 320)
    let cx = cs
    let cy = pixbartop(desk) + cs
    let r = cs - 2
    pixinkrgb(desk, glassshadow())
    pixdisc(desk, cx + 2, cy + 3, r)
    pixinkrgb(desk, glasslead())
    pixdisc(desk, cx, cy, r)
    pixinkrgb(desk, glassbase())
    pixdisc(desk, cx, cy, r - 2)
    pixinkrgb(desk, glasssheen())
    pixdisc(desk, cx, cy - r / 2, r / 2)
    pixbird(desk, cx - 12, cy - 12, 1)
}

// Draws the bar itself (Stone 33): it stands at the
// screen's foot, two letter rows tall, in the bar's blue
// with a glass sheen across its upper part — a pale band,
// a middle band, and the calm blue-green tint where the
// sheen meets the blue — and the round start button at
// its left. The bar's lower row keeps the bar's own blue
// whole, so the name and the clock the main body draws
// there stand on the color they have always stood on.
make pixbar(desk: bytes) {
    let cs = pget(desk, 320)
    let w = pget(desk, 8)
    let top = pixbartop(desk)
    pixink(desk, 1)
    pixfill(desk, 0, top, w, cs * 2)
    pixinkrgb(desk, glasssheen())
    pixfill(desk, 0, top, w, cs / 2)
    pixinkrgb(desk, glassmid())
    pixfill(desk, 0, top + cs / 2, w, cs / 2)
    pixinkrgb(desk, glasstint())
    pixfill(desk, 0, top + cs, w, cs / 4)
    pixstartbutton(desk)
}

// Lays the bar's own ground again under the window
// chips (Stone 39): the chips stand on the bar's upper
// row from the second cell to the screen's right edge,
// and on its lower row in the middle ground between
// the bar's name and the clock's ground — and when a
// window opens or closes the chips are laid again, the
// ground they stood on must first stand as the bar
// itself stands, or a closed window's chip would leave
// its plate behind. The bands laid here are pixbar's
// own — the sheen and its middle band above, the tint
// strip and the bar's blue below — over exactly the
// chips' two spans, and nothing else on the bar is
// touched: the start button stands left of the second
// cell, the name left of the tenth, and the clock's
// ground right of the lower span's end (the grid's
// fortieth cell from its right at the wide size, its
// tenth at the narrow — the very ground drawclock
// fills at every tick, which no chip may stand on).
make pixchipground(desk: bytes) {
    let cs = pget(desk, 320)
    let w = pget(desk, 8)
    let top = pixbartop(desk)
    pixinkrgb(desk, glasssheen())
    pixfill(desk, 2 * cs, top, w - 2 * cs, cs / 2)
    pixinkrgb(desk, glassmid())
    pixfill(desk, 2 * cs, top + cs / 2, w - 2 * cs, cs / 2)
    let cols = pget(desk, 28)
    let endcol = cols - 10
    if cols >= 48 {
        endcol = cols - 40
    }
    pixinkrgb(desk, glasstint())
    pixfill(desk, 10 * cs, top + cs, (endcol - 10) * cs, cs / 4)
    pixink(desk, 1)
    pixfill(desk, 10 * cs, top + cs + cs / 4, (endcol - 10) * cs, cs - cs / 4)
}

// Draws one letter at a pixel corner with the pen's color:
// its shape read from the letter block the desk names, its
// eight rows laid at 'sc' times size — twice at the words'
// usual size, three times at large print (Stone 28: the
// scale is a reckoning in this one drawing path, not a
// second font; the feather cells' showing passes 2 always,
// for its cells are carried 1:1 as they always have been).
// Letters outside the font's set (the codes 32 to 126)
// draw as a space.
make pixglyph(desk: bytes, x: number, y: number, code: number, sc: number) {
    floor(desk, x, y, code, sc) {
        mov r13, [r10 + 24]
        mov rax, [r10 + 16]
        sub rax, 32
        cmp rax, 94
        jbe pg_g
        xor eax, eax
    pg_g:
        shl rax, 3
        mov ecx, dword ptr [rbx + 36]
        add rcx, rax
        mov r9, rcx
        mov rax, [r10]
        shl rax, 2
        mov r11, rax
        mov rax, [r10 + 8]
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        add rax, r11
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov r10, rax
        mov r8d, dword ptr [rbx + 56]
        mov r11d, dword ptr [rbx + 4]
        xor esi, esi
    pg_row:
        cmp esi, 8
        jae pg_done
        mov eax, esi
        imul eax, r13d
        imul eax, r11d
        lea rdi, [r10 + rax]
        movzx eax, byte ptr [r9 + rsi]
        xor r14, r14
    pg_rep:
        cmp r14, r13
        jae pg_rowdone
        mov edx, eax
        shl edx, 24
        mov rcx, rdi
        mov r15d, 8
    pg_col:
        shl edx, 1
        jnc pg_skip
        mov dword ptr [rcx], r8d
        mov dword ptr [rcx + 4], r8d
        cmp r13, 3
        jne pg_skip
        mov dword ptr [rcx + 8], r8d
    pg_skip:
        lea rcx, [rcx + r13 * 4]
    pg_next:
        dec r15d
        jnz pg_col
        add rdi, r11
        inc r14
        jmp pg_rep
    pg_rowdone:
        inc esi
        jmp pg_row
    pg_done:
    }
}

// Draws a piece of text at a letter cell (its row and
// column on the face's grid): each letter's cell is first
// filled with the paper, then its shape drawn with the
// pen. Only the span the desk names (see pixspan) is
// drawn, and letters past the grid's edge are let go.
make pixtext(desk: bytes, row: number, col: number, text: text) {
    let cols = pget(desk, 28)
    let cellpx = pget(desk, 320)
    let from = pget(desk, 160)
    let count = pget(desk, 164)
    let n = length(text)
    let i = 0
    while i < count {
        let at = from + i
        if at < n {
            let c = col + i
            if c < cols {
                pset(desk, 56, pget(desk, 60))
                pixfill(desk, c * cellpx, row * cellpx, cellpx, cellpx)
                let code = textbyte(text, at)
                if code != 32 {
                    pixink(desk, pget(desk, 168))
                    pixglyph(desk, c * cellpx, row * cellpx, code, cellpx / 8)
                }
            }
        }
        i = i + 1
    }
}

// Names the span of a text the next pixtext draws: where
// it begins and how many letters. (A text cannot be cut on
// bare metal, so a span is how a long line is wrapped: the
// same text, drawn in pieces.) The pen's palette number is
// kept with the span, at 168, for pixtext's letters.
make pixspan(desk: bytes, from: number, count: number, fgidx: number) {
    pset(desk, 160, from)
    pset(desk, 164, count)
    pset(desk, 168, fgidx)
}

// Draws a whole text at a cell, in one span. The place is
// named by 'cell' — the row times 256 plus the column —
// and the colors by 'attr', the text face's own attribute
// reckoning: the ink's palette place plus sixteen times
// the paper's. (A call can carry only six words, and the
// desk and the text take four of them.)
make pixline(desk: bytes, cell: number, text: text, attr: number) {
    let row = cell / 256
    let col = cell - row * 256
    let fg = attr - (attr / 16) * 16
    let bg = (attr / 16) - (attr / 128) * 8
    pixpaper(desk, bg)
    pixspan(desk, 0, length(text), fg)
    pixtext(desk, row, col, text)
}

// Scrolls the answers region up one letter row: the rows
// move, and the last row is wiped to black.
make pixscroll(desk: bytes) {
    floor(desk) {
        mov eax, dword ptr [rbx + 128]
        imul eax, dword ptr [rbx + 320]
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov rdi, rax
        mov eax, dword ptr [rbx + 4]
        imul eax, dword ptr [rbx + 320]
        lea rsi, [rdi + rax]
        mov eax, dword ptr [rbx + 132]
        sub eax, dword ptr [rbx + 128]
        imul eax, dword ptr [rbx + 320]
        mov r8d, eax
        mov eax, dword ptr [rbx + 8]
        shl eax, 2
        mov r9d, eax
    ps_row:
        test r8d, r8d
        jz ps_wipe
        mov rcx, r9
        rep movsb
        mov eax, dword ptr [rbx + 4]
        sub eax, r9d
        add rsi, rax
        add rdi, rax
        dec r8d
        jmp ps_row
    ps_wipe:
        mov eax, dword ptr [rbx + 4]
        mov ecx, dword ptr [rbx + 320]
        mul rcx
        mov rcx, rax
        xor eax, eax
    ps_b:
        test rcx, rcx
        jz ps_done
        mov dword ptr [rdi], eax
        add rdi, 4
        sub rcx, 4
        jmp ps_b
    ps_done:
    }
}

// Prints one answer line in the answers region, wrapped at
// the region's width onto as many rows as it needs, in the
// answers' colors (light gray on black); gives back the
// next free row. A word longer than the whole width is
// simply cut at the width — no word the system speaks is.
// ---- the terminal window's keeping (Stone 38) ----
//
// The desktop's typing line and its answers live in a
// window of their own now — the terminal, the tenth
// window — and the answers are kept in a block of
// cells (a letter byte and a color byte to a cell,
// the feather canvases' own format), so the window's
// painter can lay them again after any repaint:
// eleven rows of forty-eight letters, the window's
// inner measure. The block's address stands in the
// desk at 416, the way the paint cells' address
// stands at 288, and the floors below reach it
// through the desk. The window's place stands in the
// desk at 408 and 412, its open standing at 404; its
// measures are reckoned here and in cardnull.nifla's
// tewide and tehigh, from the same rule, so painter
// and pointer agree. The answers' first row and last
// row stand in the desk at 128 and 132, as they
// always have — layplaces lays them inside the
// window now, and the typing line's row at 136 with
// them.

make termwide(desk: bytes) -> number {
    if pget(desk, 28) >= 56 {
        give 54
    }
    give pget(desk, 28) - 2
}

make termhigh(desk: bytes) -> number {
    give 14
}

make termcellget(desk: bytes, off: number) -> number {
    give floor(desk, off) {
        mov rax, [r10]
        mov rcx, qword ptr [rbx + 416]
        movzx eax, byte ptr [rcx + rax]
    }
}

make termcellput(desk: bytes, off: number, val: number) {
    floor(desk, off, val) {
        mov rax, [r10]
        mov rcx, qword ptr [rbx + 416]
        mov rdx, [r10 + 8]
        mov byte ptr [rcx + rax], dl
    }
}

// Lays one kept row of the answers in the terminal
// window: the row's letters in the answers' own
// colors (light gray on black), at the window's inner
// left edge, two cells in from its frame. The row is
// laid in two passes — every cell's ground first, then
// every letter — because the woven pass (ground, letter,
// ground, letter, ...) loses the heads of the row's
// first letters at the large size on the bench: the
// kept block holds the whole line and the separated
// passes lay it whole, while the woven pass, with the
// same calls in the same order per cell, does not.
make drawtermrow(desk: bytes, row: number) {
    let cs = pget(desk, 320)
    let tl = pget(desk, 408)
    let brow = row - pget(desk, 128)
    pixpaper(desk, 0)
    pset(desk, 56, pget(desk, 60))
    let c = 0
    while c < 48 {
        pixfill(desk, (tl + 2 + c) * cs, row * cs, cs, cs)
        c = c + 1
    }
    pset(desk, 56, pget(desk, 64 + 7 * 4))
    c = 0
    while c < 48 {
        let code = termcellget(desk, (brow * 48 + c) * 2)
        if code != 32 {
            pixglyph(desk, (tl + 2 + c) * cs, row * cs, code, cs / 8)
        }
        c = c + 1
    }
}

// Lays every kept row of the answers in the window —
// the terminal window's painter's body.
make drawtermbody(desk: bytes) {
    let r = pget(desk, 128)
    while r <= pget(desk, 132) {
        drawtermrow(desk, r)
        r = r + 1
    }
}

// The answers scroll (Stone 38): the kept rows shift
// up one line in their block, and the last row is
// cleared to resting cells; the window's painter
// lays the shifted body at the next repaint. The framebuffer
// scroll this replaces (pixscroll) moved the old
// answers strip on the desktop's ground; the answers
// live in their window's keeping now, and the block
// is what scrolls.
make termshift(desk: bytes) {
    let r = 0
    while r < 10 {
        let c = 0
        while c < 96 {
            termcellput(desk, (r * 48) * 2 + c, termcellget(desk, ((r + 1) * 48) * 2 + c))
            c = c + 1
        }
        r = r + 1
    }
    let c2 = 0
    while c2 < 48 {
        termcellput(desk, (10 * 48 + c2) * 2, 32)
        termcellput(desk, (10 * 48 + c2) * 2 + 1, 7)
        c2 = c2 + 1
    }
}

make pixprintline(desk: bytes, row: number, text: text) -> number {
    let usable = termwide(desk) - 6
    let bot = pget(desk, 132)
    let n = length(text)
    let r = row
    let start = 0
    let going = 1
    if n == 0 {
        going = 0
    }
    while going == 1 {
        let end = start + usable
        if end >= n {
            end = n
        } else {
            let j = end
            let hunting = 1
            while hunting == 1 {
                if j <= start {
                    hunting = 0
                } else {
                    if textbyte(text, j) == 32 {
                        hunting = 0
                    } else {
                        j = j - 1
                    }
                }
            }
            if j > start {
                end = j
            }
        }
        if r > bot {
            termshift(desk)
            r = bot
        }
        // The line is laid in the terminal's keeping
        // (Stone 38) — the answers live in the window's
        // block now, not on the desktop's ground, and
        // they are drawn only by the window's painter,
        // in the standing order: the main loop repaints
        // the terminal's region when the answer stream
        // moves, so an answer never paints over a
        // window standing above the terminal.
        let brow = r - pget(desk, 128)
        let k = 0
        while k < end - start {
            termcellput(desk, (brow * 48 + k) * 2, textbyte(text, start + k))
            termcellput(desk, (brow * 48 + k) * 2 + 1, 7)
            k = k + 1
        }
        while k < 48 {
            termcellput(desk, (brow * 48 + k) * 2, 32)
            termcellput(desk, (brow * 48 + k) * 2 + 1, 7)
            k = k + 1
        }
        r = r + 1
        start = end
        if start < n {
            if textbyte(text, start) == 32 {
                start = start + 1
            }
        }
        if start >= n {
            going = 0
        }
    }
    give r
}

// Draws one kept note in the answers region at 'row'
// (Stone 15): the note stands in the block handed in, at
// 'off' — its length at that byte, its letters after —
// and is drawn letter by letter in the answers' colors
// (light gray on black), at the answers' own left edge.
// A note is kept as bytes, not as a text, so it is drawn
// from its bytes; the row reckoning is pixprintline's —
// the region scrolls when it is full — and the next free
// row is given back.
make pixnoteline(desk: bytes, block: bytes, row: number, off: number) -> number {
    let r = row
    let bot = pget(desk, 132)
    if r > bot {
        termshift(desk)
        r = bot
    }
    let n = cellbyte(block, off)
    // The note is laid in the terminal's keeping
    // (Stone 38), beside the answers it stands among,
    // and drawn only by the window's painter, as
    // pixprintline's lines are.
    let brow = r - pget(desk, 128)
    let i = 0
    while i < n {
        if i < 48 {
            termcellput(desk, (brow * 48 + i) * 2, cellbyte(block, off + 1 + i))
            termcellput(desk, (brow * 48 + i) * 2 + 1, 7)
        }
        i = i + 1
    }
    let k = n
    while k < 48 {
        termcellput(desk, (brow * 48 + k) * 2, 32)
        termcellput(desk, (brow * 48 + k) * 2 + 1, 7)
        k = k + 1
    }
    give r + 1
}

// ---- the feather's cells, read back for the drawing ----
//
// In the pixel face the feather paints a block of cells the
// host hands it (through the doorstep word placefeather
// lays — see featherdoor.nifla), and the host draws those
// cells as pixels after the visit. The feather cannot paint
// the text screen's own memory for this: on a machine
// showing a picture screen that memory is not a screen,
// and its cells cannot be read back from it — measured on
// the bench, it reads back as one repeated byte, the
// painting lost among the picture screen's own workings.

// One byte of the feather's cell block: the byte at 'off' —
// a cell's letter stands at its even byte, its color at
// the odd one after it.
make cellbyte(block: bytes, off: number) -> number {
    give floor(block, off) {
        mov rax, [r10]
        movzx eax, byte ptr [rbx + rax]
    }
}

// ---- the pointer's arrow (Stone 13) ----
//
// The arrow stands in a patch of the screen whose corner
// the main body keeps: before the arrow is drawn there,
// the patch's own pixels are kept in the save block the
// desk names at 48, and when the arrow moves on they are
// laid back, so the desktop under it is never harmed. The
// patch is sixteen pixels wide and seventeen tall — one
// row taller than the square it was first kept as —
// because the arrow's whole footprint is that tall: the
// shape's fourteen rows stand at y + 2 to y + 15, and its
// white edge is laid one pixel around the shape (see
// pixarrow's passes), so the edge's bottom pass paints
// the shape's last row again at y + 16, one row BELOW a
// sixteen-tall save. That row was drawn but never saved
// or laid back, so every place the arrow had stood kept
// the last row's five white edge pixels — the dotted
// trail across the desktop (witnessed by Tyler in UTM,
// November 15, 2026, and reproduced on the bench: after a
// move, the sixteen kept rows stood whole and exactly
// those five pixels at y + 16 stayed white on the black
// ground). The save and the laying back below now cover
// all seventeen rows, and the main body keeps the
// arrow's corner one row further from the screen's
// bottom edge, so the whole patch always stands on the
// screen. The arrow's own shape — fourteen
// rows, eleven letters wide, its point at the square's
// (2, 2) — stands as fourteen numbers in the block the
// desk names at 44, each number one row, its high bit the
// row's leftmost pixel:
//
//   #..........
//   ##.........
//   ###........
//   ####.......
//   #####......
//   ######.....
//   #######....
//   ########...
//   #########..
//   ##########.
//   #######....
//   #####......
//   ####.##....
//   ###...##...

// Lays the arrow's fourteen rows into the block handed
// in, by the desk's own writing (pset writes any block).
make arrowload(block: bytes) {
    pset(block, 0, 1024)
    pset(block, 4, 1536)
    pset(block, 8, 1792)
    pset(block, 12, 1920)
    pset(block, 16, 1984)
    pset(block, 20, 2016)
    pset(block, 24, 2032)
    pset(block, 28, 2040)
    pset(block, 32, 2044)
    pset(block, 36, 2046)
    pset(block, 40, 2032)
    pset(block, 44, 1984)
    pset(block, 48, 1968)
    pset(block, 52, 1816)
}

// Keeps the arrow's whole patch at (x, y) in the save
// block, before the arrow is drawn over it: sixteen
// pixels wide and seventeen tall, the footprint's full
// measure (see the pointer's heading above).
make pixsave(desk: bytes, x: number, y: number) {
    floor(desk, x, y) {
        mov rax, [r10 + 8]
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        mov rcx, [r10]
        shl rcx, 2
        add rax, rcx
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov rsi, rax
        mov edi, dword ptr [rbx + 48]
        mov r8, 17
    psv_row:
        mov rcx, 16
    psv_px:
        mov eax, dword ptr [rsi]
        mov dword ptr [rdi], eax
        add rsi, 4
        add rdi, 4
        dec rcx
        jnz psv_px
        mov eax, dword ptr [rbx + 4]
        sub rax, 64
        add rsi, rax
        dec r8
        jnz psv_row
    }
}

// Lays the kept patch back at (x, y) — all seventeen
// rows of it, the bottom edge's row among them: the
// arrow is gone from there, and the desktop stands as
// it was.
make pixrestore(desk: bytes, x: number, y: number) {
    floor(desk, x, y) {
        mov rax, [r10 + 8]
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        mov rcx, [r10]
        shl rcx, 2
        add rax, rcx
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov rdi, rax
        mov esi, dword ptr [rbx + 48]
        mov r8, 17
    prs_row:
        mov rcx, 16
    prs_px:
        mov eax, dword ptr [rsi]
        mov dword ptr [rdi], eax
        add rsi, 4
        add rdi, 4
        dec rcx
        jnz prs_px
        mov eax, dword ptr [rbx + 4]
        sub rax, 64
        add rdi, rax
        dec r8
        jnz prs_row
    }
}

// Draws the arrow in the square at (x, y): first its
// white edge — the shape laid at the four places around
// its home — then the shape itself in black at (2, 2)
// within the square, so its point stands at (x + 2,
// y + 2) and it reads on any ground the desktop shows.
// The edge's four places reach one pixel past the shape
// on every side: across, x + 1 to x + 12, and down, y + 1
// to y + 16 — the bottom reach is the row the seventeen-
// tall save above exists for.
make pixarrow(desk: bytes, x: number, y: number) {
    floor(desk, x, y) {
        mov r14d, dword ptr [rbx + 44]
        xor r13, r13
    par_pass:
        cmp r13, 5
        jae par_done
        mov rax, offset par_dx
        movzx ecx, byte ptr [rax + r13]
        mov r15, rcx
        mov rax, offset par_dy
        movzx ecx, byte ptr [rax + r13]
        mov rax, [r10 + 8]
        add rax, rcx
        mov ecx, dword ptr [rbx + 4]
        mul rcx
        mov rcx, [r10]
        add rcx, r15
        shl rcx, 2
        add rax, rcx
        mov ecx, dword ptr [rbx]
        add rax, rcx
        mov rdi, rax
        cmp r13, 4
        je par_black
        mov r8d, dword ptr [rbx + 124]
        jmp par_color
    par_black:
        mov r8d, dword ptr [rbx + 64]
    par_color:
        xor r11, r11
    par_row:
        cmp r11, 14
        jae par_next
        mov eax, dword ptr [r14 + r11 * 4]
        mov rsi, rdi
        mov ecx, 1024
    par_col:
        test ecx, ecx
        jz par_rowdone
        test eax, ecx
        jz par_skip
        mov dword ptr [rsi], r8d
    par_skip:
        add rsi, 4
        shr ecx, 1
        jmp par_col
    par_rowdone:
        mov eax, dword ptr [rbx + 4]
        add rdi, rax
        inc r11
        jmp par_row
    par_next:
        inc r13
        jmp par_pass
    par_done:
        jmp par_end
    par_dx:
        .byte 1, 3, 2, 2, 2
    par_dy:
        .byte 2, 2, 1, 3, 2
    par_end:
    }
}
