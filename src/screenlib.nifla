// Cardnull OS 2's screen library — laid with Stone 3.
//
// The system uses it by naming it as a prelude when it is
// built (build.sh does this on its own):
//
//   niflac --bare cardnull.nifla --prelude screenlib.nifla
//
// A prelude may only make functions; these become part of the
// program, as if they stood at its top. The library's work is
// done in floor blocks, because the screen is the processor's
// own memory (0xB8000) and writing there is floor work. The
// library keeps no state of its own: every tool takes the
// place, the words, and the color it is handed, each time.
//
// The colors are the text screen's own: one number holds the
// letter's color in its low four bits and the background in
// the next three — 7 is light gray on black, 31 is white on
// blue, 112 is black on light gray, 47 is white on green.
//
// Rows are 0 to 24, columns 0 to 79.

// Clears the whole screen to the plain color.
make clearscreen() {
    floor() {
        mov rdi, 0xB8000
        mov rcx, 2000
        mov ax, 0x0720
        rep stosw
    }
}

// Writes text at a chosen row and column, in a chosen color.
// The text stops at the row's end — it does not wrap.
make writeat(row, col, text, color) {
    floor(text, row, col, color) {
        mov rax, [r10]
        inc rax
        imul rax, 160
        add rax, 0xB8000
        mov r8, rax
        mov rax, [r10]
        imul rax, 80
        add rax, [r10 + 8]
        shl rax, 1
        add rax, 0xB8000
        mov rdi, rax
        mov dl, byte ptr [r10 + 16]
        xor ecx, ecx
    wa_loop:
        cmp rcx, r12
        jae wa_done
        cmp rdi, r8
        jae wa_done
        mov al, byte ptr [rbx + rcx]
        mov ah, dl
        mov word ptr [rdi], ax
        add rdi, 2
        inc rcx
        jmp wa_loop
    wa_done:
    }
}

// Paints one whole row in a color (spaces, end to end) — how
// the top bar gets its background.
make paintrow(row, color) {
    floor(row, color) {
        mov rax, [r10]
        imul rax, 160
        add rax, 0xB8000
        mov rdi, rax
        mov rcx, 80
        mov dl, byte ptr [r10 + 8]
        mov ah, dl
        mov al, 32
        rep stosw
    }
}

// Paints a rectangle of spaces in a color: 'height' rows
// starting at 'top', 'width' columns starting at 'left' —
// how the welcome panel gets its background.
make paintrect(top, left, width, height, color) {
    floor(top, left, width, height, color) {
        mov r8, [r10]
        mov r9, [r10 + 8]
        mov r11, [r10 + 16]
        mov rcx, [r10 + 24]
        mov dl, byte ptr [r10 + 32]
    pr_row:
        test rcx, rcx
        jz pr_done
        mov rax, r8
        imul rax, 160
        mov rdi, r9
        shl rdi, 1
        add rdi, rax
        add rdi, 0xB8000
        mov rsi, r11
        mov ah, dl
        mov al, 32
    pr_cell:
        test rsi, rsi
        jz pr_next
        mov word ptr [rdi], ax
        add rdi, 2
        dec rsi
        jmp pr_cell
    pr_next:
        inc r8
        dec rcx
        jmp pr_row
    pr_done:
    }
}

// Moves the answer region (rows 13 to 22) up one line and
// blanks its last row, so a new answer can be written there.
// The region's bounds are the desktop's own arrangement,
// shared with the system's printline.
make scrollanswers() {
    floor() {
        mov rsi, 0xB8000
        add rsi, 2240
        mov rdi, 0xB8000
        add rdi, 2080
        mov rcx, 720
        rep movsw
        mov rcx, 80
        mov ax, 0x0720
        rep stosw
    }
}
