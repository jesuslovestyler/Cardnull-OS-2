// The welcome feather — Cardnull OS 2's first feather
// (Stone 5). This program is never booted: it is built with
// `niflac --bare --guest` into a flat image, laid on a disk,
// and loaded, checked, and called by the system through the
// feather door. It is linked for the doorstep at 2 MiB; the
// host copies its image there only after the image's bytes
// have matched the card that describes them.
//
// A feather does not own the machine: the timer, the keyboard,
// the memory map, and the disk stay with the host, and asking
// for them here is refused before the program is even built.
// What a feather is handed is a desk: the screen to draw on,
// one number in, and the way back — when this program ends
// it does not stop the machine, it returns to the host,
// leaving a parting number with guestgive().
//
// The drawing below is this feather's own: two small tools
// that are handed the feather's words as text, the way any
// program would hand them. It was not always so: as first
// built (Stone 5) the feather painted its letters one by one
// as immediate values in a floor block handed nothing,
// because the founding morning's bench notes recorded that
// a feather's floor blocks handed text or bytes were given a
// desk whose length read as zero. At Stone 10 that record
// was measured again, shape by shape — a floor handed a
// text literal, a block of bytes, a function's own handed
// words, joined and returned text, text with numbers — and
// it did not hold: in every shape the desk arrived whole,
// pointer, length, and letters, and the assembly the
// compiler writes for the handing is the same for a feather
// as for a host. The record is corrected in the README,
// and the feather is written plainly now, as it should have
// been.
//
// Which screen the feather paints stands in a word at the
// top of the feather's own doorstep (address 0x27FFF8), laid
// there by the host before the call (Stone 9): on a machine
// showing the text screen it is that screen's own address,
// 0xB8000, and the feather paints the screen itself; on a
// machine showing the face of light it is a block of the
// host's own memory holding a text screen's worth of
// letter-and-color cells, which the host then shows as
// light. A missing word (an older host) means the text
// screen, as before. The panel stands at rows 15-19,
// columns 14-65; the lines begin at column 16 of rows 16,
// 17, and 18, in this feather's color — 0x2F, white on green.

// The screen this feather is to paint: the doorstep word,
// or the text screen's address when no word was laid.
make paintbase() -> number {
    give floor() {
        mov rax, qword ptr [0x27FFF8]
        test rax, rax
        jnz pb_done
        mov rax, 0xB8000
    pb_done:
    }
}

// Paints a filled rectangle of spaces in one color — the
// panel's ground.
make paintrect(base: number, row: number, col: number, wide: number, high: number, color: number) {
    floor(base, row, col, wide, high, color) {
        mov rax, [r10]
        mov rcx, [r10 + 8]
        imul rcx, 160
        add rax, rcx
        mov rcx, [r10 + 16]
        shl rcx, 1
        add rax, rcx
        mov rdi, rax
        mov r8, [r10 + 32]
        mov rdx, [r10 + 40]
        shl rdx, 8
        or rdx, 32
        mov eax, edx
    pr_row:
        mov rcx, [r10 + 24]
        rep stosw
        mov rcx, [r10 + 24]
        shl rcx, 1
        mov rdx, 160
        sub rdx, rcx
        add rdi, rdx
        dec r8
        jnz pr_row
    }
}

// Writes one line of text at (row, col) in one color, from
// the words it is handed.
make paintline(base: number, row: number, col: number, color: number, text: text) {
    floor(text, base, row, col, color) {
        mov rax, [r10]
        mov rcx, [r10 + 8]
        imul rcx, 160
        add rax, rcx
        mov rcx, [r10 + 16]
        shl rcx, 1
        add rax, rcx
        mov rdi, rax
        mov rdx, [r10 + 24]
        shl rdx, 8
        mov rcx, 0
    pl_loop:
        cmp rcx, r12
        jae pl_done
        movzx eax, byte ptr [rbx + rcx]
        or rax, rdx
        mov word ptr [rdi + rcx * 2], ax
        inc rcx
        jmp pl_loop
    pl_done:
    }
}

let gift = guestvalue()
let base = paintbase()
paintrect(base, 15, 14, 52, 5, 47)
paintline(base, 16, 16, 47, "A feather is visiting")
paintline(base, 17, 16, 47, "Hello. I am a small program, here as a feather.")
paintline(base, 18, 16, 47, "I was checked first, and I am whole.")
guestgive(gift + gift)
