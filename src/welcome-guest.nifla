    stosw
    mov ax, 0x2F6E
    stosw
    mov ax, 0x2F67
    stosw
    add rdi, 122
    // "Hello. I am a small program, here as a guest."
    mov ax, 0x2F48
    stosw
    mov ax, 0x2F65
    stosw
    mov ax, 0x2F6C
    stosw
    mov ax, 0x2F6C
    stosw
    mov ax, 0x2F6F
    stosw
    mov ax, 0x2F2E
    stosw
    mov ax, 0x2F20
    stosw
    mov ax, 0x2F49
    stosw
    mov ax, 0x2F20
    stosw
    mov ax, 0x2F61
    stosw
    mov ax, 0x2F6D
    stosw
    mov ax, 0x2F20
