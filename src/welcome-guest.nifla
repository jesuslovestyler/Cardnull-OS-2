    stosw
    add rdi, 70
    // "I was checked first, and I am whole."
    mov ax, 0x2F49
    stosw
    mov ax, 0x2F20
    stosw
    mov ax, 0x2F77
    stosw
    mov ax, 0x2F61
    stosw
    mov ax, 0x2F73
    stosw
    mov ax, 0x2F20
    stosw
