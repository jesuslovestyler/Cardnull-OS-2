// The welcome guest — Cardnull OS 2's first guest
// (Stone 5). This program is never booted: it is built with
// `niflac --bare --guest` into a flat image, laid on a disk,
// and loaded, checked, and called by the system through the
// guest door. It is linked for the doorstep at 2 MiB; the
// host copies its image there only after the image's bytes
// have matched the card that describes them.
//
// A guest does not own the machine: the timer, the keyboard,
// the memory map, and the disk stay with the host, and asking
// for them here is refused before the program is even built.
// What a guest is handed is a desk: the screen to draw on,
// one number in, and the way back — when this program ends
// it does not stop the machine, it returns to the host,
// leaving a parting number with guestgive().
//
// The drawing below is this guest's own, in one floor block
// that is handed nothing. It would have been natural to
// share the system's screen library, or to hand this block
// the guest's lines as text — but as the language stands,
// neither works inside a guest: the library's tools hand
// their arguments onward to their floor blocks, which a
// guest build refuses; and a floor block in a guest that IS
// handed a piece of text or a block of bytes is given a
// desk whose length reads as zero, so nothing can be copied
// from it (measured on the bench both ways; the system's
// own floor blocks, handed the same things, work). So the
// guest writes its letters one by one, each value below
// being a letter wearing this guest's color — 0x2F, white
// on green, in the high byte, the letter's own code in the
// low — with each line quoted above the run that writes it.
// The panel stands at rows 15-19, columns 14-65 (it begins
// at screen address 0xB897C); the lines begin at column 16
// of rows 16, 17, and 18.

let gift = guestvalue()

floor() {
    mov rdi, 0xB897C
    mov r8, 5
wg_rows:
    mov rcx, 52
    mov ax, 0x2F20
    rep stosw
    add rdi, 56
    dec r8
    jnz wg_rows
    mov rdi, 0xB8A20
    // "A guest is visiting"
    mov ax, 0x2F41
    stosw
    mov ax, 0x2F20
    stosw
    mov ax, 0x2F67
    stosw
    mov ax, 0x2F75
    stosw
    mov ax, 0x2F65
