    mov ax, 0x2F6D
    stosw
    mov ax, 0x2F20
    stosw
    mov ax, 0x2F77
    stosw
    mov ax, 0x2F68
    stosw
    mov ax, 0x2F6F
    stosw
    mov ax, 0x2F6C
    stosw
    mov ax, 0x2F65
    stosw
    mov ax, 0x2F2E
    stosw
}
guestgive(gift + gift)
