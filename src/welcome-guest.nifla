    stosw
    mov ax, 0x2F2C
    stosw
    mov ax, 0x2F20
    stosw
    mov ax, 0x2F68
    stosw
    mov ax, 0x2F65
    stosw
    mov ax, 0x2F72
    stosw
    mov ax, 0x2F65
    stosw
    mov ax, 0x2F20
    stosw
    mov ax, 0x2F61
    stosw
    mov ax, 0x2F73
    stosw
    mov ax, 0x2F20
